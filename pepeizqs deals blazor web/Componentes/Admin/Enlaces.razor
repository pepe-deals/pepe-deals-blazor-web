@code {

    #nullable disable

    private string dealsGoogleSearch = string.Empty;
    private string dealsVisitas = string.Empty;
    private string dealsBing = string.Empty;
    private string dealsSteam = string.Empty;

    private string appsGoogleSearch = string.Empty;
    private string appsVisitas = string.Empty;
    private string appsBing = string.Empty;

    private string extensionChrome = string.Empty;
    private string extensionEdge = string.Empty;
    private string extensionFirefox = string.Empty;

    protected override void OnInitialized()
    {
        dealsGoogleSearch = Configuracion.GetValue<string>("WebmasterDeals:GoogleSearch");
        dealsVisitas = Configuracion.GetValue<string>("WebmasterDeals:Visitas");
        dealsBing = Configuracion.GetValue<string>("WebmasterDeals:Bing");
        dealsSteam = Configuracion.GetValue<string>("WebmasterDeals:SteamNews");

        appsGoogleSearch = Configuracion.GetValue<string>("WebmasterApps:GoogleSearch");
        appsVisitas = Configuracion.GetValue<string>("WebmasterApps:Visitas");
        appsBing = Configuracion.GetValue<string>("WebmasterApps:Bing");

        extensionChrome = Configuracion.GetValue<string>("ExtensionDeals:Chrome");
        extensionEdge = Configuracion.GetValue<string>("ExtensionDeals:Edge");
        extensionFirefox = Configuracion.GetValue<string>("ExtensionDeals:Firefox");
    }
}
