@if (abrirEnlace == true)
{
    <div class="opciones-panel">
        <div style="width: 900px; background-color: var(--fondoOscuro); border: 1px solid var(--fondoBotonPequeño); padding: 40px; overflow-y: scroll; display: flex; flex-direction: column; gap: 20px;">
            <div style="display: flex; align-items: start; gap: 40px;">
                <button @onclick="@(e => EnlaceCerrar(e))" class="boton-pequeño" style="padding: 10px 15px; width: fit-content;">
                    <div style="max-width: 24px; max-height: 24px;">
                        <svg class="svg-icono" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                            <path d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.2 288 416 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-306.7 0L214.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z" />
                        </svg>
                    </div>
                </button>

                <div style="width: 100%;">
                    <label style="margin: 10px;">Juegos Buscador:</label>
                    <input type="text" @oninput="TextoCambiaBuscadorJuegoEnlace" class="entrada-texto" style="margin-bottom: 20px;" />

                    @if (juegosBuscadorEnlace != null)
                    {
                        @if (juegosBuscadorEnlace.Count > 0)
                        {
                            <div>
                                @foreach (var juego in juegosBuscadorEnlace)
                                {
                                    <div class="perfil-flexible-centrado perfil-espacio-top">
                                        <button @onclick="@(e => SeleccionarJuegoAñadirEnlace(e, juego.Id.ToString(), juego.Nombre))" class="boton-pequeño">
                                            <div class="perfil-flexible-centrado">
                                                <div style="width: 12%;">
                                                    <img src="@juego.Imagenes.Capsule_231x87" style="max-height:100%; max-width:100%;" />
                                                </div>

                                                <div style="width: 88%; padding-left: 15px; padding-right: 15px;">
                                                    @juego.Id - @juego.Nombre
                                                </div>
                                            </div>
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    }

                    <label style="margin: 10px;">Enlace:</label>

                    <input class="entrada-texto" @bind="contenidoEnlace">

                    <hr />

                    <button @onclick="@(e => EnlaceAñadir(e))" class="boton-pequeño" style="width: 120px; text-align: center; padding: 10px 20px;">
                        Añadir
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {

    #nullable disable

    [CascadingParameter] private Herramientas.ContextoUsuarioDatos datos { get; set; }

    private string dominio = null;

    private NoticiaTipo noticiaTipoSeleccionada = NoticiaTipo.Bundles;

    private BundleTipo bundleTipoSeleccionado = BundleTipo.Desconocido;
    private GratisTipo gratisSeleccionadoNoticias = GratisTipo.Desconocido;
    private SuscripcionTipo suscripcionSeleccionadaNoticias = SuscripcionTipo.Desconocido;

    private bool plantillaCargada = false;
    private Plantilla noticia = new Plantilla();

    private bool enviandoNoticia = false;
    private int idNoticiaEnviada = 0;

    private bool enviandoBluesky = false;
    private bool enviadoBluesky = false;
    private bool enviandoTelegram = false;
    private bool enviadoTelegram = false;
    private bool enviandoPush = false;
    private bool enviadoPush = false;
    private bool enviandoReddit = false;
    private bool enviadoReddit = false;

    protected override void OnInitialized()
    {
        dominio = datos.Dominio;
    }

    private async Task CambiarNoticiaTipo(ChangeEventArgs texto)
    {
        plantillaCargada = false;

        noticia = new Plantilla();
        noticia.Fecha = DateTime.Now;

        noticiaTipoSeleccionada = Enum.Parse<NoticiaTipo>(texto.Value.ToString());

        //-------------------------------------------------------

        if (noticiaTipoSeleccionada == NoticiaTipo.Gratis)
        {
            gratisSeleccionadoNoticias = GratisCargar.GenerarListado()[0].Tipo;
        }
        else if (noticiaTipoSeleccionada == NoticiaTipo.Suscripciones)
        {
            await CambiarSuscripcionNoticias(SuscripcionesCargar.GenerarListado()[0].Id);
        }
        else if (noticiaTipoSeleccionada == NoticiaTipo.Web)
        {
            noticia.Imagen = "https://" + dominio + "/logo/logoentrada2.webp";
            noticia.Fecha = DateTime.Now.AddDays(7);
        }
        else if (noticiaTipoSeleccionada == NoticiaTipo.Patreon)
        {
            noticia.Imagen = "https://" + dominio + "/logo/logoentradapatreon.webp";
            noticia.Fecha = DateTime.Now.AddDays(7);
        }
        else if (noticiaTipoSeleccionada == NoticiaTipo.Despedidas)
        {
            noticia.Imagen = "https://" + dominio + "/logo/logoentrada2.webp";
            noticia.Fecha = DateTime.Now;
        }
    }

    private async Task CambiarImagenNoticias()
    {
        if (noticiaTipoSeleccionada == NoticiaTipo.Web)
        {
            if (noticia.Imagen.Contains(dominio) == false)
            {
                List<string> imagenes = new List<string>();
                imagenes.Add(noticia.Imagen);

                var resultado = await Herramientas.Ficheros.Constructor.Imagen(imagenes, "https://" + dominio + "/logo/logo5.png", Herramientas.Ficheros.Constructor.ImagenModo.Web);

                if (resultado.Exito == true)
                {
                    noticia.Imagen = "https://" + dominio + resultado.DirectorioFichero;
                }
            }
        }
    }

    private void CambiarFechaNoticias(ChangeEventArgs texto)
    {
        noticia.Fecha = Convert.ToDateTime(texto.Value.ToString());
    }

    private async Task AñadirNoticia(MouseEventArgs e)
    {
        enviandoNoticia = true;

        global::Noticias.Noticia noticiaAñadir = new global::Noticias.Noticia();

        noticiaAñadir.TituloEn = noticia.TituloEn;
        noticiaAñadir.TituloEs = noticia.TituloEs;
        noticiaAñadir.Imagen = noticia.Imagen;
        noticiaAñadir.ContenidoEn = noticia.ContenidoEn;
        noticiaAñadir.ContenidoEs = noticia.ContenidoEs;
        noticiaAñadir.Juegos = noticia.Juegos;
        noticiaAñadir.FechaEmpieza = DateTime.Now;
        noticiaAñadir.FechaTermina = noticia.Fecha;
        noticiaAñadir.Enlace = noticia.Enlace;
        noticiaAñadir.NoticiaTipo = noticiaTipoSeleccionada;

        if (noticiaTipoSeleccionada == NoticiaTipo.Bundles)
        {
            noticiaAñadir.BundleTipo = BundlesCargar.DevolverBundle(bundleTipoSeleccionado).BundleTipo;
            noticiaAñadir.BundleId = int.Parse(noticia.BundleId);
        }
        else if (noticiaTipoSeleccionada == NoticiaTipo.Gratis)
        {
            noticiaAñadir.GratisTipo = GratisCargar.DevolverGratis(gratisSeleccionadoNoticias).Tipo;
            noticiaAñadir.GratisIds = noticia.GratisIds;

        }
        else if (noticiaTipoSeleccionada == NoticiaTipo.Suscripciones)
        {
            noticiaAñadir.SuscripcionTipo = SuscripcionesCargar.DevolverSuscripcion(suscripcionSeleccionadaNoticias).Id;
            noticiaAñadir.SuscripcionesIds = noticia.SuscripcionesIds;
        }

        int id = await BaseDatos.Noticias.Insertar.Ejecutar(noticiaAñadir);
        noticiaAñadir.Id = id;

        noticiaAñadir = await global::Noticias.Steam.GenerarNoticia(noticiaAñadir);
        await BaseDatos.Noticias.Actualizar.Steam(noticiaAñadir);

        idNoticiaEnviada = id;

        List<Usuario> usuariosNotificar = await BaseDatos.Usuarios.Buscar.UsuariosNotificacionesCorreo();

        if (usuariosNotificar?.Count > 0)
        {
            foreach (var usuario in usuariosNotificar)
            {
                try
                {
                    if (usuario.NotificationBundles == true && noticiaAñadir.NoticiaTipo == NoticiaTipo.Bundles)
                    {
                        await Herramientas.Correos.Noticias.Enviar(noticiaAñadir, usuario.Email, usuario.Language, dominio);
                    }

                    if (usuario.NotificationFree == true && noticiaAñadir.NoticiaTipo == NoticiaTipo.Gratis)
                    {
                        await Herramientas.Correos.Noticias.Enviar(noticiaAñadir, usuario.Email, usuario.Language, dominio);
                    }

                    if (usuario.NotificationSubscriptions == true && noticiaAñadir.NoticiaTipo == NoticiaTipo.Suscripciones)
                    {
                        await Herramientas.Correos.Noticias.Enviar(noticiaAñadir, usuario.Email, usuario.Language, dominio);
                    }

                    if (usuario.NotificationWeb == true && noticiaAñadir.NoticiaTipo == NoticiaTipo.Web)
                    {
                        await Herramientas.Correos.Noticias.Enviar(noticiaAñadir, usuario.Email, usuario.Language, dominio);
                    }

                    if (usuario.NotificationDelisted == true && noticiaAñadir.NoticiaTipo == NoticiaTipo.Despedidas)
                    {
                        await Herramientas.Correos.Noticias.Enviar(noticiaAñadir, usuario.Email, usuario.Language, dominio);
                    }

                    if (usuario.NotificationOthers == true &&
                        noticiaAñadir.NoticiaTipo != NoticiaTipo.Bundles && noticiaAñadir.NoticiaTipo != NoticiaTipo.Gratis &&
                        noticiaAñadir.NoticiaTipo != NoticiaTipo.Suscripciones && noticiaAñadir.NoticiaTipo != NoticiaTipo.Web &&
                        noticiaAñadir.NoticiaTipo != NoticiaTipo.Despedidas)
                    {
                        await Herramientas.Correos.Noticias.Enviar(noticiaAñadir, usuario.Email, usuario.Language, dominio);
                    }
                }
                catch (Exception ex)
                {
                    BaseDatos.Errores.Insertar.Mensaje("Enviar Correo Noticia", ex);
                }
            }
        }

        enviandoBluesky = true;

        try
        {
            enviadoBluesky = await Herramientas.RedesSociales.Bluesky.Postear(Configuracion, noticiaAñadir, dominio);
        }
        catch (Exception ex)
        {
            BaseDatos.Errores.Insertar.Mensaje("Enviar BlueSky Noticia", ex);
        }

        enviandoBluesky = false;

        await InvokeAsync(StateHasChanged);

        enviandoTelegram = true;

        try
        {
            enviadoTelegram = await Herramientas.RedesSociales.Telegram.Postear(Configuracion, noticiaAñadir, dominio);
        }
        catch (Exception ex)
        {
            BaseDatos.Errores.Insertar.Mensaje("Enviar Telegram Noticia", ex);
        }

        enviandoTelegram = false;

        await InvokeAsync(StateHasChanged);

        enviandoPush = true;

        try
        {
            enviadoPush = await Push.EnviarNoticia(noticiaAñadir, dominio);
        }
        catch (Exception ex)
        {
            BaseDatos.Errores.Insertar.Mensaje("Enviar Push Noticia", ex);
        }

        enviandoPush = false;

        await InvokeAsync(StateHasChanged);

        enviandoReddit = true;

        try
        {
            enviadoReddit = await Herramientas.RedesSociales.Reddit.Postear(Configuracion, noticiaAñadir, dominio);
        }
        catch (Exception ex)
        {
            BaseDatos.Errores.Insertar.Mensaje("Enviar Reddit Noticia", ex);
        }

        enviandoReddit = false;

        #region Limpieza

        noticia = new Plantilla();
        plantillaCargada = false;

        bundleTipoSeleccionado = BundleTipo.Desconocido;
        gratisSeleccionadoNoticias = GratisTipo.Desconocido;
        suscripcionSeleccionadaNoticias = SuscripcionTipo.Desconocido;

        enlaceDespedidas = string.Empty;
        fechaDespedidas = DateTime.Now;

        #endregion

        enviandoNoticia = false;
    }

    private List<Bundles2.Bundle> bundles { get; set; }

    private async Task CambiarBundleNoticias(MouseEventArgs e, BundleTipo nuevoTipo)
    {
        bundleTipoSeleccionado = nuevoTipo;
        bundles = await BaseDatos.Bundles.Buscar.Actuales(0, bundleTipoSeleccionado);

        if (bundles?.Count > 0)
        {
            bundles = bundles.OrderBy(b => b.FechaEmpieza).ToList();
        }
    }

    private async Task ClickearBundleNoticias(MouseEventArgs e, int bundleId)
    {
        noticia = await Plantillas.Bundles(bundleId);
        plantillaCargada = true;

        var bundle = await BaseDatos.Bundles.Buscar.UnBundle(bundleId);

        if (bundle != null)
        {
            noticia.Enlace = bundle.Enlace;

            List<string> imagenes = new List<string>();
            imagenes.Add(bundle.ImagenNoticia);

            string encabezadoImagen = Bundles2.BundlesCargar.DevolverBundle(bundle.BundleTipo).ImagenTienda;

            if (imagenes?.Count > 0)
            {
                var resultado = await Herramientas.Ficheros.Constructor.Imagen(imagenes, "https://" + dominio + "/" + encabezadoImagen, Herramientas.Ficheros.Constructor.ImagenModo.Bundle);

                if (resultado.Exito == true)
                {
                    noticia.Imagen = "https://" + dominio + resultado.DirectorioFichero;
                }
            }
        }
    }

    private List<global::Juegos.JuegoGratis> gratis { get; set; }

    private async Task CambiarGratisNoticias(MouseEventArgs e, GratisTipo nuevoTipo)
    {
        gratisSeleccionadoNoticias = nuevoTipo;
        gratis = await BaseDatos.Gratis.Buscar.Actuales(gratisSeleccionadoNoticias);

        if (gratis?.Count > 0)
        {
            gratis = gratis.OrderBy(g => g.FechaEmpieza).ToList();
        }
    }

    private async Task ClickearGratisJuegoNoticias(MouseEventArgs e, int juegoId, int id)
    {
        noticia = await Plantillas.Gratis(noticia, juegoId, id, gratisSeleccionadoNoticias);
        plantillaCargada = true;

        if (string.IsNullOrEmpty(noticia.GratisIds) == false)
        {
            List<string> cantidadIds = new List<string>();
            string[] datosPartidos = noticia.GratisIds.Split(',');
            cantidadIds.AddRange(datosPartidos);

            if (cantidadIds.Count == 1)
            {
                noticia.Enlace = (await BaseDatos.Gratis.Buscar.UnGratis(cantidadIds[0])).Enlace;
            }
            else if (cantidadIds.Count > 0)
            {
                noticia.Enlace = null;
            }

            List<string> imagenes = new List<string>();
            string encabezadoImagen = string.Empty;

            foreach (var id2 in cantidadIds)
            {
                var gratis = await BaseDatos.Gratis.Buscar.UnGratis(id2);

                encabezadoImagen = Gratis2.GratisCargar.DevolverGratis(gratis.Tipo).ImagenLogo;
                imagenes.Add(gratis.Imagen);
            }

            if (imagenes?.Count > 0)
            {
                var resultado = await Herramientas.Ficheros.Constructor.Imagen(imagenes, "https://" + dominio + "/" + encabezadoImagen, Herramientas.Ficheros.Constructor.ImagenModo.Juego);

                if (resultado.Exito == true)
                {
                    noticia.Imagen = "https://" + dominio + resultado.DirectorioFichero;
                }
            }
        }
    }

    private List<global::Juegos.JuegoSuscripcion> suscripciones { get; set; }

    private async Task CambiarSuscripcionNoticias(MouseEventArgs e, SuscripcionTipo nuevoTipo)
    {
        await CambiarSuscripcionNoticias(nuevoTipo);
    }

    private async Task CambiarSuscripcionNoticias(SuscripcionTipo nuevoTipo)
    {
        suscripcionSeleccionadaNoticias = nuevoTipo;
        suscripciones = await BaseDatos.Suscripciones.Buscar.Actuales(suscripcionSeleccionadaNoticias);

        if (suscripciones?.Count > 0)
        {
            suscripciones = suscripciones.OrderBy(s => s.FechaEmpieza).ToList();
        }
    }

    private async Task ClickearSuscripcionJuego(MouseEventArgs e, int juegoId, int id)
    {
        noticia = await Plantillas.Suscripciones(noticia, juegoId, id, suscripcionSeleccionadaNoticias);
        plantillaCargada = true;

        if (string.IsNullOrEmpty(noticia.SuscripcionesIds) == false)
        {
            List<string> cantidadIds = new List<string>();
            string[] datosPartidos = noticia.SuscripcionesIds.Split(',');
            cantidadIds.AddRange(datosPartidos);

            if (cantidadIds.Count > 0)
            {
                string enlace = (await BaseDatos.Suscripciones.Buscar.Id(int.Parse(cantidadIds[0]))).Enlace;

                foreach (var id2 in cantidadIds)
                {
                    if ((await BaseDatos.Suscripciones.Buscar.Id(int.Parse(id2))).Enlace != enlace)
                    {
                        enlace = string.Empty;
                        break;
                    }
                }

                noticia.Enlace = enlace;

                List<string> imagenes = new List<string>();
                string encabezadoImagen = string.Empty;

                foreach (var id2 in cantidadIds)
                {
                    var suscripcion = await BaseDatos.Suscripciones.Buscar.Id(int.Parse(id2));

                    encabezadoImagen = Suscripciones2.SuscripcionesCargar.DevolverSuscripcion(suscripcion.Tipo).ImagenLogo;
                    imagenes.Add(suscripcion.Imagen);
                }

                if (imagenes?.Count > 0)
                {
                    var resultado = await Herramientas.Ficheros.Constructor.Imagen(imagenes, "https://" + dominio + "/" + encabezadoImagen, Herramientas.Ficheros.Constructor.ImagenModo.Juego);

                    if (resultado.Exito == true)
                    {
                        noticia.Imagen = "https://" + dominio + resultado.DirectorioFichero;
                    }
                }
            }
        }
    }

    #region Editor

    private void EditorDiv(MouseEventArgs e, Plantilla textoDondeAñadir, string idioma)
    {
        if (idioma == "en")
        {
            bool yaExiste = false;

            if (string.IsNullOrEmpty(textoDondeAñadir.ContenidoEn) == false)
            {
                if (textoDondeAñadir.ContenidoEn.Contains("<div>") == true)
                {
                    yaExiste = true;
                }
            }

            if (yaExiste == false)
            {
                textoDondeAñadir.ContenidoEn = textoDondeAñadir.ContenidoEn + "<div>" + Environment.NewLine + Environment.NewLine + "</div>";
            }
            else
            {
                textoDondeAñadir.ContenidoEn = textoDondeAñadir.ContenidoEn + @"<div style=""margin-top: 10px;"">" + Environment.NewLine + Environment.NewLine + "</div>";
            }
        }

        if (idioma == "es")
        {
            bool yaExiste = false;

            if (string.IsNullOrEmpty(textoDondeAñadir.ContenidoEs) == false)
            {
                if (textoDondeAñadir.ContenidoEs.Contains("<div>") == true)
                {
                    yaExiste = true;
                }
            }

            if (yaExiste == false)
            {
                textoDondeAñadir.ContenidoEs = textoDondeAñadir.ContenidoEs + @"<div>" + Environment.NewLine + Environment.NewLine + "</div>";
            }
            else
            {
                textoDondeAñadir.ContenidoEs = textoDondeAñadir.ContenidoEs + @"<div style=""margin-top: 10px;"">" + Environment.NewLine + Environment.NewLine + "</div>";
            }
        }       
    }

    private void EditorUl(MouseEventArgs e, Plantilla textoDondeAñadir, string idioma)
    {
        if (idioma == "en")
        {
            textoDondeAñadir.ContenidoEn = textoDondeAñadir.ContenidoEn + "<ul>" + Environment.NewLine + "<li>" + Environment.NewLine + Environment.NewLine + "</li>" + Environment.NewLine + "</ul>";
        }

        if (idioma == "es")
        {
            textoDondeAñadir.ContenidoEs = textoDondeAñadir.ContenidoEs + "<ul>" + Environment.NewLine + "<li>" + Environment.NewLine + Environment.NewLine + "</li>" + Environment.NewLine + "</ul>";
        }
    }

