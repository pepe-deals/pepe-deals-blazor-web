@using Juegos
@using Tiendas2

@if (preciosActualesOficialesDRM.Count > 0 || preciosActualesNoOficialesDRM.Count > 0 || preciosActualesMarketplacesDRM.Count > 0)
{
    <div class="caja-juego-tiendas" style="display: flex; flex-direction: column; gap: 20px; padding: 15px;">
        @if (preciosPrincipales?.Count > 0)
        {
            @if (MostrarFiltro() == true)
            {
                <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                    @foreach (var opcion in OpcionesFiltro())
                    {
                        <button class="juego-boton-pequeño" @onclick="() => CambiarFiltro(opcion.Valor)" style="width: fit-content; padding: 8px 12px; font-size: 14px; @(filtroEdicion == opcion.Valor ? "border: 1px solid rgba(255,255,255,0.2);" : "opacity: 0.5;")">
                            @opcion.Texto
                        </button>
                    }
                </div>
            }

            if (Herramientas.Bots.UserAgentEsBot(userAgent) == false)
            {
                if (preciosPrincipales.Count < 10)
                {
                    foreach (var precio in preciosPrincipales)
                    {
                        <JuegoTiendasEnlace @key="(precio.Enlace + precio.Tienda)" noOficial="@noOficial" region="@region" precio="@precio" usuarioId="@usuarioId" idioma="@idioma" userAgent="@userAgent"
                                            usuarioPatreon="@usuarioPatreon" juegosUsuario="@juegosUsuario" juegoNombre="@juegoNombre"
                                            OnPrecioFinalCalculado="pf => preciosFinalesCalculados[precio.Enlace + precio.Tienda] = pf" />
                    }
                }
                else
                {
                    <Virtualize Context="precio" Items="preciosPrincipales">
                        <ItemContent>
                            <JuegoTiendasEnlace @key="(precio.Enlace + precio.Tienda)" noOficial="@noOficial" region="@region" precio="@precio" usuarioId="@usuarioId" idioma="@idioma" userAgent="@userAgent"
                                                usuarioPatreon="@usuarioPatreon" juegosUsuario="@juegosUsuario" juegoNombre="@juegoNombre"
                                                OnPrecioFinalCalculado="pf => preciosFinalesCalculados[precio.Enlace + precio.Tienda] = pf" />
                        </ItemContent>
                    </Virtualize>
                }
            }
            else
            {
                foreach (var precio in preciosPrincipales.Take(5))
                {
                    <JuegoTiendasEnlace @key="(precio.Enlace + precio.Tienda)" noOficial="@noOficial" region="@region" precio="@precio" usuarioId="@usuarioId" idioma="@idioma" userAgent="@userAgent"
                                        usuarioPatreon="@usuarioPatreon" juegosUsuario="@juegosUsuario" juegoNombre="@juegoNombre"
                                        OnPrecioFinalCalculado="pf => preciosFinalesCalculados[precio.Enlace + precio.Tienda] = pf" />
                }
            }
        }

        @if (preciosCaros?.Count > 0)
        {
            <button class="juego-boton-pequeño" style="border: 1px solid rgba(255,255,255,0.2); display: block; @(mostrarDescuentosBajos == true ? "" : "margin-bottom: 10px;")" @onclick="(e => DescuentosBajosMostrar(e))">
                <div style="display: flex; align-items: center; padding: 5px;">
                    <div style="max-width: 12px;">
                        <svg class="svg-boton" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" style="transform: rotate(@(mostrarDescuentosBajos == true ? "0deg" : "180deg")); transition: transform 0.2s;">
                            <path d="M246.6 41.4c-12.5-12.5-32.8-12.5-45.3 0l-160 160c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L224 109.3 361.4 246.6c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3l-160-160zm160 352l-160-160c-12.5-12.5-32.8-12.5-45.3 0l-160 160c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L224 301.3 361.4 438.6c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3z" />
                        </svg>
                    </div>

                    <div style="width: 100%; text-align: center; font-size: 14px;">
                        @if (mostrarDescuentosBajos == true)
                        {
                            @Herramientas.Idiomas.BuscarTexto(idioma, "String43", "Game")
                        }
                        else
                        {
                            @Herramientas.Idiomas.BuscarTexto(idioma, "String42", "Game")
                        }
                    </div>

                    <div style="max-width: 12px;">
                        <svg class="svg-boton" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" style="transform: rotate(@(mostrarDescuentosBajos == true ? "0deg" : "180deg")); transition: transform 0.2s;">
                            <path d="M246.6 41.4c-12.5-12.5-32.8-12.5-45.3 0l-160 160c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L224 109.3 361.4 246.6c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3l-160-160zm160 352l-160-160c-12.5-12.5-32.8-12.5-45.3 0l-160 160c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L224 301.3 361.4 438.6c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3z" />
                        </svg>
                    </div>
                </div>
            </button>

            if (mostrarDescuentosBajos == true)
            {
                if (Herramientas.Bots.UserAgentEsBot(userAgent) == false)
                {
                    <Virtualize Context="precioBajo" Items="preciosCaros">
                        <ItemContent>
                            <JuegoTiendasEnlace @key="(precioBajo.Enlace + precioBajo.Tienda)" noOficial="@noOficial" region="@region" precio="@precioBajo" usuarioId="@usuarioId" idioma="@idioma" userAgent="@userAgent"
                                                usuarioPatreon="@usuarioPatreon" juegosUsuario="@juegosUsuario" juegoNombre="@juegoNombre" />
                        </ItemContent>
                    </Virtualize>
                }
                else
                {
                    foreach (var precioBajo in preciosCaros.Take(3))
                    {
                        <JuegoTiendasEnlace @key="(precioBajo.Enlace + precioBajo.Tienda)" noOficial="@noOficial" region="@region" precio="@precioBajo" usuarioId="@usuarioId" idioma="@idioma" userAgent="@userAgent"
                                            usuarioPatreon="@usuarioPatreon" juegosUsuario="@juegosUsuario" juegoNombre="@juegoNombre" />
                    }
                }
            }
        }
    </div>
}
else
{
    if (string.IsNullOrEmpty(mensajeMinimoDRM) == false)
    {
        <div style="padding: 30px 40px;">@Herramientas.Idiomas.BuscarTexto(idioma, "String12", "Game")</div>
    }
}


@code {

    #nullable disable

    [Parameter]
    public bool noOficial { get; set; }

    [Parameter]
    public bool marketplace { get; set; }

    [Parameter]
    public TiendaRegion region { get; set; }

    [Parameter]
    public List<JuegoPrecio> preciosActualesOficialesDRM { get; set; }

    [Parameter]
    public List<JuegoPrecio> preciosActualesNoOficialesDRM { get; set; }

    [Parameter]
    public List<JuegoPrecio> preciosActualesMarketplacesDRM { get; set; }

    [Parameter]
    public string mensajeMinimoDRM { get; set; }

    [Parameter]
    public string usuarioId { get; set; }

    [Parameter]
    public string idioma { get; set; }

    [Parameter]
    public string userAgent { get; set; }

    [Parameter]
    public bool usuarioPatreon { get; set; }

    [Parameter]
    public Herramientas.UsuarioListadosJuegos juegosUsuario { get; set; }

    [Parameter]
    public string juegoNombre { get; set; }

    private bool mostrarDescuentosBajos = false;

    [PersistentState] public List<JuegoPrecio> preciosActivos { get; set; }
    [PersistentState] public List<JuegoPrecio> preciosPrincipales { get; set; }
    [PersistentState] public List<JuegoPrecio> preciosCaros { get; set; }

    protected override void OnInitialized()
    {
        preciosPrincipales = new List<JuegoPrecio>();
        preciosCaros = new List<JuegoPrecio>();

        if (preciosActivos == null)
        {
            preciosActivos = new List<JuegoPrecio>();
            preciosActivos = preciosActualesOficialesDRM.Where(p => Herramientas.OfertaActiva.Verificar(p))
                .Concat(noOficial == true ? preciosActualesNoOficialesDRM.Where(p => Herramientas.OfertaActiva.Verificar(p)) : Enumerable.Empty<JuegoPrecio>())
                .Concat(marketplace == true ? preciosActualesMarketplacesDRM.Where(p => Herramientas.OfertaActiva.Verificar(p)) : Enumerable.Empty<JuegoPrecio>())
                .ToList();
        }

        if (preciosActivos.Any() == false)
        {
            return;
        }

        #region Filtro

        ediciones.Clear();
        foreach (var p in preciosActivos)
        {
            ediciones[p.Enlace + p.Tienda] = ObtenerEdicion(p);
        }

        edicionesDisponibles = ediciones.Values
            .Where(e => e != null && e != FiltroBundles)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(e => e)
            .ToList();

        hayEstandar = ediciones.Values.Any(e => e == null);
        hayBundles = ediciones.Values.Any(e => e == FiltroBundles);
        CalcularListas();

        #endregion
    }

    private Dictionary<string, decimal> preciosFinalesCalculados = new();
    private int preciosFinalesCalculadosContadorAnterior = 0;

    protected override async Task OnAfterRenderAsync(bool primerRender)
    {
        if (preciosFinalesCalculados.Count > preciosFinalesCalculadosContadorAnterior)
        {
            preciosFinalesCalculadosContadorAnterior = preciosFinalesCalculados.Count;
            CalcularListas();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void DescuentosBajosMostrar(MouseEventArgs e)
    {
        mostrarDescuentosBajos = !mostrarDescuentosBajos;
    }

    private decimal ObtenerPrecioOrden(JuegoPrecio p)
    {
        if (preciosFinalesCalculados.TryGetValue(p.Enlace + p.Tienda, out decimal pf) && pf > 0)
        {
            return pf;
        }

        if (region == TiendaRegion.Europa && p.Moneda == Herramientas.JuegoMoneda.Euro)
        {
            return p.Precio;
        }

        if (region == TiendaRegion.EstadosUnidos && p.Moneda == Herramientas.JuegoMoneda.Dolar)
        {
            return p.Precio;
        }

        return p.PrecioCambiado;
    }

    private void CalcularListas()
    {
        preciosPrincipales = new List<JuegoPrecio>();
        preciosCaros = new List<JuegoPrecio>();

        List<JuegoPrecio> filtrados = preciosActivos.Where(CoincideFiltro).ToList();

        if (filtrados.Count == 0)
        {
            return;
        }

        int umbralDescuento = filtrados.Max(p => p.Descuento) / 2;
        HashSet<string> enlacesUsados = new HashSet<string>();

        foreach (var precio in filtrados)
        {
            if (enlacesUsados.Add(precio.Enlace + precio.Tienda) == false)
            {
                continue;
            }

            if (precio.Descuento >= umbralDescuento ||
                precio.Tienda == APIs.Steam.Tienda.GenerarBundles().Id ||
                (precio.Descuento == 0 && Tiendas2.TiendasCargar.DevolverTienda(precio.Tienda).Tipo == TiendaTipo.NoOficial))
            {
                preciosPrincipales.Add(precio);
            }
            else
            {
                preciosCaros.Add(precio);
            }
        }

        decimal precioMinimoMostrar = preciosPrincipales
            .Select(ObtenerPrecioOrden)
            .Where(p => p > 0)
            .DefaultIfEmpty(decimal.MaxValue)
            .Max();

        List<JuegoPrecio> mover = preciosCaros
            .Where(p =>
            {
                decimal precioReal = ObtenerPrecioOrden(p);
                return precioReal > 0 && precioReal < precioMinimoMostrar;
            }).ToList();

        foreach (JuegoPrecio precio in mover)
        {
            preciosCaros.Remove(precio);
            preciosPrincipales.Add(precio);
        }

        preciosPrincipales = preciosPrincipales.OrderBy(ObtenerPrecioOrden).ToList();
        preciosCaros = preciosCaros.OrderBy(ObtenerPrecioOrden).ToList();
    }

    #region Filtro

    private const string FiltroTodos = "__todos__";
    private const string FiltroEstandar = "__estandar__";
    private const string FiltroBundles = "__bundles__";
    private bool hayBundles = false;

    private string filtroEdicion = FiltroTodos;
    private Dictionary<string, string> ediciones = new();
    private List<string> edicionesDisponibles = new();
    private bool hayEstandar = false;

    private string ObtenerEdicion(JuegoPrecio p)
    {
        if (p.Tienda == APIs.Steam.Tienda.GenerarBundles().Id)
        {
            return FiltroBundles;
        }

        string edicion = JuegoTiendasEnlace.ComprobarEdicion(juegoNombre, p.Nombre, idioma);
        return string.IsNullOrWhiteSpace(edicion) ? null : edicion.Trim();
    }

    private bool CoincideFiltro(JuegoPrecio p)
    {
        if (filtroEdicion == FiltroTodos)
        {
            return true;
        }

        ediciones.TryGetValue(p.Enlace + p.Tienda, out string edicion);

        if (filtroEdicion == FiltroEstandar)
        {
            return edicion == null;
        }

        return string.Equals(edicion, filtroEdicion, StringComparison.OrdinalIgnoreCase);
    }

    private bool MostrarFiltro()
    {
        return Herramientas.Bots.UserAgentEsBot(userAgent) == false && edicionesDisponibles.Count + (hayEstandar ? 1 : 0) + (hayBundles ? 1 : 0) >= 2;
    }

    private List<(string Valor, string Texto)> OpcionesFiltro()
    {
        var opciones = new List<(string Valor, string Texto)>();

        if (hayEstandar == true)
        {
            opciones.Add((FiltroEstandar, Herramientas.Idiomas.BuscarTexto(idioma, "String2", "GameEditions")));
        }

        foreach (var edicion in edicionesDisponibles)
        {
            opciones.Add((edicion, edicion));
        }

        if (hayBundles == true)
        {
            opciones.Add((FiltroBundles, Herramientas.Idiomas.BuscarTexto(idioma, "String3", "GameEditions")));
        }

        opciones = opciones.OrderBy(o => o.Texto, StringComparer.CurrentCultureIgnoreCase).ToList();

        opciones.Insert(0, (FiltroTodos, Herramientas.Idiomas.BuscarTexto(idioma, "String1", "GameEditions")));

        return opciones;
    }

    private void CambiarFiltro(string valor)
    {
        filtroEdicion = valor;
        CalcularListas();
    }

    #endregion
}