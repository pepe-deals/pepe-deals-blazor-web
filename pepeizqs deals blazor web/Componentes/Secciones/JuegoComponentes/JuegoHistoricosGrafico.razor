@using ApexCharts
@using Juegos
@using Tiendas2

<ApexChart TItem="PuntoGrafico" Options="@opcionesGrafico">
    <ApexPointTooltip>
        <div style="background-color: var(--fondoBotonPequeño); color: var(--colorTexto); padding: 10px; border: 1px solid rgba(255,255,255,0.3); border-radius: 5px;">
            @{
                var puntosDatos = context.DataPoint;

                string icono = string.Empty;
                string nombre = string.Empty;

                foreach (var tienda in Tiendas2.TiendasCargar.GenerarListado())
                {
                    if (tienda.Id == puntosDatos.Items.FirstOrDefault()?.Tienda)
                    {
                        icono = "https://" + dominio + "/" + tienda.ImagenIcono;
                        nombre = tienda.Nombre;
                        break;
                    }
                }

                <div style="display: flex; align-items: center; gap: 10px;">
                    <img src="@icono" style="width: 20px; height: 20px;"  />
                    <label>@nombre</label>
                </div>
            }

            <div style="margin-top: 5px;">
                @{
                    decimal? precio = puntosDatos.Items.FirstOrDefault()?.Precio;

                    if (precio > 0)
                    {
                        string precioTexto = string.Empty;

                        if (usuarioRegion == TiendaRegion.Europa)
                        {
                            precioTexto = Herramientas.Precios.Euro(precio);
                        }
                        else
                        {
                            precioTexto = Herramientas.Precios.Dolar(precio);
                        }

                        if (string.IsNullOrEmpty(precioTexto) == false)
                        {
                            string fechaTexto = puntosDatos.Items.FirstOrDefault()?.DiaMes.Day.ToString() + "/" + puntosDatos.Items.FirstOrDefault()?.DiaMes.Month.ToString() + "/" + puntosDatos.Items.FirstOrDefault()?.DiaMes.Year.ToString();

                            <div>
                                <strong>@precioTexto</strong> - @fechaTexto
                            </div>
                        }
                    }
                }
            </div>
        </div>
    </ApexPointTooltip>

    <ChildContent>
        @foreach (var punto in lineaOficiales)
        {
            List<PuntoGrafico> datos = new List<PuntoGrafico>();

            foreach (var subpunto in punto.Puntos)
            {
                datos.Add(new PuntoGrafico { 
                    DiaMes = subpunto.Fecha, 
                    Precio = (decimal)subpunto.Precio, 
                    Año = punto.Año.ToString(), 
                    Tienda = subpunto.Tienda
                });
            }

            <ApexPointSeries TItem="PuntoGrafico" Items="datos" Name="@punto.Nombre"
                SeriesType="SeriesType.Line" XValue="e => e.DiaMes" YValue="e => e.Precio" ShowDataLabels="true"/>
        }

        @if (usuarioTiendasNoOficial == true)
        {
            foreach (var punto in lineaNoOficiales)
            {
                List<PuntoGrafico> datos = new List<PuntoGrafico>();

                foreach (var subpunto in punto.Puntos)
                {
                    datos.Add(new PuntoGrafico
                    {
                        DiaMes = subpunto.Fecha,
                        Precio = (decimal)subpunto.Precio,
                        Año = punto.Año.ToString(),
                        Tienda = subpunto.Tienda
                    });
                }

                <ApexPointSeries TItem="PuntoGrafico" Items="datos" Name="@punto.Nombre"
                                 SeriesType="SeriesType.Line" XValue="e => e.DiaMes" YValue="e => e.Precio" ShowDataLabels="true" />
            }
        }

        @if (usuarioTiendasMarketplace == true)
        {
            foreach (var punto in lineaMarketplaces)
            {
                List<PuntoGrafico> datos = new List<PuntoGrafico>();

                foreach (var subpunto in punto.Puntos)
                {
                    datos.Add(new PuntoGrafico
                    {
                        DiaMes = subpunto.Fecha,
                        Precio = (decimal)subpunto.Precio,
                        Año = punto.Año.ToString(),
                        Tienda = subpunto.Tienda
                    });
                }

                <ApexPointSeries TItem="PuntoGrafico" Items="datos" Name="@punto.Nombre"
                                 SeriesType="SeriesType.Line" XValue="e => e.DiaMes" YValue="e => e.Precio" ShowDataLabels="true" />
            }
        }
    </ChildContent>
</ApexChart>

@code {

    #nullable disable

    [Parameter]
    public string idioma { get; set; }

    [Parameter]
    public string dominio { get; set; }

    [Parameter]
    public JuegoDRM drmGrafico { get; set; } = JuegoDRM.NoEspecificado;

    [Parameter]
    public List<JuegoHistorico> historicosOficiales { get; set; }

    [Parameter]
    public List<JuegoHistorico> historicosNoOficiales { get; set; }

    [Parameter]
    public List<JuegoHistorico> historicosMarketplaces { get; set; }

    [Parameter] 
    public TiendaRegion usuarioRegion { get; set; }

    [Parameter]
    public bool usuarioTiendasNoOficial { get; set; }

    [Parameter]
    public bool usuarioTiendasMarketplace { get; set; }

    [Parameter]
    public bool mostrarLabelsDuplicadas { get; set; }

    private ApexChartOptions<PuntoGrafico> opcionesGrafico = new ApexChartOptions<PuntoGrafico>();

    private List<Punto> lineaOficiales = new List<Punto>();
    private List<Punto> lineaNoOficiales = new List<Punto>();
    private List<Punto> lineaMarketplaces = new List<Punto>();

    private class Punto
    {
        public int Año { get; set; }
        public string Nombre { get; set; }
        public List<PuntoDatos> Puntos { get; set; }
    }

    private class PuntoDatos
    {
        public DateTime Fecha { get; set; }
        public double Precio { get; set; }
        public string Tienda { get; set; }
    }


    public class PuntoGrafico
    {
        public DateTime DiaMes { get; set; }
        public decimal Precio { get; set; }
        public string Año { get; set; }
        public string Tienda { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        lineaOficiales.Clear();

        List<JuegoHistorico> historicosOficialesMostrar = historicosOficiales;

        if (historicosOficialesMostrar?.Count > 0)
        {
            await GenerarPuntos(historicosOficialesMostrar, lineaOficiales, Herramientas.Idiomas.BuscarTexto(idioma, "String141", "Game"));
        }

        List<JuegoHistorico> historicosNoOficialesMostrar = null;

        if (usuarioTiendasNoOficial == true)
        {
            historicosNoOficialesMostrar = historicosNoOficiales;

            if (historicosNoOficialesMostrar?.Count > 0)
            {
                await GenerarPuntos(historicosNoOficialesMostrar, lineaNoOficiales, Herramientas.Idiomas.BuscarTexto(idioma, "String142", "Game"));
            }
        }

        List<JuegoHistorico> historicosMarketplacesMostrar = null;

        if (usuarioTiendasMarketplace == true)
        {
            historicosMarketplacesMostrar = historicosMarketplaces;

            if (historicosMarketplacesMostrar?.Count > 0)
            {
                await GenerarPuntos(historicosMarketplacesMostrar, lineaMarketplaces, Herramientas.Idiomas.BuscarTexto(idioma, "String143", "Game"));
            }
        }

        string moneda = usuarioRegion == TiendaRegion.Europa ? "EUR" : "USD";
        string nombreMoneda = usuarioRegion == TiendaRegion.Europa ? "Euro" : "Dolar";

        opcionesGrafico = new ApexChartOptions<PuntoGrafico>
        {
            Xaxis = new XAxis
            {
                Labels = new XAxisLabels
                {
                    Formatter = @"function (value) {
                                return new Date(value).toLocaleString('" + idioma + "',{month:'short', year:'numeric'})}",
                    Style = new AxisLabelStyle
                    {
                        FontSize = "14px",
                        FontFamily = "Motiva Sans"
                    },
                    ShowDuplicates = false,
                    HideOverlappingLabels = true
                },
                Type = XAxisType.Datetime
            },
            Yaxis = new List<YAxis>() {
                (new YAxis
                {
                    Labels = new YAxisLabels
                    {
                        Formatter = @"function (value) {
                                        let " + nombreMoneda + @" = new Intl.NumberFormat('es-ES', {
                                            style: 'currency',
                                            currency: '" + moneda + @"',
                                        });
                                    return " + nombreMoneda + @".format(value)}",
                        Style = new AxisLabelStyle
                        {
                            FontSize = "14px",
                            FontFamily = "Motiva Sans"
                        }
                    }
                }
            )},
            Theme = new Theme
            {
                Mode = Mode.Dark
            },
            Title = new Title
            {
                Style = new TitleStyle
                {
                    FontSize = "16px",
                    FontFamily = "Motiva Sans",
                    FontWeight = "300"
                },
            },
            Chart = new Chart
            {
                Toolbar = new Toolbar
                {
                    Show = false
                },
                Background = "transparent",
                FontFamily = "Motiva Sans",
                Zoom = new Zoom
                {
                    Enabled = false
                },
                Width = "100%",
                Height = "100%"
            },
            Grid = new Grid
            {
                Row = new GridRow
                {
                    Colors = new List<string> { "transparent" }
                },
                Padding = new Padding
                {
                    Right = 30,
                    Left = 30
                }
            },
            Markers = new Markers { Shape = MarkerShape.Circle, Size = 5, FillOpacity = new Opacity(0.8d) },
            Stroke = new Stroke { Curve = Curve.Smooth },
            Colors = new List<string> { "#132434", "#091018", "#101c2b" }
        };

        if (mostrarLabelsDuplicadas == false)
        {
            opcionesGrafico.DataLabels = new ApexCharts.DataLabels
            {
                OffsetY = -8d,
                Formatter = @"function (value, { series, seriesIndex, dataPointIndex, w }) {
                            const serieDatos = w.config.series[seriesIndex]?.data || [];

                            for (let i = dataPointIndex - 1; i >= 0; i--) {
                                const datoPrevio = serieDatos[i]?.y !== undefined ? serieDatos[i].y : serieDatos[i];
                                if (datoPrevio === value) {
                                    return ''; 
                                }
                            }

                            let " + nombreMoneda + @" = new Intl.NumberFormat('es-ES', {
                                style: 'currency',
                                currency: '" + moneda + @"',
                            });
                            return " + nombreMoneda + @".format(value)
                        }",
                Style = new DataLabelsStyle
                {
                    FontSize = "14px",
                    FontFamily = "Motiva Sans"
                }
            };
        }
        else
        {
            opcionesGrafico.DataLabels = new ApexCharts.DataLabels
            {
                OffsetY = -8d,
                Formatter = @"function (value) {
                                let " + nombreMoneda + @" = new Intl.NumberFormat('es-ES', {
                                    style: 'currency',
                                    currency: '" + moneda + @"',
                                });
                            return " + nombreMoneda + @".format(value)}",
                Style = new DataLabelsStyle
                {
                    FontSize = "14px",
                    FontFamily = "Motiva Sans"
                }
            };
        }
    }

    private async Task GenerarPuntos(List<JuegoHistorico> historicosReferencia, List<Punto> puntosAñadir, string nombre)
    {
        JuegoDRM drm = drmGrafico;

        #region Añadir Años

        foreach (var historico in historicosReferencia)
        {
            if (drm == historico.DRM)
            {
                if (puntosAñadir.Count == 0)
                {
                    Punto año = new Punto();
                    año.Nombre = nombre;
                    año.Puntos = new List<PuntoDatos>();

                    puntosAñadir.Add(año);
                }
            }
        }

        #endregion

        #region Añadir Puntos

        foreach (var historico in historicosReferencia)
        {
            if (drm == historico.DRM)
            {
                bool añadir = true;

                var historico2 = historico;

                foreach (var historico3 in historicosReferencia)
                {
                    if (drm == historico3.DRM && drm == historico2.DRM &&
                        historico3.Fecha.Day == historico2.Fecha.Day &&
                        historico3.Fecha.Month == historico2.Fecha.Month &&
                        historico3.Fecha.Year == historico2.Fecha.Year &&
                        historico3.Precio != historico2.Precio)
                    {
                        if (historico3.Precio < historico2.Precio)
                        {
                            añadir = false;
                        }
                    }
                }

                if (añadir == true)
                {
                    foreach (var punto in puntosAñadir)
                    {
                        bool duplicado = false;

                        PuntoDatos nuevoPunto = new PuntoDatos
                        {
                            Fecha = new DateTime(historico2.Fecha.Year, historico2.Fecha.Month, historico2.Fecha.Day),
                            Precio = (double)historico2.Precio,
                            Tienda = historico2.Tienda
                        };

                        foreach (var puntoPuesto in punto.Puntos)
                        {
                            if (puntoPuesto.Precio == nuevoPunto.Precio && puntoPuesto.Fecha.AddDays(21) > nuevoPunto.Fecha)
                            {
                                duplicado = true;
                            }
                        }

                        if (duplicado == false)
                        {
                            punto.Puntos.Add(nuevoPunto);
                        }
                    }
                }
            }
        }

        #endregion
    }
}
