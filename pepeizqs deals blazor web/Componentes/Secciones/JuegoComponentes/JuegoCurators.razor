@using Juegos
@using Tiendas2
@using pepeizqs_deals_blazor_web.Componentes.Interfaz

@attribute [StreamRendering(true)]

@if (curators?.Count > 0 && Herramientas.Bots.UserAgentEsBot(userAgent) == false)
{
    foreach (var curator in curators)
    {
        List<int> juegosSteam = curator.Curator.SteamIds;

        if (juegosSteam?.Count > 0)
        {
            if (curator.JuegosMostrar?.Count > 0)
            {
                <div id="curator-@curator.Curator.IdSteam.ToString()" class="caja-juego-contenido">
                    <div class="caja-juego-titulo" style="display: flex; align-items: center; gap: 20px;">
                        <img src="@Herramientas.Ficheros.Imagenes.ServidorExterno(curator.Curator.Imagen, 60, 60)" alt="@curator.Curator.Nombre" style="width: 60px; height: 60px;"  />

                        <a href="/curator/@curator.Curator.Slug.ToLower()/" target="_blank" style="text-decoration: none;">
                            <div style="display: flex; flex-direction: column; gap: 10px;">
                                <div style="font-size: 18px;">
                                    @string.Format(Herramientas.Idiomas.BuscarTexto(idioma, "String89", "Game"), curator.Curator.Nombre)
                                </div>
                            </div>
                        </a>
                    </div>

                    <div style="padding: 30px; display: flex; align-items: center; justify-content: space-between; gap: 20px;">
                        @if (juegosSteam?.Count > 4)
                        {
                            <div class="tooltip-juego" style="position: absolute; left: -80px;" onmousemove="enseñarTooltip(event, 'tooltip-curator-back-@curator.Curator.Id.ToString()')">
                                <button @onclick="@(e => CuratorAtras(e, curator))" class="boton-pequeño" style="width: auto; text-align: center; font-size: 23px; padding: 12px 15px;" title="@Herramientas.Idiomas.BuscarTexto(idioma, "String114", "Game")">
                                    <div style="max-width: 24px;">
                                        <svg class="svg-boton" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512">
                                            <path d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.2 288 416 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-306.7 0L214.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z" />
                                        </svg>
                                    </div>
                                </button>

                                <div id="tooltip-curator-back-@curator.Curator.Id.ToString()" class="tooltip-relleno">
                                    <div style="margin: 8px; max-width: 300px; font-size: 14px;">
                                        @Herramientas.Idiomas.BuscarTexto(idioma, "String114", "Game")
                                    </div>
                                </div>
                            </div>
                        }

                        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 30px; width: 100%;">
                            @foreach (var juegoCurator in curator.JuegosMostrar)
                            {
                                <CajaJuego idCurator="@curator.Curator.Id" noOficial="@tiendasNoOficial" idioma="@idioma" juego="@juegoCurator" juegosUsuarioIndex="@juegosUsuarioIndex" usuarioDeseadosImportados="@usuarioDeseadosImportados" usuarioDeseadosWeb="@usuarioDeseadosWeb" tipo="CajaJuego.Tipo.CuratorJuego" userAgent="@userAgent" />
                            }
                        </div>

                        @if (juegosSteam?.Count > 4)
                        {
                            <div class="tooltip-juego" style="position: absolute; right: -80px;" onmousemove="enseñarTooltip(event, 'tooltip-curator-next-@curator.Curator.Id.ToString()')">
                                <button @onclick="@(e => CuratorAdelante(e, curator))" class="boton-pequeño" style="width: auto; text-align: center; font-size: 23px; padding: 12px 15px;" title="@Herramientas.Idiomas.BuscarTexto(idioma, "String113", "Game")">
                                    <div style="max-width: 24px;">
                                        <svg class="svg-boton" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512">
                                            <path d="M438.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L338.8 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l306.7 0L233.4 393.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z" />
                                        </svg>
                                    </div>
                                </button>

                                <div id="tooltip-curator-next-@curator.Curator.Id.ToString()" class="tooltip-relleno">
                                    <div style="margin: 8px; max-width: 300px; font-size: 14px;">
                                        @Herramientas.Idiomas.BuscarTexto(idioma, "String113", "Game")
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div id="curator-@curator.Curator.IdSteam.ToString()" class="caja-juego-contenido">
                <div class="caja-juego-titulo" style="display: flex; align-items: center; gap: 20px;">
                    <img src="@Herramientas.Ficheros.Imagenes.ServidorExterno(curator.Curator.Imagen, 60, 60)" alt="@curator.Curator.Nombre" style="width: 60px; height: 60px;"  />

                    <a href="/curator/@curator.Curator.Slug.ToLower()/" target="_blank" style="text-decoration: none;">
                        <div style="display: flex; flex-direction: column; gap: 10px;">
                            <div style="font-size: 18px;">
                                @string.Format(Herramientas.Idiomas.BuscarTexto(idioma, "String89", "Game"), curator.Curator.Nombre)
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        }
    }
}

@code {

    #nullable disable

    [Parameter]
    public bool tiendasNoOficial { get; set; }

    [Parameter]
    public TiendaRegion region { get; set; }

    [Parameter]
    public string usuarioId { get; set; }

    [Parameter]
    public string idioma { get; set; }

    [Parameter]
    public string userAgent { get; set; }

    [Parameter]
    public Juego juego { get; set; }

    [Parameter]
    public Herramientas.UsuarioJuegosIndex juegosUsuarioIndex { get; set; }

    [Parameter]
    public Herramientas.UsuarioDeseadosImportadosIndex usuarioDeseadosImportados { get; set; }

    [Parameter]
    public Herramientas.UsuarioDeseadosWebIndex usuarioDeseadosWeb { get; set; }

    [PersistentState] public List<global::BaseDatos.Curators.CuratorFicha> curators { get; set; }

    protected override async Task OnInitializedAsync()
    {
        List<string> curatorsBuscar = new List<string>();

        if (Herramientas.Bots.UserAgentEsBot(userAgent) == false)
        {
            ExtractorCurators(juego.Caracteristicas?.Desarrolladores2, curatorsBuscar);
            ExtractorCurators(juego.Caracteristicas?.Editores2, curatorsBuscar);
            ExtractorCurators(juego.Caracteristicas?.Franquicias, curatorsBuscar);

            if (curatorsBuscar?.Count > 0)
            {
                var tareasCurators = curatorsBuscar.Where(c => !string.IsNullOrEmpty(c)).Select(c => ProcesarCurator(int.Parse(c))).ToList();

                await Task.WhenAll(tareasCurators);
            }

            if (curators?.Count > 0)
            {
                var tareasCuratorDatos = curators.Select(c => ProcesarDatosCurator(c)).ToList();

                await Task.WhenAll(tareasCuratorDatos);

                await InvokeAsync(StateHasChanged);
            }
        }
    }

    #region Inicio

    private void ExtractorCurators(List<JuegoCaracteristicasCurator> items, List<string> curatorsBuscar)
    {
        if (items?.Count > 0)
        {
            foreach (var x in items)
            {
                if (x.Id > 0)
                {
                    string idStr = x.Id.ToString();

                    if (curatorsBuscar.Contains(idStr) == false)
                    {
                        curatorsBuscar.Add(idStr);
                    }
                }
            }
        }
    }

    private async Task ProcesarCurator(int curadorId)
    {
        global::BaseDatos.Curators.Curator curator2 = await global::BaseDatos.Curators.Buscar.Uno(curadorId);

        if (curator2 == null)
        {
            global::BaseDatos.Curators.Insertar.Ejecutar(await APIs.Steam.Curator.Extraer(curadorId.ToString()));
        }
        else
        {
            if (curator2.Fecha == null || curator2.Fecha?.Subtract(DateTime.Now) > TimeSpan.FromDays(180))
            {
                global::BaseDatos.Curators.Actualizar.Ejecutar(curator2);
            }

            if (curators == null)
            {
                curators = new List<global::BaseDatos.Curators.CuratorFicha>();
            }

            lock (curators)
            {
                if (curators.Any(c => c.Curator.Id == curator2.Id) == false)
                {
                    var ficha = new global::BaseDatos.Curators.CuratorFicha
                    {
                        Curator = curator2,
                        Posicion = 0,
                        JuegosMostrar = new List<Juego>()
                    };

                    curators.Add(ficha);
                }
            }
        }
    }

    private async Task ProcesarDatosCurator(global::BaseDatos.Curators.CuratorFicha c)
    {
        List<int> juegosSteam = c.Curator.SteamIds;

        if (juegosSteam?.Count > 0)
        {
            int posicionBorrar = juegosSteam.FindIndex(id => id == juego.IdSteam);

            if (posicionBorrar > -1)
            {
                juegosSteam.RemoveAt(posicionBorrar);
            }
        }

        if (juegosSteam?.Count > 0)
        {
            c.Curator.SteamIds = await BaseDatos.Juegos.Buscar.MultiplesJuegosSteamOrdenado(juegosSteam);

            if (c.Curator.SteamIds?.Count > 0)
            {
                int cantidad = Math.Min(4, c.Curator.SteamIds.Count);
                c.JuegosMostrar = await BaseDatos.Juegos.Buscar.MultiplesJuegosSteam3(tiendasNoOficial, region, c.Curator.SteamIds.GetRange(c.Posicion, cantidad));
            }
        }
    }

    #endregion

    private async Task CuratorAtras(MouseEventArgs e, global::BaseDatos.Curators.CuratorFicha curator)
    {
        curator.Posicion = curator.Posicion - 4;

        if (curator.Posicion < -3)
        {
            curator.Posicion = curator.Curator.SteamIds.Count - 4;
        }
        else if (curator.Posicion < 0)
        {
            curator.Posicion = 0;
        }

        curator.JuegosMostrar = await global::BaseDatos.Juegos.Buscar.MultiplesJuegosSteam3(tiendasNoOficial, region, curator.Curator.SteamIds.GetRange(curator.Posicion, 4));
    }

    private async Task CuratorAdelante(MouseEventArgs e, global::BaseDatos.Curators.CuratorFicha curator)
    {
        curator.Posicion = curator.Posicion + 4;

        if (curator.Posicion > curator.Curator.SteamIds.Count - 1)
        {
            curator.Posicion = 0;
        }
        else if (curator.Posicion > curator.Curator.SteamIds.Count - 3)
        {
            curator.Posicion = curator.Curator.SteamIds.Count - 4;
        }

        curator.JuegosMostrar = await global::BaseDatos.Juegos.Buscar.MultiplesJuegosSteam3(tiendasNoOficial, region, curator.Curator.SteamIds.GetRange(curator.Posicion, 4));
    }
}
