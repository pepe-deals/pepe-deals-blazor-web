    private async Task<List<JuegoTieneDesea>> GenerarTieneDesea()
    {
        List<JuegoTieneDesea> usuarioTieneDesea2 = new List<JuegoTieneDesea>();

        foreach (DRM drm in JuegoDRM2.GenerarListado())
        {
            if (drm.Id != JuegoDRM.NoEspecificado)
            {
                if (VerificarMostrarDRMOferta(drmsEnseñar, drm.Id) == true)
                {
                    bool usuarioTieneDRM = false;

                    if (drm.Id == JuegoDRM.Steam && juego.IdSteam > 0 && juego.Tipo == JuegoTipo.Game)
                    {
                        List<SteamUsuarioJuego> juegosSteam = juegosUsuario.Steam;

                        if (juegosSteam?.Count > 0)
                        {
                            juegosSteam.ForEach(x => {if (x.Id == juego.IdSteam) {
                                    JuegoTieneDesea nuevoJuegoUsuario = new JuegoTieneDesea();
                                    nuevoJuegoUsuario.DRM = JuegoDRM.Steam;
                                    nuevoJuegoUsuario.Tiene = true;
                                    nuevoJuegoUsuario.JugadoTiempo = x.TiempoJugadoEnMinutos;
                                    nuevoJuegoUsuario.JugadoUltimaVez = x.TiempoJugadoUltimaVez;

                                    usuarioTieneDesea2.Add(nuevoJuegoUsuario);
                                    usuarioTieneDRM = true;
                                }});
                        }
                    }

                    if (drm.Id == JuegoDRM.GOG && juego.IdGog > 0 && juego.Tipo == JuegoTipo.Game)
                    {
                        List<GOGUsuarioJuego> juegosGog = juegosUsuario.Gog;

                        if (juegosGog?.Count > 0)
                        {
                            juegosGog.ForEach(x => {if (x.Id == juego.IdGog) {
                                    JuegoTieneDesea nuevoJuegoUsuario = new JuegoTieneDesea();
                                    nuevoJuegoUsuario.DRM = JuegoDRM.GOG;
                                    nuevoJuegoUsuario.Tiene = true;
                                    nuevoJuegoUsuario.JugadoTiempo = x.TiempoJugadoEnMinutos;
                                    nuevoJuegoUsuario.JugadoUltimaVez = x.TiempoJugadoUltimaVez;

                                    usuarioTieneDesea2.Add(nuevoJuegoUsuario);
                                    usuarioTieneDRM = true;
                                }});
                        }
                    }

                    if (drm.Id == JuegoDRM.Amazon && string.IsNullOrEmpty(juego.IdAmazon) == false && juego.Tipo == JuegoTipo.Game)
                    {
                        List<string> juegosAmazon = juegosUsuario.Amazon;

                        if (juegosAmazon?.Count > 0)
                        {
                            juegosAmazon.ForEach(x => {if (x == juego.IdAmazon.ToString()) {
                                    JuegoTieneDesea nuevoJuegoUsuario = new JuegoTieneDesea();
                                    nuevoJuegoUsuario.DRM = JuegoDRM.Amazon;
                                    nuevoJuegoUsuario.Tiene = true;

                                    usuarioTieneDesea2.Add(nuevoJuegoUsuario);
                                    usuarioTieneDRM = true;
                                }});
                        }
                    }

                    if (drm.Id == JuegoDRM.Epic && string.IsNullOrEmpty(juego.ExeEpic) == false && juego.Tipo == JuegoTipo.Game)
                    {
                        List<string> juegosEpic = juegosUsuario.Epic;

                        if (juegosEpic?.Count > 0)
                        {
                            juegosEpic.ForEach(x => {if (x == juego.ExeEpic.ToString()) {
                                    JuegoTieneDesea nuevoJuegoUsuario = new JuegoTieneDesea();
                                    nuevoJuegoUsuario.DRM = JuegoDRM.Epic;
                                    nuevoJuegoUsuario.Tiene = true;

                                    usuarioTieneDesea2.Add(nuevoJuegoUsuario);
                                    usuarioTieneDRM = true;
                                }});
                        }
                    }

                    if (drm.Id == JuegoDRM.Ubisoft && string.IsNullOrEmpty(juego.ExeUbisoft) == false && juego.Tipo == JuegoTipo.Game)
                    {
                        List<string> juegosUbisoft = juegosUsuario.Ubisoft;

                        if (juegosUbisoft?.Count > 0)
                        {
                            juegosUbisoft.ForEach(x => {if (x == juego.ExeUbisoft) {
                                    JuegoTieneDesea nuevoJuegoUsuario = new JuegoTieneDesea();
                                    nuevoJuegoUsuario.DRM = JuegoDRM.Ubisoft;
                                    nuevoJuegoUsuario.Tiene = true;

                                    usuarioTieneDesea2.Add(nuevoJuegoUsuario);
                                    usuarioTieneDRM = true;
                                }});
                        }
                    }

                    if (drm.Id == JuegoDRM.EA && string.IsNullOrEmpty(juego.ExeEA) == false && juego.Tipo == JuegoTipo.Game)
                    {
                        List<string> juegosEa = juegosUsuario.Ea;

