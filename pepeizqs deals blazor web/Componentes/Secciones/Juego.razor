                            preciosActualesOficialesDRM = Herramientas.Minimos.OrdenarPrecios(usuarioRegion, juego.PrecioActualesTiendas, drm.Id);
                        }
                        else if (usuarioRegion == TiendaRegion.EstadosUnidos)
                        {
                            preciosActualesOficialesDRM = Herramientas.Minimos.OrdenarPrecios(usuarioRegion, juego.PrecioActualesTiendasUS, drm.Id);  
                        }

                        if (usuarioTiendasNoOficial == true)
                        {
                            if (usuarioRegion == TiendaRegion.Europa)
                            {
                                preciosActualesNoOficialesDRM = Herramientas.Minimos.OrdenarPrecios(usuarioRegion, juego.PreciosActualesNoOficialesEU, drm.Id);
                            }
                            else if (usuarioRegion == TiendaRegion.EstadosUnidos)
                            {
                                preciosActualesNoOficialesDRM = Herramientas.Minimos.OrdenarPrecios(usuarioRegion, juego.PreciosActualesNoOficialesUS, drm.Id);  
                            }
                        }

                        <div id="@drm.Id">
                            @if (string.IsNullOrEmpty(mensajeMinimoOficialDRM) == false || string.IsNullOrEmpty(mensajeMinimoNoOficialDRM) == false)
                            {
                                if (string.IsNullOrEmpty(usuarioId) == false)
                                {
                                    if (usuarioTieneJuego == false && usuarioTieneDeseadoImportado == false)
                                    {
                                        string fondoDeseado = string.Empty;

                                        if (usuarioTieneDeseado == true)
                                        {
                                            fondoDeseado = "background-color: var(--fondoAlerta);";
                                        }

                                        @if (cargarComponentes == true)
                                        {
                                            <div class="tooltip-juego" id="trigger-wishlist-@drm.Id"
                                                 @onmouseenter="@(() => ActivarTooltip($"trigger-wishlist-{drm.Id}", $"tooltip-wishlist-{drm.Id}"))"
                                                 @onmouseleave="@(() => DesactivarTooltip($"trigger-wishlist-{drm.Id}"))">
                                                <button @onclick="@(e => CambiarEstadoDeseado(e, !usuarioTieneDeseado, drm.Id))" class="boton-pequeño boton-deseado" style="width: fit-content; padding: 10px; transform: none; @fondoDeseado">
									                <div style="fill: var(--colorTexto); width: 30px; height: 30px; display: flex;">
										                @if (usuarioTieneDeseado == true)
										                {
											                <svg class="svg-icono-rotante" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
												                <path d="M183.1 137.4C170.6 124.9 150.3 124.9 137.8 137.4C125.3 149.9 125.3 170.2 137.8 182.7L275.2 320L137.9 457.4C125.4 469.9 125.4 490.2 137.9 502.7C150.4 515.2 170.7 515.2 183.2 502.7L320.5 365.3L457.9 502.6C470.4 515.1 490.7 515.1 503.2 502.6C515.7 490.1 515.7 469.8 503.2 457.3L365.8 320L503.1 182.6C515.6 170.1 515.6 149.8 503.1 137.3C490.6 124.8 470.3 124.8 457.8 137.3L320.5 274.7L183.1 137.4z" />
											                </svg>
										                }
										                else
										                {
											                <svg class="svg-icono-rotante" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
												                <path d="M341.5 45.1C337.4 37.1 329.1 32 320.1 32C311.1 32 302.8 37.1 298.7 45.1L225.1 189.3L65.2 214.7C56.3 216.1 48.9 222.4 46.1 231C43.3 239.6 45.6 249 51.9 255.4L166.3 369.9L141.1 529.8C139.7 538.7 143.4 547.7 150.7 553C158 558.3 167.6 559.1 175.7 555L320.1 481.6L464.4 555C472.4 559.1 482.1 558.3 489.4 553C496.7 547.7 500.4 538.8 499 529.8L473.7 369.9L588.1 255.4C594.5 249 596.7 239.6 593.9 231C591.1 222.4 583.8 216.1 574.8 214.7L415 189.3L341.5 45.1z" />
											                </svg>
										                }
									                </div>
     								            </button>

                                                <div id="tooltip-wishlist-@drm.Id" class="tooltip-relleno">
                                                    <div style="margin: 8px; max-width: 300px; font-size: 14px;">
                                                        @if (usuarioTieneDeseado == true)
                                                        {
                                                            @Herramientas.Idiomas.BuscarTexto(idioma, "String3", "Game")
                                                        }
                                                        else
                                                        {
                                                            @Herramientas.Idiomas.BuscarTexto(idioma, "String4", "Game")
                                                        }
                                                    </div>
                                                </div>
                                            </div>                                            
                                        }
                                    }
                                }
                                else
                                {
                                    if (Herramientas.Bots.UserAgentEsBot(userAgent) == false && cargarComponentes == true)
                                    {
                                        <div class="tooltip-juego" id="trigger-wishlist-@drm.Id"
                                             @onmouseenter="@(() => ActivarTooltip($"trigger-wishlist-{drm.Id}", $"tooltip-wishlist-{drm.Id}"))"
                                             @onmouseleave="@(() => DesactivarTooltip($"trigger-wishlist-{drm.Id}"))">
                                            <button @onclick="@(e => LogearEnseñar(e))" class="boton-pequeño boton-deseado" style="width: fit-content; padding: 10px; transform: none;">
									            <div style="fill: var(--colorTexto); width: 30px; height: 30px; display: flex;">
										            <svg class="svg-icono-rotante" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
												        <path d="M341.5 45.1C337.4 37.1 329.1 32 320.1 32C311.1 32 302.8 37.1 298.7 45.1L225.1 189.3L65.2 214.7C56.3 216.1 48.9 222.4 46.1 231C43.3 239.6 45.6 249 51.9 255.4L166.3 369.9L141.1 529.8C139.7 538.7 143.4 547.7 150.7 553C158 558.3 167.6 559.1 175.7 555L320.1 481.6L464.4 555C472.4 559.1 482.1 558.3 489.4 553C496.7 547.7 500.4 538.8 499 529.8L473.7 369.9L588.1 255.4C594.5 249 596.7 239.6 593.9 231C591.1 222.4 583.8 216.1 574.8 214.7L415 189.3L341.5 45.1z" />
											        </svg>
									            </div>
     								        </button>

                                            <div id="tooltip-wishlist-@drm.Id" class="tooltip-relleno">
                                                <div style="margin: 8px; max-width: 500px; font-size: 14px;">
                                                    @Herramientas.Idiomas.BuscarTexto(idioma, "String4", "Game")
                                                </div>
                                            </div>
                                        </div>
                                    } 
                                }
                            }

                            <div class="caja-juego-contenido" style="width: 100%; display: flex; flex-direction: column; gap: 10px; padding: 10px;">                               
                                <AuthorizeView>
                                    <Authorized>
                                        @if (usuarioTieneJuego == true)
                                        {
                                            string mensaje = string.Empty;

                                            if (drm.Id == JuegoDRM.Steam || drm.Id == JuegoDRM.GOG || drm.Id == JuegoDRM.Amazon || drm.Id == JuegoDRM.Epic || drm.Id == JuegoDRM.Ubisoft || drm.Id == JuegoDRM.EA)
                                            {
                                                if (juego.Tipo == Juegos.JuegoTipo.Game)
                                                {
                                                    mensaje = string.Format(Herramientas.Idiomas.BuscarTexto(idioma, "String5", "Game"), JuegoDRM2.DevolverDRM(drm.Id));
                                                }
                                                else if (juego.Tipo == Juegos.JuegoTipo.DLC)
                                                {
                                                    mensaje = string.Format(Herramientas.Idiomas.BuscarTexto(idioma, "String6", "Game"), JuegoDRM2.DevolverDRM(drm.Id));
                                                }
                                            }

                                            <div style="background-color: var(--fondoBien); padding: 15px 20px; box-shadow: 0px 1px 2px 0px rgba(0, 0, 0, 0.5),0px 0px 1px 0px rgba(0, 0, 0, 0.5);">
                                                <div class="perfil-flexible-centrado" style="gap: 30px;">
                                                    <div style="display: flex; align-items: center; justify-content: center; min-width: 40px; height: 26px;">
                                                        <svg class="svg-boton" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                                                            <path d="M530.8 134.1C545.1 144.5 548.3 164.5 537.9 178.8L281.9 530.8C276.4 538.4 267.9 543.1 258.5 543.9C249.1 544.7 240 541.2 233.4 534.6L105.4 406.6C92.9 394.1 92.9 373.8 105.4 361.3C117.9 348.8 138.2 348.8 150.7 361.3L252.2 462.8L486.2 141.1C496.6 126.8 516.6 123.6 530.9 134z"/>
                                                        </svg>
                                                    </div>

                                                    @if (usuarioTieneJuegoTiempoJugado > 0 || usuarioTieneJuegoUltimaVezJugado > 0)
                                                    {
                                                        <div style="display: flex; align-items: baseline; gap: 5px; width: 100%;">
                                                            @if (usuarioTieneJuegoTiempoJugado > 0)
                                                            {
                                                                TimeSpan tiempoJugado = TimeSpan.FromMinutes((long)usuarioTieneJuegoTiempoJugado);

                                                                string horasJugadas = tiempoJugado.TotalHours.ToString("N1");

                                                                <label>@string.Format(Herramientas.Idiomas.BuscarTexto(idioma, "String32", "Game"), horasJugadas, JuegoDRM2.DevolverDRM(drm.Id))</label>
                                                            }

                                                            @if (usuarioTieneJuegoUltimaVezJugado > 0 && usuarioTieneJuegoUltimaVezJugado != 86400)
                                                            {
                                                                DateTimeOffset fecha = DateTimeOffset.FromUnixTimeSeconds(usuarioTieneJuegoUltimaVezJugado);

                                                                string ultimaVezJugado = Herramientas.Calculadora.DiferenciaTiempo(fecha.UtcDateTime, idioma);

                                                                <label style="font-size: 14px;">(@string.Format(Herramientas.Idiomas.BuscarTexto(idioma, "String33", "Game"), ultimaVezJugado))</label>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <label style="text-align: left; width: 100%;">@mensaje</label>
                                                    }

                                                    @{
                                                        string enlaceJugar = string.Empty;

                                                        if (drm.Id == JuegoDRM.Steam && juego.IdSteam > 0)
                                                        {
                                                            enlaceJugar = "steam://rungameid/" + juego.IdSteam.ToString();
                                                        }
                                                        else if (drm.Id == JuegoDRM.Amazon && string.IsNullOrEmpty(juego.IdAmazon) == false)
                                                        {
                                                            enlaceJugar = "amazon-games://play/" + juego.IdAmazon;
                                                        }
                                                        else if (drm.Id == JuegoDRM.Ubisoft && string.IsNullOrEmpty(juego.ExeUbisoft) == false)
                                                        {
                                                            enlaceJugar = "uplay://launch/" + juego.ExeUbisoft + "/0";
                                                        }
                                                        else if (drm.Id == JuegoDRM.EA && string.IsNullOrEmpty(juego.ExeEA) == false)
                                                        {
                                                            enlaceJugar = "origin://LaunchGame/" + juego.ExeEA;
                                                        }

                                                        if (string.IsNullOrEmpty(enlaceJugar) == false)
                                                        {
                                                            <a class="juego-boton-pequeño" href="@enlaceJugar" rel="nofollow" style="width: auto; min-width: 200px; text-align: center; backdrop-filter: brightness(60%); background-color: transparent; box-shadow: 0px 4px 8px 0px rgba(0, 0, 0, 0.28),0px 0px 2px 0px rgba(0, 0, 0, 0.24);">
                                                                @Herramientas.Idiomas.BuscarTexto(idioma, "String81", "Game")
                                                            </a>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        }
                                        else if (string.IsNullOrEmpty(usuarioTieneDeseadoMensaje) == false)
                                        {
                                            <div style="background-color: var(--fondoAlerta); padding: 20px; box-shadow: 0px 1px 2px 0px rgba(0, 0, 0, 0.5),0px 0px 1px 0px rgba(0, 0, 0, 0.5);">
                                                <div class="perfil-flexible-centrado" style="gap: 25px;">
                                                    <div style="display: flex; align-items: center; justify-content: center; width: 46px; height: 26px;">
                                                        <svg class="svg-boton" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 512">
                                                            <path d="M96 64c0-17.7-14.3-32-32-32S32 46.3 32 64l0 256c0 17.7 14.3 32 32 32s32-14.3 32-32L96 64zM64 480a40 40 0 1 0 0-80 40 40 0 1 0 0 80z" />
                                                        </svg>
                                                    </div>                                                    

                                                    <label style="text-align: left; width: 100%;">@usuarioTieneDeseadoMensaje</label>
                                                </div>
                                            </div>
                                        }
                                    </Authorized>
                                </AuthorizeView>

                                @if ((string.IsNullOrEmpty(mensajeMinimoOficialDRM) == false || string.IsNullOrEmpty(mensajeMinimoNoOficialDRM) == false) || BundlesComprobar(juego.Bundles, drm.Id) != null || GratisComprobar(juego.Gratis, drm.Id) != null || SuscripcionesComprobar(juego.Suscripciones, drm.Id) != null)
                                {
                                    <div class="caja-drm" style="text-align: left; padding: 20px; align-items: center; gap: 30px; background: rgba(0, 0, 0, .2); box-shadow: 0px 1px 2px 0px rgba(0, 0, 0, 0.5),0px 0px 1px 0px rgba(0, 0, 0, 0.5);">
                                        @if (drm.Id == JuegoDRM.DRMFree)
                                        {
                                            <div style="max-width: 45px; text-align: center;">DRM Free</div>
                                        }
                                        else
                                        {
                                            string imagenDRM = JuegoDRM2.SacarImagen(drm.Id);
                                            string imagenDRM1 = imagenDRM.Replace(".webp", "-sm.webp");
                                            string imagenDRM2 = imagenDRM.Replace(".webp", "-md.webp");

                                            <div style="min-width: 40px; max-width: 40px; aspect-ratio: 1/1; contain: layout;">
                                                <picture>
                                                    <source srcset="@imagenDRM1 1x, @imagenDRM2 2x" type="image/webp">
                                                    <img src="@imagenDRM" style="width: 40px; height: 40px;" alt="@drm.Nombre"/>
                                                </picture>
                                            </div>
                                        }
                                        
                                        <div style="display: flex; flex-direction: column; gap: 15px;">
