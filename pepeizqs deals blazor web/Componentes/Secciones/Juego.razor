                                nuevoDeseadoUsuario.ImportadoDesea = true;
                                usuarioTieneDesea2.Add(nuevoDeseadoUsuario);
                                usuarioDeseaDRM = true;
                            }
                        }

                        if (usuarioDeseaDRM == false)
                        {
                            bool deseadoWeb = Herramientas.Deseados.ComprobarSiEstaWeb(deseadosWebIndex, juego, drm.Id);

                            if (deseadoWeb == true)
                            {
                                JuegoTieneDesea nuevoDeseadoUsuario = new JuegoTieneDesea();
                                nuevoDeseadoUsuario.DRM = drm.Id;
                                nuevoDeseadoUsuario.Desea = true;
                                usuarioTieneDesea2.Add(nuevoDeseadoUsuario);
                            }
                        }
                    }
                }
            }
        }        

        return usuarioTieneDesea2;
    }

