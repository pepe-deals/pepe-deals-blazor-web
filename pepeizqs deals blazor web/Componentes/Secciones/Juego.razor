                    if (VerificarMostrarDRM(idioma, drm.Id, juego, drmsEnseñar) == true)
                    {
                        string mensajeMinimoOficialDRM = string.Empty;
                        string mensajeMinimoNoOficialDRM = string.Empty;

                        foreach (var drmEnseñar in drmsEnseñar)
                        {
                            if (drmEnseñar.DRM == drm.Id && drmEnseñar.TipoTienda == TiendaTipo.Oficial)
                            {
                                mensajeMinimoOficialDRM = drmEnseñar.Mensaje;
                            }

                            if (drmEnseñar.DRM == drm.Id && drmEnseñar.TipoTienda == TiendaTipo.NoOficial)
                            {
                                mensajeMinimoNoOficialDRM = drmEnseñar.Mensaje;
                            }
                        }

                        bool usuarioTieneJuego = false;
                        int usuarioTieneJuegoTiempoJugado = 0;
                        int usuarioTieneJuegoUltimaVezJugado = 0;

                        bool usuarioTieneDeseado = false;
                        bool usuarioTieneDeseadoImportado = false;
                        string usuarioTieneDeseadoMensaje = string.Empty;

                        if (usuarioTieneDesea?.Count > 0)
                        {
                            foreach (var tieneDesea in usuarioTieneDesea)
