@page "/game/{juegoId:int}/"
@page "/game/{juegoId:int}/{juegoNombre?}/"

@implements IAsyncDisposable

@using APIs.GOG
@using APIs.Steam
@using Bundles2
@using Gratis2
@using Juegos
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.JSInterop
@using pepeizqs_deals_blazor_web.Componentes.Interfaz
@using pepeizqs_deals_blazor_web.Componentes.Secciones.JuegoComponentes
@using pepeizqs_deals_web.Data
@using Suscripciones2
@using System.Net
@using Tiendas2

@inject IHttpContextAccessor Contexto
@inject IJSRuntime JavaScript
@inject NavigationManager Navegacion
@inject Servicios.Opciones ServicioOpciones

@if (juego != null)
{
    string descripcion = string.Empty; 
    
    if (juego.Caracteristicas?.Descripcion?.Length >= 150)
    {
        string descripcionUsar = juego.Caracteristicas.Descripcion;

		if (descripcionUsar.Length > 160)
		{
			int ultimoEspacio = descripcionUsar.LastIndexOf(' ', 156);
			descripcionUsar = ultimoEspacio != -1 ? descripcionUsar[..ultimoEspacio] + " ..." : descripcionUsar[..156] + " ...";
		}

        descripcion = descripcionUsar;
    }

    if (string.IsNullOrEmpty(descripcion) == true && string.IsNullOrEmpty(juego.DescripcionSEO) == false)
    {
        descripcion = juego.DescripcionSEO;
    }

    if (string.IsNullOrEmpty(descripcion) == true)
    {
        descripcion = Herramientas.Idiomas.BuscarTexto(idioma, "String121", "Game");
    }

    bool gamePass = false;

    if (SuscripcionesDisponibles(juego.Suscripciones).Count > 0)
	{
		foreach (var suscripcion2 in SuscripcionesDisponibles(juego.Suscripciones))
		{
			if (suscripcion2.Tipo == SuscripcionTipo.PCGamePass)
			{
				gamePass = true;
                break;
			}
		}
	}

    List<JuegoPrecio> preciosJson = new List<JuegoPrecio>();

    if (usuarioRegion == TiendaRegion.Europa)
    {
        preciosJson = Herramientas.Minimos.OrdenarPrecios(usuarioRegion, juego.PrecioActualesTiendas);
    }
    else if (usuarioRegion == TiendaRegion.EstadosUnidos)
    {
        preciosJson = Herramientas.Minimos.OrdenarPrecios(usuarioRegion, juego.PrecioActualesTiendasUS);
    }

    if (string.IsNullOrEmpty(juego.FreeToPlay) == false)
    {
        if (juego.FreeToPlay.ToLower() == "true")
        {
            preciosJson = new List<JuegoPrecio>();
            preciosJson.Add(new JuegoPrecio() { Precio = 0, PrecioCambiado = 0 });
        }
    }

    string fechaJson = string.Empty;

    if (juego.Caracteristicas?.FechaLanzamientoSteam.Year > 0001)
    {
        fechaJson = juego.Caracteristicas.FechaLanzamientoSteam.ToString("yyyy-MM-dd");
    }

    decimal estrellasJson = 1;
    string cantidadJson = "10";

    if (juego.Analisis != null)
    {
        if (string.IsNullOrEmpty(juego.Analisis.Porcentaje) == false && string.IsNullOrEmpty(juego.Analisis.Cantidad) == false)
        {
            estrellasJson = decimal.Parse(juego.Analisis.Porcentaje) / 20;

            if (estrellasJson < 1)
            {
                estrellasJson = 1;
            }

            cantidadJson = juego.Analisis.Cantidad.Replace(",", null);

            if (cantidadJson.Length == 1)
            {
                cantidadJson = "10";
            }
        }
    }

    string precioBajoJson = string.Empty;
    string precioAltoJson = string.Empty;

    if (preciosJson?.Count > 0 && string.IsNullOrEmpty(fechaJson) == false && estrellasJson > 0 && string.IsNullOrEmpty(cantidadJson) == false)
    {
        JuegoPrecio precioBajo = preciosJson.First();
        precioBajoJson = precioBajo.Precio.ToString();

        if (precioBajo.PrecioCambiado > 0)
        {
            precioBajoJson = precioBajo.PrecioCambiado.ToString();
        }

        JuegoPrecio precioAlto = preciosJson.Last();
        precioAltoJson = precioAlto.Precio.ToString();

        if (precioAlto.PrecioCambiado > 0)
        {
            precioAltoJson = precioAlto.PrecioCambiado.ToString();
        }
    }

    <Titulo tipo="@Titulo.Tipo.Juego" idioma="@idioma" dominio="@dominio" nombreJuego="@juego.Nombre" drmsEnseñarJuego="@drmsEnseñar" descripcionJuego="@descripcion"
            idJuego="@juego.Id" gamePassJuego="@gamePass" imagenJuego="@juego.Imagenes?.Header_460x215" categoriasJuego="@juego.Categorias"
            estrellasJsonJuego="@estrellasJson" cantidadJsonJuego="@cantidadJson" precioBajoJsonJuego="@precioBajoJson"
            precioAltoJsonJuego="@precioAltoJson" fechaJsonJuego="@fechaJson" preciosCantidadJsonJuego="@preciosJson?.Count"/>
}

@if (juego != null)
{
    if (usuarioAdmin == true)
    {
        <pepeizqs_deals_blazor_web.Componentes.Admin.Juego idioma="@idioma" juego="@juego"/>
    }

    <div class="cuerpo-ancho" style="margin-top: 40px; margin-bottom: 40px;">
        @if (juego.Imagenes != null)
        {
            if (juego.Tipo == JuegoTipo.Game)
            {
                bool mostrar = true;

                if (string.IsNullOrEmpty(usuarioId) == true)
                {
                    if (string.IsNullOrEmpty(juego.MayorEdad) == false)
                    {
                        if (juego.MayorEdad.ToLower() == "true")
                        {
                            mostrar = false;
                        }
                    }                    
                }
                            
                if (Herramientas.Bots.UserAgentEsBot(userAgent) == false && mostrar == true)
                {
                    <img class="juego-fondo" src="@Herramientas.Ficheros.Imagenes.ServidorExterno(juego.Imagenes.Library_1920x620, 1536, 496)" alt="@juego.Nombre" fetchpriority="high" />
                }
            }
        }

        <div style="position: relative; display: flex; flex-direction: column; gap: 50px;">
            @{
                string fondoCabecera = "background: linear-gradient(180deg, color-mix(in srgb, var(--fondoSubsubcabecera), transparent 15%), 0%, color-mix(in srgb, var(--fondoSubcabecera), transparent 5%) 211.07%);";
                string fondoBoton = "background-color: var(--fondoBotonPequeño);";
            }

            <div class="juego-cabecera caja-juego-contenido" style="@fondoCabecera position: sticky; top: 70px; z-index: 3;">
                <div class="perfil-flexible-centrado">
                    @if (string.IsNullOrEmpty(juego.Imagenes?.Header_460x215) == false)
                    {
                        bool difuminar = false;

                        if (string.IsNullOrEmpty(usuarioId) == true)
                        {
                            if (string.IsNullOrEmpty(juego.MayorEdad) == false)
                            {
                                if (juego.MayorEdad.ToLower() == "true")
                                {
                                    difuminar = true;
                                }
                            }
                        }
                            
                        if (difuminar == false)
                        {
                            <div class="juego-flexible-izquierda">
                                <img src="@Herramientas.Ficheros.Imagenes.ServidorExterno(juego.Imagenes.Header_460x215, 250, 116)" class="juego-imagen" alt="@juego.Nombre" fetchpriority="high" loading="eager" style="contain: layout; aspect-ratio: 460 / 215; object-fit: cover; display: block;"/>
                            </div>
                        }
                        else
                        {
                            <div class="juego-flexible-izquierda" style="overflow: hidden;">
                                <img src="@Herramientas.Ficheros.Imagenes.ServidorExterno(juego.Imagenes.Header_460x215, 250, 116)" class="juego-imagen" style="filter: blur(10px); contain: layout; aspect-ratio: 460 / 215; object-fit: cover; display: block;" alt="@juego.Nombre" fetchpriority="high" loading="eager" />
                            </div>
                        }
                    }

                    <div class="juego-titulo">
                        <h1 style="font-size: 20px; margin: 0px;">@juego.Nombre</h1>

                        <div style="display: flex; align-items: center; gap: 15px;">
                            @{
                                bool mostrarDRMs = false;

                                foreach (DRM drm in JuegoDRM2.GenerarListado())
                                {
                                    if (VerificarMostrarDRMOferta(drmsEnseñar, drm.Id) == true && drm.Id != JuegoDRM.NoEspecificado)
                                    {
                                        mostrarDRMs = true;
                                        break;
                                    }
                                }

                                if (mostrarDRMs == true)
                                {
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        @foreach (DRM drm in JuegoDRM2.GenerarListado())
                                        {
                                            if (drm.Id != JuegoDRM.NoEspecificado)
                                            {
                                                if (VerificarMostrarDRM(idioma, drm.Id, juego, drmsEnseñar) == true)
                                                {
                                                    string fondoBotonDRM = fondoBoton;

                                                    if (string.IsNullOrEmpty(usuarioId) == false)
                                                    {
                                                        if (usuarioTieneDesea?.Count > 0)
                                                        {
                                                            bool tieneDRM = usuarioTieneDesea.Any(d => drm.Id == d.DRM && d.Tiene == true);

                                                            if (tieneDRM == true)
                                                            {
                                                                fondoBotonDRM = "background-color: var(--fondoBien);";
                                                            }
                                                            else
                                                            {
                                                                bool deseaDRM = usuarioTieneDesea.Any(d => drm.Id == d.DRM && d.Desea == true);

                                                                if (deseaDRM == true)
                                                                {
                                                                    fondoBotonDRM = "background-color: var(--fondoAlerta);";                                                                    
                                                                }
                                                            }
                                                        }                                                         
                                                    }

                                                    if (drm.Id == JuegoDRM.DRMFree)
                                                    {
                                                        <button @onclick="@(e => MoverScrollJs(e, drm.Id.ToString()))" class="boton-pequeño" style="@fondoBotonDRM width: 40px; height: 40px; text-align: center; padding: 7px;"><div style="font-weight: bold; font-size: 9px; line-height: 14px;">DRM Free</div></button>
                                                    }
                                                    else
                                                    {
                                                        string imagenDRM = JuegoDRM2.SacarImagen(drm.Id);
                                                        string imagenDRM1 = imagenDRM.Replace(".webp", "-sm.webp");
                                                        string imagenDRM2 = imagenDRM.Replace(".webp", "-md.webp");

                                                        <button @onclick="@(e => MoverScrollJs(e, drm.Id.ToString()))" class="boton-pequeño" style="@fondoBotonDRM width: 40px; height: 40px; padding: 9px;">
                                                            <picture style="display: flex;">
                                                                <source srcset="@imagenDRM1 1x, @imagenDRM2 2x" type="image/webp">
                                                                <img src="@imagenDRM" alt="@drm.Nombre" style="max-width: 100%; max-height: 100%; display: block;"/>
                                                            </picture>
                                                        </button>
                                                    }
                                                }
                                            }
                                        }
                                    </div>
                                }
                            }

                            @if (juego.Bundles?.Count > 0)
                            {
                                <button @onclick="@(e => MoverScrollJs(e, "bundles"))" class="boton" style="padding: 0px; background-color: transparent; color: var(--colorEnlace); font-size: 16px; width: fit-content;">@Herramientas.Idiomas.BuscarTexto(idioma, "Bundles", "Header")</button>
                            }

                            @if (juego.Gratis?.Count > 0)
                            {
                                <button @onclick="@(e => MoverScrollJs(e, "gratis"))" class="boton" style="padding: 0px; background-color: transparent; color: var(--colorEnlace); font-size: 16px; width: fit-content;">@Herramientas.Idiomas.BuscarTexto(idioma, "Free", "Header")</button>
                            }

                            @if (juego.Suscripciones?.Count > 0)
                            {
                                <button @onclick="@(e => MoverScrollJs(e, "suscripciones"))" class="boton" style="padding: 0px; background-color: transparent; color: var(--colorEnlace); font-size: 16px; width: fit-content;">@Herramientas.Idiomas.BuscarTexto(idioma, "Subscriptions", "Header")</button>
                            }

                            @if (dlcs?.Count > 0)
                            {
                                <button @onclick="@(e => MoverScrollJs(e, "dlcs"))" class="boton" style="padding: 8px 10px; background: color-mix(in srgb, var(--fondoBotonPequeño), var(--fondoDlc) 70%); color: var(--colorTextoDlc); font-size: 16px; width: fit-content; box-shadow: 0px 2px 4px 0px rgba(0, 0, 0, 0.28),0px 0px 1px 0px rgba(0, 0, 0, 0.24);">
                                    @Herramientas.Idiomas.BuscarTexto(idioma, "String34", "Game") (@dlcs.Count.ToString())
                                </button>
                            }

                            @if (juego.Tipo == JuegoTipo.Game)
                            {
                                <div style="margin-left: auto; display: flex; align-items: center; gap: 10px;">
                                    @if (juego.Caracteristicas?.AccesoAnticipado == true)
                                    {
                                        <div class="tooltip-juego" id="trigger-early"
                                             @onmouseenter="@(() => ActivarTooltip("trigger-early", "tooltip-early"))"
                                             @onmouseleave="@(() => DesactivarTooltip("trigger-early"))">
