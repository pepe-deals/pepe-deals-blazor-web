    [PersistentState] public bool cargadoBundlesActuales { get; set; }

    private async Task CargarBundlesActuales()
    {
        cargadoBundlesActuales = false;

        if (juego.BundlesActuales?.Count > 0)
        {
            foreach (var bundleActual in juego.BundlesActuales)
            {
                bool añadir = true;

