                                                @Herramientas.Idiomas.BuscarTexto(idioma, "String97", "Game")
                                            </div>

                                            <div id="tooltip-early" class="tooltip-relleno">
                                                <div style="margin: 8px; max-width: 300px; font-size: 14px;">
                                                    @Herramientas.Idiomas.BuscarTexto(idioma, "String112", "Game")
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    @if (juego.Categorias?.Count > 0)
                                    {
                                        foreach (var categoria in juego.Categorias)
                                        {
                                            if (categoria == "54")
                                            {
                                                <div class="tooltip-juego" id="trigger-vr"
                                                     @onmouseenter="@(() => ActivarTooltip("trigger-vr", "tooltip-vr"))"
                                                     @onmouseleave="@(() => DesactivarTooltip("trigger-vr"))">
                                                    <div style="font-size: 14px; padding: 5px 10px; background-color: rgba(0,0,0,.15); border: 1px solid rgba(0,0,0,.3);">
                                                        @Herramientas.Idiomas.BuscarTexto(idioma, "String99", "Game")
                                                    </div>

                                                    <div id="tooltip-vr" class="tooltip-relleno">
                                                        <div style="margin: 8px; max-width: 300px; font-size: 14px;">
                                                            @Herramientas.Idiomas.BuscarTexto(idioma, "String111", "Game")
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    }

                                    @if (string.IsNullOrEmpty(juego.FreeToPlay) == false)
                                    {
                                        if (juego.FreeToPlay.ToLower() == "true")
                                        {
                                            <div class="tooltip-juego" id="trigger-f2p"
                                                 @onmouseenter="@(() => ActivarTooltip("trigger-f2p", "tooltip-f2p"))"
                                                 @onmouseleave="@(() => DesactivarTooltip("trigger-f2p"))">
                                                <div style="font-size: 14px; padding: 5px 10px; background-color: rgba(0,0,0,.15); border: 1px solid rgba(0,0,0,.3);">
                                                    @Herramientas.Idiomas.BuscarTexto(idioma, "String103", "Game")
                                                </div>  

                                                <div id="tooltip-f2p" class="tooltip-relleno">
                                                    <div style="margin: 8px; max-width: 300px; font-size: 14px;">
                                                        @Herramientas.Idiomas.BuscarTexto(idioma, "String110", "Game")
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }

                                    @if (string.IsNullOrEmpty(juego.MayorEdad) == false)
                                    {
                                        if (juego.MayorEdad.ToLower() == "true")
                                        {
                                            <div class="tooltip-juego" id="trigger-sex"
                                                 @onmouseenter="@(() => ActivarTooltip("trigger-sex", "tooltip-sex"))"
                                                 @onmouseleave="@(() => DesactivarTooltip("trigger-sex"))">
                                                <div style="font-size: 14px; padding: 5px 10px; background-color: var(--fondoAlerta); border: 1px solid rgba(0,0,0,.3);">
                                                    @Herramientas.Idiomas.BuscarTexto(idioma, "String105", "Game")
                                                </div>   

                                                <div id="tooltip-sex" class="tooltip-relleno">
                                                    <div style="margin: 8px; max-width: 300px; font-size: 14px;">
                                                        @Herramientas.Idiomas.BuscarTexto(idioma, "String109", "Game")
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }

                                    @if (juego.InteligenciaArtificial == true)
                                    {
                                        <div class="tooltip-juego" id="trigger-ai"
                                             @onmouseenter="@(() => ActivarTooltip("trigger-ai", "tooltip-ai"))"
                                             @onmouseleave="@(() => DesactivarTooltip("trigger-ai"))">
                                            <div style="font-size: 14px; padding: 5px 10px; background-color: rgba(0,0,0,.15); border: 1px solid rgba(0,0,0,.3);">
                                                @Herramientas.Idiomas.BuscarTexto(idioma, "String106", "Game")
                                            </div>

                                            <div id="tooltip-ai" class="tooltip-relleno">
                                                <div style="margin: 8px; max-width: 300px; font-size: 14px;">
                                                    @Herramientas.Idiomas.BuscarTexto(idioma, "String108", "Game")
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            @if (juego.Tipo == JuegoTipo.DLC)
                            {
                                @if (string.IsNullOrEmpty(juego.MayorEdad) == false)
                                {
                                    if (juego.MayorEdad.ToLower() == "true")
                                    {
                                        <div style="font-size: 14px; padding: 5px 10px; background-color: var(--fondoAlerta); border: 1px solid rgba(0,0,0,.3);">
                                            @Herramientas.Idiomas.BuscarTexto(idioma, "String105", "Game")
                                        </div>   
                                    }
                                }
                            }
                        </div>
                    </div>

                    @if (juego.Tipo == JuegoTipo.DLC || juego.Tipo == JuegoTipo.Music)
                    {
                        if (string.IsNullOrEmpty(juego.Maestro) == false)
                        {
                            if (juego.Maestro != "no")
                            {
                                Juegos.Juego? juegoMaestro = juegosMaestroCache.TryGetValue(juego.Maestro, out Juegos.Juego? jm) ? jm : null;

                                if (juegoMaestro != null)
                                {
                                    string nombreMaestro = juegoMaestro.Nombre;
                                    string enlaceMaestro = "/game/" + juegoMaestro.Id.ToString() + "/" + Herramientas.EnlaceAdaptador.Nombre(juegoMaestro.Nombre) + "/";

                                    string fondoBotonDlc = string.Empty;

                                    @if (juego.Tipo == JuegoTipo.DLC)
                                    {
                                        fondoBotonDlc = "background-color: var(--fondoDlc);";
                                    }
                                    else if (juego.Tipo == JuegoTipo.Music)
                                    {
                                        fondoBotonDlc = "background-color: var(--fondoBandaSonora);";                                                    
                                    }

                                    <div style="margin-left: auto; margin-right: 5px;">
                                        <div class="tooltip-juego" id="trigger-header-dlc"
                                             @onmouseenter="@(() => ActivarTooltip("trigger-header-dlc", "tooltip-header-dlc"))"
                                             @onmouseleave="@(() => DesactivarTooltip("trigger-header-dlc"))">
