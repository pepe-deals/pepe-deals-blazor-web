                                                        else if (juego.Tipo == JuegoTipo.Music)
                                                        {
                                                            <svg style="fill: color-mix(in srgb, var(--fondoBandaSonora) 50%, var(--colorTexto));" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                                                                <path d="M532 71C539.6 77.1 544 86.3 544 96L544 400C544 444.2 501 480 448 480C395 480 352 444.2 352 400C352 355.8 395 320 448 320C459.2 320 470 321.6 480 324.6L480 207.9L256 257.7L256 464C256 508.2 213 544 160 544C107 544 64 508.2 64 464C64 419.8 107 384 160 384C171.2 384 182 385.6 192 388.6L192 160C192 145 202.4 132 217.1 128.8L505.1 64.8C514.6 62.7 524.5 65 532.1 71.1z"/>
                                                            </svg>                                                      
                                                        }
                                                    </div>

                                                    <div style="font-size: 14px; text-align: center;">
                                                        @if (juego.Tipo == JuegoTipo.DLC)
                                                        {
                                                            @Herramientas.Idiomas.BuscarTexto(idioma, "String84", "Game")
                                                        }
                                                        else if (juego.Tipo == JuegoTipo.Music)
                                                        {
                                                            @Herramientas.Idiomas.BuscarTexto(idioma, "String93", "Game")
                                                        }
                                                    </div>
                                                </div>
                                            </a>

                                            <div id="tooltip-header-dlc" class="tooltip-relleno">
                                                <div style="margin: 8px; max-width: 300px; font-size: 14px;">
                                                    @if (juego.Tipo == JuegoTipo.DLC)
                                                    {
                                                        @string.Format(Herramientas.Idiomas.BuscarTexto(idioma, "String116", "Game"), nombreMaestro)
                                                    }
                                                    else if (juego.Tipo == JuegoTipo.Music)
                                                    {
                                                        @string.Format(Herramientas.Idiomas.BuscarTexto(idioma, "String117", "Game"), nombreMaestro)
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        }
                    }

                    @{
                        bool añadirDivAnalisisJugadores = false;

                        if (juego.Analisis != null)
                        {
                            if (string.IsNullOrEmpty(juego.Analisis.Cantidad) == false && string.IsNullOrEmpty(juego.Analisis.Porcentaje) == false)
                            {
                                añadirDivAnalisisJugadores = true;
                            }
                        }

                        if (juego.Tipo == JuegoTipo.Game && juego.IdSteam > 0)
                        {
                            if (juego.Caracteristicas?.FechaLanzamientoSteam != null)
                            {
                                if (DateTime.Now > juego.Caracteristicas?.FechaLanzamientoSteam)
                                {
                                    añadirDivAnalisisJugadores = true;
                                }
                            }
                        }

                        if (añadirDivAnalisisJugadores == true)
                        {
                            <div style="padding: 0px 20px 0px 10px; display: flex; flex-direction: row; align-items: stretch; gap: 15px;">
                                @if (string.IsNullOrEmpty(juego.Analisis?.Cantidad) == false && string.IsNullOrEmpty(juego.Analisis?.Porcentaje) == false)
                                {
                                    if (juego.Analisis.Cantidad.Length > 1)
                                    {
                                        <div class="tooltip-juego" id="trigger-reviews"
