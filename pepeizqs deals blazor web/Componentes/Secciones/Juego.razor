    public static bool VerificarMostrarDRMOferta(List<DRMEnseñar> drmsEnseñar2, JuegoDRM drm)
    {
        if (drmsEnseñar2?.Count > 0)
        {
            foreach (var drm2 in drmsEnseñar2)
            {
                if (drm2.DRM == drm && string.IsNullOrEmpty(drm2.Mensaje) == false)
                {
                    return true;
                }
            }            
        }

        return false;        
    }

