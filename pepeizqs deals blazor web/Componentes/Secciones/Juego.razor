    [PersistentState] public Herramientas.UsuarioDeseadosWebIndex deseadosWebIndex { get; set; }

    private bool usuarioPatreon = false;
    private bool usuarioAdmin = false;
    private TiendaRegion usuarioRegion = TiendaRegion.Europa;
    private bool usuarioTiendasNoOficial = false;

    [PersistentState] public Usuario opciones { get; set; }

    [PersistentState] public List<JuegoTieneDesea> usuarioTieneDesea { get; set; }

    [Parameter]
    public int juegoId { get; set; }

    [Parameter]
    public string juegoNombre { get; set; }

    private string idiomaJuego = null;
    [PersistentState] public Juegos.Juego juego { get; set; }
    [PersistentState] public List<Juegos.Juego> dlcs { get; set; }
    [PersistentState] public List<Juegos.Juego> bandasSonoras { get; set; }
    [PersistentState] public List<Juegos.JuegoDRM> drmsGeforceNOW { get; set; }
    [PersistentState] public List<Juegos.JuegoDRM> drmsBoosteroid { get; set; }

    [PersistentState] public List<DRMEnseñar> drmsEnseñar { get; set; }

    private bool cargarComponentes = false;

    private bool estaExcluido = false;

    protected override async Task OnInitializedAsync()
    {
        Herramientas.ContextoUsuarioDatos datos = Herramientas.ContextoUsuario.Leer(Contexto);
        idioma = datos.Idioma;
        usuarioId = datos.UsuarioId;
        userAgent = datos.UserAgent;
        dominio = datos.Dominio;
        usuarioRegion = datos.Region;
        usuarioTiendasNoOficial = datos.NoOficial;

        idiomaJuego = idioma;

        if (string.IsNullOrEmpty(usuarioId) == false)
        {
            Task<string> tareaIdioma = BaseDatos.Usuarios.Buscar.IdiomaSobreescribir(usuarioId);
            Task<Herramientas.UsuarioListadosJuegos> tareaJuegos = (juegosUsuario != null) ? Task.FromResult(juegosUsuario) : Herramientas.UsuarioJuegos.Cargar(usuarioId);
            Task<Usuario> tareaDeseados = (deseadosUsuario != null) ? Task.FromResult(deseadosUsuario) : BaseDatos.Usuarios.Buscar.DeseadosTiene(usuarioId);
            Task<DateTime?> tareaPatreon = BaseDatos.Usuarios.Buscar.FechaPatreon(usuarioId);
            Task<bool> tareaAdmin = BaseDatos.Usuarios.Buscar.RolDios(usuarioId);
            Task<int> tareaRegion = BaseDatos.Usuarios.Buscar.OpcionInt(usuarioId, "Currency");
            Task<bool> tareaNoOficial = BaseDatos.Usuarios.Buscar.OpcionBool(usuarioId, "NoOfficial");
            Task<string> tareaIdiomaJuego = BaseDatos.Usuarios.Buscar.IdiomaJuegos(usuarioId);
            Task<Usuario> tareaOpciones = (opciones != null) ? Task.FromResult(opciones) : BaseDatos.Usuarios.Buscar.OpcionesJuego(usuarioId);

            await Task.WhenAll(tareaIdioma, tareaJuegos, tareaDeseados, tareaPatreon, tareaAdmin, tareaRegion, tareaNoOficial, tareaIdiomaJuego, tareaOpciones);

            idioma = tareaIdioma.Result;
            juegosUsuario = tareaJuegos.Result;
            deseadosUsuario = tareaDeseados.Result;
            usuarioPatreon = Herramientas.Patreon.VerificarActivo(tareaPatreon.Result);
            usuarioAdmin = tareaAdmin.Result;
            usuarioRegion = (TiendaRegion)tareaRegion.Result;
            usuarioTiendasNoOficial = tareaNoOficial.Result;

            string idiomaJuegoTemp = tareaIdiomaJuego.Result;
            if (string.IsNullOrEmpty(idiomaJuegoTemp) == false)
            {
                idiomaJuego = idiomaJuegoTemp;
            }

            if (juegosUsuarioIndex == null)
            {
                juegosUsuarioIndex = Herramientas.UsuarioJuegos.CrearIndex(juegosUsuario);                
            }

            if (deseadosImportadosIndex == null)
            {
                deseadosImportadosIndex = Herramientas.Deseados.CrearImportadosIndex(deseadosUsuario);
            }

            if (deseadosWebIndex == null)
            {
                deseadosWebIndex = Herramientas.Deseados.CrearWebIndex(deseadosUsuario);
            }

            opciones = tareaOpciones.Result;

            if (opciones != null)
            {
                if (opciones.GameOption1.HasValue == true)
                {
                    enseñarOpcionesSteamDeck = opciones.GameOption1.Value;
                }

                if (opciones.GameOption2.HasValue == true)
                {
                    enseñarOpcionesGeforceNow = opciones.GameOption2.Value;
                }

                if (opciones.GameOption3.HasValue == true)
                {
                    enseñarOpcionesBoosteroid = opciones.GameOption3.Value;
                }

                if (opciones.GameOption4.HasValue == true)
                {
                    enseñarOpcionesSteamLogros = opciones.GameOption4.Value;
                }

                if (opciones.GameOption5.HasValue == true)
                {
                    enseñarOpcionesSteamGuardadoNube = opciones.GameOption5.Value;
                }

                if (opciones.GameOption6.HasValue == true)
                {
                    enseñarOpcionesSteamCromos = opciones.GameOption6.Value;
                }

                bool enseñarIdiomas = true;

                if (opciones.GameOption7.HasValue == true)
                {
                    enseñarIdiomas = opciones.GameOption7.Value;
                }

                if (enseñarIdiomas == true)
                {
                    if (string.IsNullOrEmpty(opciones.LanguageGames) == true)
                    {
                        opcionesIdiomaJuegos = Herramientas.Idiomas.BuscarTexto(idioma, "String4", "AccountLanguage");
                        opcionesBanderaJuegos = null;
                    }
                    else
                    {
                        opcionesIdiomaJuegos = Herramientas.Idiomas.BuscarTexto(idioma, Herramientas.Idiomas.SacarIdiomaUsuarioWeb(opciones.LanguageGames), "Languages");
                        opcionesBanderaJuegos = "/imagenes/banderas/" + Herramientas.Idiomas.EncontrarIdiomaImagen(opciones.LanguageGames) + ".svg";
                    }
                }

                if (opciones.GameOption8.HasValue == true)
                {
                    enseñarOpcionesSteamDemo = opciones.GameOption8.Value;
                }

                if (opciones.GameOption9.HasValue == true)
                {
                    enseñarOpcionesGogLogros = opciones.GameOption9.Value;
                }

                if (opciones.GameOption10.HasValue == true)
                {
                    enseñarOpcionesGogGuardadoNube = opciones.GameOption10.Value;
                }

                if (opciones.GameOption11.HasValue == true)
                {
                    enseñarOpcionesGogPreservacion = opciones.GameOption11.Value;
                }

                if (opciones.GameOption12.HasValue == true)
                {
                    enseñarOpcionesSteamRV = opciones.GameOption12.Value;
                }

                if (opciones.GameOption13.HasValue == true)
                {
                    enseñarOpcionesGraficoDuplicados = opciones.GameOption13.Value;
                }

                if (opciones.GameOption14.HasValue == true)
                {
                    enseñarOpcionesSteamMachine = opciones.GameOption14.Value;
                }

                if (opciones.GameOption15.HasValue == true)
                {
                    enseñarOpcionesSteamFrame = opciones.GameOption15.Value;
                }

                if (opciones.GameOption16.HasValue == true)
                {
                    enseñarOpcionesSteamOS = opciones.GameOption16.Value;
                }
            }

            ServicioOpciones.OnMostrarOpcionesChanged += StateHasChanged;
        }

        juego ??= await BaseDatos.Juegos.Buscar.UnJuego(juegoId);

        if (juego != null)
        {
            Task tareaBundlesActuales = (cargadoBundlesActuales == true) ? Task.CompletedTask : CargarBundlesActuales();
            Task tareaBundlesPasados = (cargadoBundlesPasados == true) ? Task.CompletedTask : CargarBundlesPasados();
            Task tareaDRMsMinimosOficiales = (cargadoDRMsMinimosOficiales == true) ? Task.CompletedTask : CargarDRMsMinimosOficiales();
            Task tareaDRMsMinimosNoOficiales = (cargadoDRMsMinimosNoOficiales == true) ? Task.CompletedTask : CargarDRMsMinimosNoOficiales();
            Task tareaSuscripciones = (cargadoSuscripciones == true) ? Task.CompletedTask : CargarSuscripciones();
            Task tareaStreaming = (cargadoStreaming == true) ? Task.CompletedTask : CargarStreaming();

            await Task.WhenAll(tareaBundlesActuales, tareaBundlesPasados, tareaDRMsMinimosOficiales, usuarioTiendasNoOficial == true ? tareaDRMsMinimosNoOficiales : Task.CompletedTask, tareaSuscripciones, tareaStreaming);

            if (string.IsNullOrEmpty(usuarioId) == false && Herramientas.Bots.UserAgentEsBot(userAgent) == false)
            {
                usuarioTieneDesea ??= await GenerarTieneDesea();

                estaExcluido = Herramientas.UsuarioJuegos.ComprobarSiEstaExcluido(juegosUsuarioIndex?.Excluidos, juego.Id);
            }
        }
        else
        {
            Navegacion.NavigateTo("/", true);
        }
