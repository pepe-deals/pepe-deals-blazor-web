    private bool HistoricoComprobar(TiendaRegion region, JuegoDRM drm)
    {
        bool tiene = false;

        if (region == TiendaRegion.Europa && juego.Historicos?.Count > 0)
        {
            foreach (var historico in juego.Historicos)
            {
                if (historico.DRM == drm)
                {
                    tiene = true;
                    break;
                }
            }
        }
        else if (region == TiendaRegion.EstadosUnidos && juego.HistoricosUS?.Count > 0)
        {
            foreach (var historico in juego.HistoricosUS)
            {
                if (historico.DRM == drm)
                {
                    tiene = true;
                    break;
                }
            }
        }

        return tiene;
    }

