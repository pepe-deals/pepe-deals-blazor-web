    private Dictionary<string, string> bundlesPreparados = new();
    private Dictionary<string, string> gratisPreparados = new();
    private Dictionary<string, string> suscripcionesPreparados = new();

    private Dictionary<string, Juegos.Juego> juegosMaestroCache = new();
    private Dictionary<int, Bundles2.Bundle> bundlesCache1 = new();
    private Bundles2.Bundle bundleSeleccionadoCache;
    private Dictionary<int, Bundles2.Bundle> bundlesCache2 = new();

    protected override async Task OnParametersSetAsync()
    {
        bundlesPreparados.Clear();
        gratisPreparados.Clear();
        suscripcionesPreparados.Clear();

        #region Maestro

        juegosMaestroCache.Clear();

        if (juego != null && (juego.Tipo == JuegoTipo.DLC || juego.Tipo == JuegoTipo.Music) && string.IsNullOrEmpty(juego.Maestro) == false &&
            juego.Maestro != "no")
        {
            var maestro = await BaseDatos.Juegos.Buscar.UnJuego(juego.Maestro);
            juegosMaestroCache[juego.Maestro] = maestro;
        }

        #endregion

        #region Bundles Actual

        bundlesCache1?.Clear();

        if (juego?.Bundles?.Count > 0)
        {
            List<int> ids = BundlesDisponibles(juego.Bundles)?.Where(b => b.BundleId > 0).Select(b => b.BundleId).Distinct().ToList();

            if (ids?.Count > 0)
            {
                foreach (var id in ids)
                {
                    var bundle = await BaseDatos.Bundles.Buscar.UnBundle(id);
                    bundlesCache1[id] = bundle;
                }    
            }
        }

        #endregion

        #region Bundles Antiguos

        bundlesCache2?.Clear();

        if (juego?.Bundles?.Count > 0)
        {
            foreach (var bundle2 in BundlesAntiguos(juego.Bundles))
            {
                if (bundle2.BundleId > 0 && !bundlesCache2.ContainsKey(bundle2.BundleId))
                {
                    var bundle = await BaseDatos.Bundles.Buscar.UnBundle(bundle2.BundleId);

                    if (bundle != null)
                    {
                        bundlesCache2[bundle2.BundleId] = bundle;
                    }
                }
            }
        }

        #endregion

        #region Bundles Cargar, DRMs Cuantos Tienen Desean

        foreach (DRM drm in JuegoDRM2.GenerarListado())
        {
            if (drm.Id != JuegoDRM.NoEspecificado)
            {
                if (VerificarMostrarDRM(idioma, drm.Id, juego, drmsEnseñar) == true)
                {
                    if (BundlesComprobar(juego.Bundles, drm.Id) != null)
                    {
                        bundlesPreparados[drm.Id.ToString()] = await BundlesPreparar(drm.Id, idioma);
                    }
                }
            }
        }

        #endregion
    }

    private IJSObjectReference moduloJs;

    protected override async Task OnAfterRenderAsync(bool primerRender)
    {
        if (primerRender == true)
        {
            moduloJs = await JavaScript.InvokeAsync<IJSObjectReference>("import", "/componentes/secciones/Juego.razor.js");

            if (juego != null && Herramientas.Bots.UserAgentEsBot(userAgent) == false)
            {	
                string nombreParaEnlace = Herramientas.EnlaceAdaptador.Nombre(juego.Nombre);

                if (moduloJs != null && string.IsNullOrEmpty(nombreParaEnlace) == false && nombreParaEnlace.Length > 0)
                {
                    if (string.IsNullOrEmpty(juegoNombre) == true || juegoNombre.Equals(nombreParaEnlace, StringComparison.OrdinalIgnoreCase) == false)
                    {
                        await moduloJs.InvokeVoidAsync("cambiarEnlace", $"/game/{juego.Id}/{nombreParaEnlace}/");
                    }
                }
            }

            if (juego != null)
            {
                Task<List<Juegos.Juego>> dlcsTarea = global::BaseDatos.Juegos.Buscar.DLCs(juego.Id.ToString(), JuegoTipo.DLC);
                Task<List<Juegos.Juego>> bandasSonorasTarea = global::BaseDatos.Juegos.Buscar.DLCs(juego.Id.ToString(), JuegoTipo.Music);

                await Task.WhenAll(dlcsTarea, bandasSonorasTarea);

                dlcs ??= dlcsTarea.Result;
                bandasSonoras ??= bandasSonorasTarea.Result;

                if (juego.IdSteam > 0)
                {
                    #region API

                    bool actualizarDatosAPI = false;
                    TimeSpan tiempoComprobar = TimeSpan.FromDays(30);

                    if (juego.Caracteristicas?.FechaLanzamientoSteam != null)
                    {
                        if (DateTime.Now.Subtract(juego.Caracteristicas.FechaLanzamientoSteam).TotalDays < 1)
                        {
                            tiempoComprobar = TimeSpan.FromHours(6);
                        }
                        else if (DateTime.Now.Subtract(juego.Caracteristicas.FechaLanzamientoSteam).TotalDays < 3)
                        {
                            tiempoComprobar = TimeSpan.FromHours(12);
                        }
                        else if (DateTime.Now.Subtract(juego.Caracteristicas.FechaLanzamientoSteam).TotalDays < 7)
                        {
                            tiempoComprobar = TimeSpan.FromDays(1);
                        }
                        else if (DateTime.Now.Subtract(juego.Caracteristicas.FechaLanzamientoSteam).TotalDays < 14)
                        {
                            tiempoComprobar = TimeSpan.FromDays(3);
                        }
                        else if (DateTime.Now.Subtract(juego.Caracteristicas.FechaLanzamientoSteam).TotalDays < 30)
                        {
                            tiempoComprobar = TimeSpan.FromDays(5);
                        }
                    }

                    if (juego.FechaSteamAPIComprobacion.Add(tiempoComprobar) < DateTime.Now)
                    {
                        actualizarDatosAPI = true;
                    }

                    if (juego.Categorias == null)
                    {
                        actualizarDatosAPI = true;

                        if (juego.Tipo == JuegoTipo.Music)
                        {
                            actualizarDatosAPI = false;
                        }
                    }

                    if (juego.Media?.Capturas2 == null)
                    {
                        actualizarDatosAPI = true;
                    }

                    if (actualizarDatosAPI == true)
                    {
                        await BaseDatos.JuegosActualizar.Insertar.Ejecutar(juego.Id, juego.IdSteam, "SteamAPI");
                    }

                    #endregion
                }

                Task steamComprobarTarea = ComprobareYActualizarSteam();
                Task gogComprobarTarea = ComprobareYActualizarGOG();
                Task epicComprobarTarea = ComprobareYActualizarEpic();
                Task xboxComprobarTarea = ComprobareYActualizarXbox();
                Task steamCmdComprobarTarea = ComprobareYActualizarSteamCMD();

                await Task.WhenAll(steamComprobarTarea, gogComprobarTarea, epicComprobarTarea, xboxComprobarTarea, steamCmdComprobarTarea);
            }

            await base.OnAfterRenderAsync(primerRender);

            cargarComponentes = true;

            await InvokeAsync(StateHasChanged);
        }
    }

