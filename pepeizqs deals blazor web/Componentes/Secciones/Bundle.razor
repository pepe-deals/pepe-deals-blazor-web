@page "/bundle/{bundleId:int}/{bundleNombre?}/"

@implements IAsyncDisposable

@using Juegos
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Microsoft.VisualBasic
@using Tiendas2
@using pepeizqs_deals_blazor_web.Componentes.Interfaz
@using pepeizqs_deals_web.Data

@inject IJSRuntime JavaScript
@inject Servicios.DiseñoBundle ServicioDiseñoBundle

@if (bundle != null)
{
	if (tipo == Tipo.Bundle)
	{
		string titulo = bundle.Nombre + " • " + bundle.Tienda;
		string descripcion = string.Empty;

		if (string.IsNullOrEmpty(bundle.DescripcionSEO) == false)
		{
			descripcion = bundle.DescripcionSEO;
		}

		if (string.IsNullOrEmpty(descripcion) == true || descripcion.Length < 150)
		{
			descripcion = Herramientas.Idiomas.BuscarTexto(idioma, "Subtitle", "Bundle");
		}

		string enlace = "https://" + dominio + "/bundle/" + bundle.Id.ToString() + "/" + Herramientas.EnlaceAdaptador.Nombre(bundle.Nombre) + "/";
		string imagen = string.Empty;

		if (string.IsNullOrEmpty(bundle.ImagenNoticia) == false)
		{
			if (bundle.ImagenNoticia.Contains("https://") == true)
			{
				imagen = bundle.ImagenNoticia;
			}
		}

		string[] keywordsEnBruto = Herramientas.Buscador.LimpiarNombre(bundle.Nombre, false).Split(' ');
		List<string> keywordsLista = new List<string>();
		keywordsLista.AddRange(keywordsEnBruto);

		string keywords = "bundle";

		foreach (string keyword in keywordsLista)
		{
			if (keyword.Length > 3)
			{
				keywords = keywords + ", " + keyword;
			}
		}

		if (bundle.Juegos?.Count > 0)
		{
			foreach (var juego in bundle.Juegos)
			{
				if (juego != null)
				{
					if (string.IsNullOrEmpty(juego.Nombre) == false)
					{
						string[] keywordsEnBrutoJuego = Herramientas.Buscador.LimpiarNombre(juego.Nombre, false).Split(' ');
						List<string> keywordsListaJuego = new List<string>();
						keywordsListaJuego.AddRange(keywordsEnBrutoJuego);

						foreach (string keyword in keywordsListaJuego)
						{
							if (keywords.Contains(keyword) == false && keyword.Length > 3)
							{
								keywords = keywords + ", " + keyword;
							}
						}
					}
				}
			}
		}

		string nombreJson = bundle.Nombre.Replace(Strings.ChrW(34).ToString(), null) + " " + bundle.Tienda.Replace(Strings.ChrW(34).ToString(), null);
		string descripcionJson = descripcion.Replace(Strings.ChrW(34).ToString(), null);
		string fechaJson = bundle.FechaEmpieza.ToString("yyyy-MM-dd");
		string estadoJson = "https://schema.org/InStock";

		if (DateTime.Now > bundle.FechaTermina)
		{
			estadoJson = "https://schema.org/Discontinued";
		}

		bundle?.Tiers?.Sort(delegate (Bundles2.BundleTier t1, Bundles2.BundleTier t2)
		{
			return t1.Posicion.CompareTo(t2.Posicion);
		});

		string precioBajoJson = bundle?.Tiers?.First()?.Precio?.ToString() ?? "0";
		string precioAltoJson = bundle?.Tiers?.Last()?.Precio?.ToString() ?? "0";
		int cantidadTiersJson = bundle?.Tiers?.Count ?? 0;

		decimal reseñasMediaJson = 1;
		int reseñasCantidadJson = 10;

		if (bundle?.Juegos?.Count > 0)
		{
			foreach (var juego in bundle.Juegos)
			{
				if (juego.Juego != null && juego.Juego.Analisis != null &&
					string.IsNullOrEmpty(juego.Juego.Analisis.Porcentaje) == false && 
					string.IsNullOrEmpty(juego.Juego.Analisis.Cantidad) == false)
				{
					reseñasMediaJson = (reseñasMediaJson + decimal.Parse(juego.Juego.Analisis.Porcentaje) / 20) / 2;

					if (reseñasMediaJson < 1)
					{
						reseñasMediaJson = 1;
					}

					reseñasCantidadJson = reseñasCantidadJson + int.Parse(juego.Juego.Analisis.Cantidad.Replace(",", null));

					if (reseñasCantidadJson < 10)
					{
						reseñasCantidadJson = 10;
					}
				}
			}
		}

		string contenidoJson = @"{
			""@context"": ""https://schema.org/"",
			""@type"": ""Product"",
			""name"": ""@nombreJson"",
			""description"": ""@descripcionJson"",
			""url"": ""@enlace"",
			""sku"": ""@bundleId"",
			""image"": {
				""@type"": ""ImageObject"",
				""url"": ""@imagen"",
				""contentUrl"": ""@imagen"",
				""name"": ""@nombreJson"",
				""caption"": ""@nombreJson""
			},
			""productionDate"": ""@fechaJson"",
			""offers"": {
				""@type"": ""AggregateOffer"",
				""availability"": ""@estadoJson"",
				""priceCurrency"": ""EUR"",
				""price"": @precioBajoJson,
				""url"": ""@enlace"",
				""offerCount"": @cantidadTiersJson,
				""lowPrice"": @precioBajoJson,
				""highPrice"": @precioAltoJson
			},
			""aggregateRating"": {
				""@type"": ""AggregateRating"",
				""ratingValue"": @reseñasMediaJson,
				""ratingCount"": @reseñasCantidadJson
			}
		}";

		contenidoJson = contenidoJson.Replace("@nombreJson", nombreJson);
		contenidoJson = contenidoJson.Replace("@descripcionJson", descripcionJson);
		contenidoJson = contenidoJson.Replace("@enlace", enlace);
		contenidoJson = contenidoJson.Replace("@bundleId", bundle?.Id.ToString());
		contenidoJson = contenidoJson.Replace("@imagen", imagen);
		contenidoJson = contenidoJson.Replace("@fechaJson", fechaJson);
		contenidoJson = contenidoJson.Replace("@estadoJson", estadoJson);
		contenidoJson = contenidoJson.Replace("@precioBajoJson", precioBajoJson);
		contenidoJson = contenidoJson.Replace("@precioAltoJson", precioAltoJson);
		contenidoJson = contenidoJson.Replace("@cantidadTiersJson", cantidadTiersJson.ToString());
		contenidoJson = contenidoJson.Replace("@reseñasMediaJson", reseñasMediaJson.ToString());
		contenidoJson = contenidoJson.Replace("@reseñasCantidadJson", reseñasCantidadJson.ToString());

		<Titulo tipo="@Titulo.Tipo.Bundle" idioma="@idioma" dominio="@dominio" tituloBundle="@titulo" descripcionBundle="@descripcion" enlaceBundle="@enlace"
				imagenBundle="@imagen" keywords="@keywords" contenidoJsonBundle="@contenidoJson"/>
	}
}

@if (bundle != null)
{
	if (tipo == Tipo.Bundle)
	{
		if (usuarioAdmin == true)
		{
			<pepeizqs_deals_blazor_web.Componentes.Admin.Bundle idioma="@idioma" bundleId="@bundle.Id" />
		}
		
		<div class="cuerpo-ancho" style="background-color: var(--fondoSubcabecera); border: 2px solid var(--glaseadoBorde); border-top-left-radius: 20px; border-top-right-radius: 20px; margin-top: 40px; @(DateTime.Now > bundle.FechaTermina ? "border-bottom: 0px;" : "")">
			<div style="display: flex; align-items: center; flex-wrap: nowrap; border-top-left-radius: inherit;">
				@if (DateTime.Now < bundle.FechaTermina)
				{
					<a href="@enlaceBundle" target="_blank" style="border-top-left-radius: inherit;">
						<div style="box-shadow: 0px 2px 4px 0px rgba(0, 0, 0, 0.28),0px 0px 1px 0px rgba(0, 0, 0, 0.24); border-top-left-radius: inherit; overflow: hidden;">
							<img src="@bundle.ImagenNoticia" style="max-width: 300px; max-height: 300px; display: block;" alt="@Bundles2.BundlesCargar.DevolverBundle(bundle.BundleTipo).Tienda" />
						</div>
					</a>
				}

				<div style="display: flex; flex-direction: column; width: 100%; @(DateTime.Now > bundle.FechaTermina ? "gap: 10px; padding: 30px 40px;" : "gap: 20px; padding: 30px;")">
					<h1 style="font-size: 20px; margin: 0px; line-height: 30px;">
						@bundle.Nombre
					</h1>

					<div style="display: flex; align-items: center; gap: 20px;">
						@if (DateTime.Now < bundle.FechaTermina)
						{
							<a href="/bundles/@bundle.BundleTipo.ToString().ToLower()/" class="boton-pequeño" style="width: fit-content; display: flex; align-items: center; gap: 20px; padding: 10px 15px;">
								<div>
									<img src="@Bundles2.BundlesCargar.DevolverBundle(bundle.BundleTipo).ImagenIcono" style="max-width: 18px; max-height: 18px; display: block;" alt="@Bundles2.BundlesCargar.DevolverBundle(bundle.BundleTipo).Tienda" />
								</div>

								<div>
									@Bundles2.BundlesCargar.DevolverBundle(bundle.BundleTipo).Tienda
								</div>
							</a>
						}
						else
						{
							<div>
								<img src="@Bundles2.BundlesCargar.DevolverBundle(bundle.BundleTipo).ImagenIcono" style="max-width: 20px; max-height: 20px; display: block;" alt="@Bundles2.BundlesCargar.DevolverBundle(bundle.BundleTipo).Tienda" />
							</div>
						}

						<div style="font-size: 16px;">
							@if (DateTime.Now < bundle.FechaTermina)
							{
								@MostrarFecha(bundle.FechaEmpieza, bundle.FechaTermina)
							}
							else
							{
								<div>
									@bundle.FechaEmpieza.Day.ToString()/@bundle.FechaEmpieza.Month.ToString()/@bundle.FechaEmpieza.Year.ToString() • @bundle.FechaTermina.Day.ToString()/@bundle.FechaTermina.Month.ToString()/@bundle.FechaTermina.Year.ToString()
								</div>
							}
						</div>
					</div>
				</div>
			</div>
		</div>

		@if (DateTime.Now < bundle.FechaTermina)
		{
			<div class="cuerpo-ancho" style="position: sticky; top: var(--alturaCabecera); z-index: 1000;">
				<a href="@enlaceBundle" target="_blank" class="boton-pequeño" style="text-align: center; padding: 20px; font-size: 20px; border: 2px solid rgba(0,255,255,0.15);">
					@Herramientas.Idiomas.BuscarTexto(idioma, "String26", "Bundle")
				</a>
			</div>
		}
	}

	if (tipo == Tipo.Noticia)
	{
		string enlaceBundle = bundle.Enlace;

		if (Herramientas.Bots.UserAgentEsBot(userAgent) == false)
		{
			enlaceBundle = Herramientas.EnlaceAcortador.Generar(usuarioRegion, bundle.Enlace, bundle.BundleTipo, usuarioPatreon, false);
		}

		<div class="cuerpo-ancho" style="position: sticky; top: var(--alturaCabecera); z-index: 1000; width: 100%;">
			<a href="@enlaceBundle" target="_blank" class="boton-pequeño" style="text-align: center; padding: 20px; font-size: 20px; border: 2px solid rgba(0,255,255,0.15);">
				<div>
					@Herramientas.Idiomas.BuscarTexto(idioma, "String26", "Bundle")
				</div>
			</a>
		</div>
	}

	if (bundle.Tiers != null)
	{
		decimal totalMinimos = 0;

		<div>
			<div class="cuerpo-ancho">
				<div class="caja-bundle-diseños">
					<button @onclick="@(async e => { await MostrarCuadricula(true); })" class="boton-bundle-diseños" style="@fondoCuadricula border: 0px; padding: 5px 10px; display: flex; align-items: center; color: var(--colorTexto); border-radius: 10px;">
						<div style="display: flex; width: 24px; height: 24px;">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
								<path fill="var(--colorTexto)" d="M480 160L480 224L416 224L416 160L480 160zM480 288L480 352L416 352L416 288L480 288zM480 416L480 480L416 480L416 416L480 416zM352 352L288 352L288 288L352 288L352 352zM288 416L352 416L352 480L288 480L288 416zM224 352L160 352L160 288L224 288L224 352zM160 416L224 416L224 480L160 480L160 416zM160 224L160 160L224 160L224 224L160 224zM288 224L288 160L352 160L352 224L288 224zM160 96C124.7 96 96 124.7 96 160L96 480C96 515.3 124.7 544 160 544L480 544C515.3 544 544 515.3 544 480L544 160C544 124.7 515.3 96 480 96L160 96z" />
							</svg>
						</div>
					</button>

					<button @onclick="@(async e => { await MostrarLista(true); })" class="boton-bundle-diseños" style="@fondoLista border: 0px; padding: 5px 10px; display: flex; align-items: center; color: var(--colorTexto); border-radius: 10px;">
						<div style="display: flex; width: 24px; height: 24px;">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
								<path fill="var(--colorTexto)" d="M104 112C90.7 112 80 122.7 80 136L80 184C80 197.3 90.7 208 104 208L152 208C165.3 208 176 197.3 176 184L176 136C176 122.7 165.3 112 152 112L104 112zM256 128C238.3 128 224 142.3 224 160C224 177.7 238.3 192 256 192L544 192C561.7 192 576 177.7 576 160C576 142.3 561.7 128 544 128L256 128zM256 288C238.3 288 224 302.3 224 320C224 337.7 238.3 352 256 352L544 352C561.7 352 576 337.7 576 320C576 302.3 561.7 288 544 288L256 288zM256 448C238.3 448 224 462.3 224 480C224 497.7 238.3 512 256 512L544 512C561.7 512 576 497.7 576 480C576 462.3 561.7 448 544 448L256 448zM80 296L80 344C80 357.3 90.7 368 104 368L152 368C165.3 368 176 357.3 176 344L176 296C176 282.7 165.3 272 152 272L104 272C90.7 272 80 282.7 80 296zM104 432C90.7 432 80 442.7 80 456L80 504C80 517.3 90.7 528 104 528L152 528C165.3 528 176 517.3 176 504L176 456C176 442.7 165.3 432 152 432L104 432z" />
							</svg>
						</div>
					</button>
				</div>
			</div>
			
			@if (bundle.Tiers.Count > 0)
			{
				int i = 0;

				foreach (var tier in OrdenarTiers(bundle.Tiers))
				{
					List<Bundles2.BundleJuego> juegosTier = new List<Bundles2.BundleJuego>();

					if (bundle.Juegos?.Count > 0)
					{
						foreach (var juego in bundle.Juegos)
						{
							if (juego.Tier != null)
							{
								if (juego.Tier.Posicion == tier.Posicion)
								{
									juegosTier.Add(juego);
								}
							}
						}
					}

					if (juegosTier?.Count > 0)
					{
						juegosTier = juegosTier.OrderBy(x => x.Nombre).ToList();

						if (bundle.Pick == true)
						{
							<div class="cuerpo-ancho bundle-espacio2" style="font-size: 18px; display: flex; align-items: center; flex-direction: row; justify-content: space-between; margin-bottom: 20px;">
								@foreach (var tier2 in OrdenarTiers(bundle.Tiers))
								{
									<div class="bundle-espacio3" style="background: var(--fondoSubsubcabecera); border: 2px solid rgba(0,0,0,.4); border-radius: 10px; text-align: center; display: flex; align-items: center; gap: 5px; width: 100%; justify-content: center;">
										@if (tier2.CantidadJuegos == 1)
										{
											<label>@tier2.CantidadJuegos.ToString() @Herramientas.Idiomas.BuscarTexto(idioma, "String21", "Bundle") • @Herramientas.Precios.Euro(decimal.Parse(tier2.Precio))</label>
										}
										else if (tier2.CantidadJuegos > 1)
										{
											<label>@tier2.CantidadJuegos.ToString() @Herramientas.Idiomas.BuscarTexto(idioma, "String8", "Bundle") • @Herramientas.Precios.Euro(decimal.Parse(tier2.Precio))</label>
											<label>/</label>
											<label style="font-size: 14px;">@Herramientas.Precios.Euro(decimal.Parse(tier2.Precio) / tier2.CantidadJuegos) (@Herramientas.Idiomas.BuscarTexto(idioma, "String20", "Bundle"))</label>
										}
									</div>
								}
							</div>
						}

						string espacioFondo = "margin-bottom: 40px;";

						if (i == bundle.Tiers.Count - 1 || bundle.Pick == true)
						{
							if (tipo == Tipo.Bundle || tipo == Tipo.Bundles)
							{
								espacioFondo = "margin-bottom: 40px;";
							}
							else
							{
								espacioFondo = string.Empty;
							}
						}

						string bordesRedondeado = string.Empty;

						if (bundle.Pick == false)
						{
							if (bundle.Tiers.Count > 0)
							{
								if (i == 0)
								{
									bordesRedondeado = "border-radius: 10px;";
								}
								else if (i == bundle.Tiers.Count - 1)
								{
									if (tipo == Tipo.Noticia)
									{
										bordesRedondeado = "border-top-left-radius: 10px; border-top-right-radius: 10px;";
									}
									else
									{
										bordesRedondeado = "border-radius: 10px;";
									}
								}
								else
								{
									bordesRedondeado = "border-radius: 10px;";
								}
							}
						}
						else
						{
							if (tipo == Tipo.Noticia)
							{
								bordesRedondeado = "border-top-left-radius: 10px; border-top-right-radius: 10px;";
							}
							else
							{
								bordesRedondeado = "border-radius: 10px;";
							}
						}

						<div class="caja-bundle-contenido cuerpo-ancho" style="@espacioFondo @bordesRedondeado">
							@if (bundle.Pick == false)
							{
								<div class="caja-bundle-mensaje" style="font-size: 18px; padding: 20px 30px; display: flex; align-items: center; justify-content: space-between;">
									<div style="display: flex; align-items: center; gap: 20px;">
										<div>
											Tier @tier.Posicion
										</div>

										<div style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,.2); padding: 5px 10px;">
											@Herramientas.Precios.Euro(decimal.Parse(tier.Precio))
										</div>
									</div>

									@foreach (var juego in juegosTier)
									{
										decimal sumarATotalMinimos = 0;

										if (usuarioRegion == TiendaRegion.Europa && juego.Juego?.PrecioMinimosHistoricos?.Count > 0)
										{
											foreach (var historico in juego.Juego.PrecioMinimosHistoricos)
											{
												if (historico.DRM == juego.DRM)
												{
													if (historico.PrecioCambiado > 0)
													{
														sumarATotalMinimos = historico.PrecioCambiado;
													}
													else
													{
														sumarATotalMinimos = historico.Precio;
													}

													break;
												}
											}
										}
										else if (usuarioRegion == TiendaRegion.EstadosUnidos && juego.Juego?.PrecioMinimosHistoricosUS?.Count > 0)
										{
											foreach (var historico in juego.Juego.PrecioMinimosHistoricosUS)
											{
												if (historico.DRM == juego.DRM)
												{
													if (historico.PrecioCambiado > 0)
													{
														sumarATotalMinimos = historico.PrecioCambiado;
													}
													else
													{
														sumarATotalMinimos = historico.Precio;
													}

													break;
												}
											}
										}

										if (usuarioTiendasNoOficial == true && usuarioRegion == TiendaRegion.Europa && juego.Juego?.PreciosActualesNoOficialesEU?.Count > 0)
										{
											foreach (var precio in juego.Juego.PreciosActualesNoOficialesEU)
											{
												if (precio.DRM == juego.DRM)
												{
													if (precio.PrecioCambiado > 0 && precio.PrecioCambiado < sumarATotalMinimos)
													{
														sumarATotalMinimos = precio.PrecioCambiado;
													}
													else if (precio.Precio < sumarATotalMinimos)
													{
														sumarATotalMinimos = precio.Precio;
													}

													break;
												}
											}
										}
										else if (usuarioTiendasNoOficial == true && usuarioRegion == TiendaRegion.EstadosUnidos && juego.Juego?.PreciosActualesNoOficialesUS?.Count > 0)
										{
											foreach (var precio in juego.Juego.PreciosActualesNoOficialesUS)
											{
												if (precio.DRM == juego.DRM)
												{
													if (precio.PrecioCambiado > 0 && precio.PrecioCambiado < sumarATotalMinimos)
													{
														sumarATotalMinimos = precio.PrecioCambiado;
													}
													else if (precio.Precio < sumarATotalMinimos)
													{
														sumarATotalMinimos = precio.Precio;
													}
													break;
												}
											}
										}

										if (usuarioTiendasMarketplace == true && usuarioRegion == TiendaRegion.Europa && juego.Juego?.PreciosActualesMarketplacesEU?.Count > 0)
										{
											foreach (var precio in juego.Juego.PreciosActualesMarketplacesEU)
											{
												if (precio.DRM == juego.DRM)
												{
													if (precio.PrecioCambiado > 0 && precio.PrecioCambiado < sumarATotalMinimos)
													{
														sumarATotalMinimos = precio.PrecioCambiado;
													}
													else if (precio.Precio < sumarATotalMinimos)
													{
														sumarATotalMinimos = precio.Precio;
													}

													break;
												}
											}
										}
										else if (usuarioTiendasMarketplace == true && usuarioRegion == TiendaRegion.EstadosUnidos && juego.Juego?.PreciosActualesMarketplacesUS?.Count > 0)
										{
											foreach (var precio in juego.Juego.PreciosActualesMarketplacesUS)
											{
												if (precio.DRM == juego.DRM)
												{
													if (precio.PrecioCambiado > 0 && precio.PrecioCambiado < sumarATotalMinimos)
													{
														sumarATotalMinimos = precio.PrecioCambiado;
													}
													else if (precio.Precio < sumarATotalMinimos)
													{
														sumarATotalMinimos = precio.Precio;
													}

													break;
												}
											}
										}

										if (sumarATotalMinimos > 0)
										{
											totalMinimos = totalMinimos + sumarATotalMinimos;
										}
									}

									<div style="font-size: 14px;">
										@Herramientas.Idiomas.BuscarTexto(idioma, "String14", "Bundle"): @Herramientas.Precios.Euro(totalMinimos)
									</div>
								</div>
							}

							<div class="bundle-espacio @(diseñoElegido == Bundles2.BundleDiseño.Cuadricula ? "bundle-cuadricula" : "bundle-lista")">
								@foreach (Bundles2.BundleJuego juego in juegosTier)
								{
									bool mostrar = true;

									if (juego.Juego?.Tipo == Juegos.JuegoTipo.DLC || juego.Juego?.Tipo == Juegos.JuegoTipo.Music)
									{
										if (string.IsNullOrEmpty(juego.Juego.Maestro) == false)
										{
											if (juego.Juego.Maestro != "no")
											{
												foreach (var juego2 in juegosTier)
												{
													if (juego2.JuegoId == juego.Juego.Maestro)
													{
														mostrar = false;
													}
