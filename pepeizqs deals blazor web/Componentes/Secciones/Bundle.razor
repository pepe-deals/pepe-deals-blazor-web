														   tipo="Interfaz.CajaJuego.Tipo.Bundle" juegosUsuarioIndex="@juegosUsuarioIndex" usuarioDeseadosImportados="@deseadosImportadosIndex" usuarioDeseadosWeb="@deseadosWebIndex" userAgent="@userAgent"
														   OnEstadoUsuario="@(eu => { juego.Tiene = eu.tieneJuego; juego.DeseadoWeb = eu.tieneDeseadoWeb; juego.DeseadoImportado = eu.tieneDeseadoImportado; })" />
											</div>

