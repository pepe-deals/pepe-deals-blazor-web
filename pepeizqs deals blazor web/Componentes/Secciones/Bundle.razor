														<div class="svg-boton" style="display: flex;">
															<svg style="width: 20px; height: 20px; transform: rotate(@(dropdownAbierto == juego.Juego.Id.ToString() + "-" + ((int)juego.DRM).ToString() ? "180deg" : "0deg")); transition: transform 0.2s;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
																<path d="M297.4 438.6C309.9 451.1 330.2 451.1 342.7 438.6L502.7 278.6C515.2 266.1 515.2 245.8 502.7 233.3C490.2 220.8 469.9 220.8 457.4 233.3L320 370.7L182.6 233.4C170.1 220.9 149.8 220.9 137.3 233.4C124.8 245.9 124.8 266.2 137.3 278.7L297.3 438.7z" />
															</svg>
														</div>
													</button>
												</div>

												@if (dropdownAbierto == juego.Juego.Id.ToString() + "-" + ((int)juego.DRM).ToString())
												{
													<div style="position: absolute; top: 35px; left: 0; background-color: var(--fondo); border: 1px solid var(--fondoCodigo); box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); z-index: 1000; width: fit-content; overflow: hidden; display: flex; flex-direction: column;">
														@if (juego.DeseadoImportado == false)
														{
															<button @onclick="@(async e => { await CambiarEstadoDeseado(e, usuarioId, juego, juego.DRM); })"
																	style="width: 100%; padding: 10px 12px; text-align: left; border: none; cursor: pointer; border-bottom: 1px solid var(--fondoCodigo); background-color: var(--fondoBotonPequeño); transition: background-color 0.2s;"
																	onmouseover="this.style.backgroundColor='var(--fondoBotonPequeñoHover)'"
																	onmouseout="this.style.backgroundColor='var(--fondoBotonPequeño)'">
																<div style="display: flex; align-items: center; gap: 10px;">
																	<div style="width: 20px; height: 20px; display: flex; fill: var(--colorTexto);">
																		@if (juego.DeseadoWeb == true)
																		{
																			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
																				<path d="M183.1 137.4C170.6 124.9 150.3 124.9 137.8 137.4C125.3 149.9 125.3 170.2 137.8 182.7L275.2 320L137.9 457.4C125.4 469.9 125.4 490.2 137.9 502.7C150.4 515.2 170.7 515.2 183.2 502.7L320.5 365.3L457.9 502.6C470.4 515.1 490.7 515.1 503.2 502.6C515.7 490.1 515.7 469.8 503.2 457.3L365.8 320L503.1 182.6C515.6 170.1 515.6 149.8 503.1 137.3C490.6 124.8 470.3 124.8 457.8 137.3L320.5 274.7L183.1 137.4z" />
																			</svg>
																		}
																		else
																		{
																			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
																				<path d="M341.5 45.1C337.4 37.1 329.1 32 320.1 32C311.1 32 302.8 37.1 298.7 45.1L225.1 189.3L65.2 214.7C56.3 216.1 48.9 222.4 46.1 231C43.3 239.6 45.6 249 51.9 255.4L166.3 369.9L141.1 529.8C139.7 538.7 143.4 547.7 150.7 553C158 558.3 167.6 559.1 175.7 555L320.1 481.6L464.4 555C472.4 559.1 482.1 558.3 489.4 553C496.7 547.7 500.4 538.8 499 529.8L473.7 369.9L588.1 255.4C594.5 249 596.7 239.6 593.9 231C591.1 222.4 583.8 216.1 574.8 214.7L415 189.3L341.5 45.1z" />
																			</svg>
																		}
																	</div>

																	<span style="color: var(--colorTexto); font-size: 16px;">
																		@if (juego.DeseadoWeb == true)
																		{
																			@Herramientas.Idiomas.BuscarTexto(idioma, "String13", "Index")
																		}
																		else
																		{
																			@Herramientas.Idiomas.BuscarTexto(idioma, "String12", "Index")
																		}
																	</span>
																</div>
															</button>
														}

														<button @onclick="@(async e => { await ExcluirJuego(e, usuarioId, juego); })"
																style="width: 100%; padding: 10px 12px; text-align: left; border: none; cursor: pointer; border-bottom: 1px solid var(--fondoCodigo); background-color: var(--fondoBotonPequeño); transition: background-color 0.2s;"
																onmouseover="this.style.backgroundColor='var(--fondoBotonPequeñoHover)'"
																onmouseout="this.style.backgroundColor='var(--fondoBotonPequeño)'">
															<div style="display: flex; align-items: center; gap: 10px;">
																<div style="width: 20px; height: 20px; display: flex; fill: var(--colorTexto);">
																	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
																		<path d="M431.2 476.5L163.5 208.8C141.1 240.2 128 278.6 128 320C128 426 214 512 320 512C361.5 512 399.9 498.9 431.2 476.5zM476.5 431.2C498.9 399.8 512 361.4 512 320C512 214 426 128 320 128C278.5 128 240.1 141.1 208.8 163.5L476.5 431.2zM64 320C64 178.6 178.6 64 320 64C461.4 64 576 178.6 576 320C576 461.4 461.4 576 320 576C178.6 576 64 461.4 64 320z" />
																	</svg>
																</div>

																<span style="color: var(--colorTexto); font-size: 16px;">
																	@Herramientas.Idiomas.BuscarTexto(idioma, "String16", "Index")
																</span>
															</div>
														</button>
													</div>
												}
											}
										</div>
									}
								}
							</div>
						</div>

						if (bundle.Pick == true)
						{
							break;
						}
					}

					i += 1;
				}
			}
		</div>
	}
}

@code {

	#nullable disable

	[CascadingParameter] private Herramientas.ContextoUsuarioDatos datos { get; set; }

	private string idioma = "en";
	private string usuarioId = null;
	private string userAgent = null;
	private string dominio = null;

	[PersistentState] public Herramientas.UsuarioListadosJuegos juegosUsuario { get; set; }
	[PersistentState] public Herramientas.UsuarioJuegosIndex juegosUsuarioIndex { get; set; }

	[PersistentState] public Usuario deseadosUsuario { get; set; }
	[PersistentState] public Herramientas.UsuarioDeseadosImportadosIndex deseadosImportadosIndex { get; set; }
	[PersistentState] public Herramientas.UsuarioDeseadosWebIndex deseadosWebIndex { get; set; }

	private bool usuarioPatreon = false;
	private bool usuarioAdmin = false;
	private TiendaRegion usuarioRegion = TiendaRegion.Europa;
	private bool usuarioTiendasNoOficial = false;
	private bool usuarioTiendasMarketplace = false;
	[PersistentState] public Usuario opciones { get; set; }

	[Parameter]
	public int bundleId { get; set; }

	[Parameter]
	public string bundleNombre { get; set; }

	[Parameter]
	public Tipo tipo { get; set; } = Tipo.Bundle;

	[PersistentState] public Bundles2.Bundle bundle { get; set; }

	private string enlaceBundle = string.Empty;

	protected override async Task OnInitializedAsync()
	{
		idioma = datos.Idioma;
		usuarioId = datos.UsuarioId;
		userAgent = datos.UserAgent;
		dominio = datos.Dominio;
		usuarioRegion = datos.Region;
		usuarioTiendasNoOficial = datos.NoOficial;
		usuarioTiendasMarketplace = datos.Marketplace;

		diseñoElegido = datos.DiseñoBundle;

		if (diseñoElegido == Bundles2.BundleDiseño.Cuadricula)
		{
			await MostrarCuadricula(false);
		}
		else if (diseñoElegido == Bundles2.BundleDiseño.Lista)
		{
			await MostrarLista(false);
		}

		if (string.IsNullOrEmpty(usuarioId) == false)
		{
			Task<string> tareaIdioma = BaseDatos.Usuarios.Buscar.IdiomaSobreescribir(usuarioId);
			Task<Herramientas.UsuarioListadosJuegos> tareaJuegos = (juegosUsuario != null) ? Task.FromResult(juegosUsuario) : Herramientas.UsuarioJuegos.Cargar(usuarioId);
			Task<Usuario> tareaDeseados = (deseadosUsuario != null) ? Task.FromResult(deseadosUsuario) : BaseDatos.Usuarios.Buscar.DeseadosTiene(usuarioId);
			Task<DateTime?> tareaPatreon = BaseDatos.Usuarios.Buscar.FechaPatreon(usuarioId);
			Task<bool> tareaAdmin = BaseDatos.Usuarios.Buscar.RolDios(usuarioId);
			Task<Usuario> tareaUsuario = (opciones != null) ? Task.FromResult(opciones) : BaseDatos.Usuarios.Buscar.OpcionesBundle(usuarioId);

			await Task.WhenAll(tareaIdioma, tareaJuegos, tareaDeseados, tareaPatreon, tareaAdmin, tareaUsuario);

			idioma = tareaIdioma.Result;
			juegosUsuario = tareaJuegos.Result;
			deseadosUsuario = tareaDeseados.Result;
			usuarioPatreon = Herramientas.Patreon.VerificarActivo(tareaPatreon.Result);
			usuarioAdmin = tareaAdmin.Result;
			opciones = tareaUsuario.Result;

			if (juegosUsuarioIndex == null)
			{
				juegosUsuarioIndex = Herramientas.UsuarioJuegos.CrearIndex(juegosUsuario);
			}

			if (deseadosImportadosIndex == null)
			{
				deseadosImportadosIndex = Herramientas.Deseados.CrearImportadosIndex(deseadosUsuario);
			}

			if (deseadosWebIndex == null)
			{
				deseadosWebIndex = Herramientas.Deseados.CrearWebIndex(deseadosUsuario);
			}

			if (opciones != null)
			{
				if (opciones.Currency.HasValue == true)
				{
					usuarioRegion = (TiendaRegion)opciones.Currency.Value;
				}

				if (opciones.NoOfficial.HasValue == true)
				{
					usuarioTiendasNoOficial = opciones.NoOfficial.Value;
				}

				if (opciones.Marketplace.HasValue == true)
				{
					usuarioTiendasMarketplace = opciones.Marketplace.Value;
				}
			}
		}

		bundle ??= await BaseDatos.Bundles.Buscar.UnBundle(bundleId);

		if (bundle != null)
		{
			enlaceBundle = bundle.Enlace;

			if (Herramientas.Bots.UserAgentEsBot(userAgent) == false)
			{
				enlaceBundle = Herramientas.EnlaceAcortador.Generar(usuarioRegion, bundle.Enlace, bundle.BundleTipo, usuarioPatreon, false);
			}		
		}
	}

	protected override async Task OnParametersSetAsync()
	{
		if (bundle?.Juegos?.Count > 0)
		{
			List<Bundles2.BundleJuego> pendientes = bundle.Juegos.Where(j => string.IsNullOrEmpty(j.JuegoId) == false && j.Juego == null).ToList();

			if (pendientes.Count > 0)
			{
				List<JuegoDeseado> ids = pendientes.Select(j => new JuegoDeseado { IdBaseDatos = j.JuegoId, DRM = j.DRM }).DistinctBy(j => j.IdBaseDatos).ToList();

				List<Juegos.Juego> encontrados = await BaseDatos.Juegos.Buscar.MultiplesJuegosBundle(usuarioTiendasNoOficial, usuarioTiendasMarketplace, usuarioRegion, ids);

				if (encontrados?.Count > 0)
				{
					Dictionary<int, Juegos.Juego> porId = encontrados.GroupBy(j => j.Id).ToDictionary(g => g.Key, g => UnirFilas(g.ToList()));
					int reseñas = 0;

					foreach (var juego in pendientes)
					{
						int idJuego = int.Parse(juego.JuegoId);

						if (porId.TryGetValue(idJuego, out Juegos.Juego encontrado) == false)
						{
							continue;
						}

						juego.Juego = encontrado;
						juego.Imagen = encontrado.Imagenes.Header_460x215;

						if (Herramientas.UsuarioJuegos.ComprobarSiEstaExcluido(juegosUsuarioIndex?.Excluidos, idJuego) == true)
						{
							juego.Color = "var(--fondoPeligro)";
						}

						if (string.IsNullOrEmpty(encontrado.Analisis?.Cantidad) == false)
						{
							int reseñasJuego = int.Parse(encontrado.Analisis.Cantidad.Replace(",", null));

							if (reseñasJuego > reseñas)
							{
								reseñas = reseñasJuego;
							}
						}
					}

					foreach (var juego in pendientes)
					{
						string maestro = juego.Juego?.Maestro;

						if (juego.Juego?.Tipo != Juegos.JuegoTipo.DLC || string.IsNullOrEmpty(maestro) == true || maestro == "no")
						{
							continue;
						}

						foreach (var juego2 in pendientes.Where(j => j.JuegoId == maestro && j.Tier.Posicion == juego.Tier.Posicion))
						{
							juego2.DLCs ??= new List<string>();

							if (juego2.DLCs.Contains(juego.JuegoId) == false)
							{
								juego2.DLCs.Add(juego.JuegoId);
							}
						}
					}
				}
			}
		}
	}

	private IJSObjectReference moduloJs;

	protected override async Task OnAfterRenderAsync(bool primerRender)
	{
		if (primerRender == true)
		{
			try
			{
				moduloJs = await JavaScript.InvokeAsync<IJSObjectReference>("import", "/componentes/secciones/Bundle.razor.js");
			}
			catch { }

			if (bundle == null)
			{
				bundle ??= await BaseDatos.Bundles.Buscar.UnBundle(bundleId);
			}

			if (bundle != null)
			{
				if (tipo == Tipo.Bundle && string.IsNullOrEmpty(bundleNombre) == true)
				{
					bundleNombre = Herramientas.EnlaceAdaptador.Nombre(bundle.Nombre);

					if (moduloJs != null && string.IsNullOrEmpty(bundleNombre) == false && bundleNombre.Length > 0)
					{
						try
						{
							await moduloJs.InvokeVoidAsync("cambiarEnlace", "/bundle/" + bundle.Id.ToString() + "/" + bundleNombre + "/");
						}
						catch {}
					}
				}
			}	

			await InvokeAsync(StateHasChanged);
		}
	}

	public async ValueTask DisposeAsync()
	{
		if (moduloJs != null)
		{
			try
			{
				await moduloJs.DisposeAsync();
			}
			catch { }
		}
	}

	public enum Tipo
	{
		Bundle,
		Bundles,
		Juego,
		Noticia
	}

	private List<Bundles2.BundleTier> OrdenarTiers(List<Bundles2.BundleTier> tiers)
	{
		if (tiers != null)
		{
			tiers.Sort(delegate (Bundles2.BundleTier t1, Bundles2.BundleTier t2)
			{
				return t1.Posicion.CompareTo(t2.Posicion);
			});
		}

		return tiers;
	}

	private async void AbrirBundle(MouseEventArgs e, string enlace)
	{
		try
		{
			await JavaScript.InvokeVoidAsync("open", enlace, "_blank");
		}
		catch { }
	}

	private string MostrarFecha(DateTime fechaEmpieza, DateTime fechaTermina)
	{
		if (fechaTermina.Year > 2022)
		{
			TimeSpan diferenciaTiempo = fechaTermina.Subtract(DateTime.Now);

			if (diferenciaTiempo.Days > 1)
			{
				return string.Format(Herramientas.Idiomas.BuscarTexto(idioma, "String4", "Bundle"), diferenciaTiempo.Days);
			}
			else if (diferenciaTiempo.Days == 1)
			{
				return string.Format(Herramientas.Idiomas.BuscarTexto(idioma, "String5", "Bundle"), diferenciaTiempo.Days);
			}
			else if (diferenciaTiempo.Days == 0 && diferenciaTiempo.Minutes > 0)
			{
				return string.Format(Herramientas.Idiomas.BuscarTexto(idioma, "String6", "Bundle"), diferenciaTiempo.Days);
			}
		}

		return Herramientas.Idiomas.BuscarTexto(idioma, "String7", "Bundle") + " • " + fechaEmpieza.Day.ToString() + "/" + fechaEmpieza.Month.ToString() + "/" + fechaEmpieza.Year.ToString() + " • " + fechaTermina.Day.ToString() + "/" + fechaTermina.Month.ToString() + "/" + fechaTermina.Year.ToString();
	}

	#region Desplegable

	private string dropdownAbierto = string.Empty;

	private void DesplegarDropdown(int juegoId, JuegoDRM drm)
	{
		if (juegoId > 0)
		{
			string key = juegoId.ToString() + "-" + ((int)drm).ToString();

			dropdownAbierto = dropdownAbierto == key ? string.Empty : key;
		}
	}

	private async Task CambiarEstadoDeseado(MouseEventArgs e, string usuarioId, Bundles2.BundleJuego juego, JuegoDRM drm)
	{
		bool estado = !juego.DeseadoWeb;

		juego.DeseadoWeb = !juego.DeseadoWeb;

		await Herramientas.Deseados.CambiarEstado(usuarioId, juego.Juego, estado, drm, false);

		foreach (var juego2 in bundle.Juegos)
		{
			if (juego2.Juego.Id == juego.Juego.Id && juego.DRM == drm)
			{
				if (estado == true)
				{
					juego2.Color = "var(--fondoAlerta)";
				}
				else
				{
					juego2.Color = "var(--fondoBotonPequeño)";
				}
			}
		}

		await InvokeAsync(StateHasChanged);
	}

	private void MostrarBotonDeseados(MouseEventArgs e, Bundles2.BundleJuego juego)
	{
		juego.DesplegableMostrar = true;
	}

	private void OcultarBotonDeseados(MouseEventArgs e, Bundles2.BundleJuego juego)
	{
		juego.DesplegableMostrar = false;
	}

	private async Task ExcluirJuego(MouseEventArgs e, string usuarioId, Bundles2.BundleJuego juego)
	{
		if (juego.Color == "var(--fondoPeligro)")
		{
			juego.Color = "var(--fondoBotonPequeño)";
			await Herramientas.ExcluirJuegos.Quitar(usuarioId, juego.Juego.Id);
		}
		else
		{
			juego.Color = "var(--fondoPeligro)";
			await Herramientas.ExcluirJuegos.Añadir(usuarioId, juego.Juego.Id);
		}
	}

	#endregion

	private static Juegos.Juego UnirFilas(List<Juegos.Juego> filas)
	{
		Juegos.Juego unido = filas[0];

		foreach (var fila in filas.Skip(1))
		{
			unido.PrecioMinimosHistoricos ??= fila.PrecioMinimosHistoricos;
			unido.PrecioMinimosHistoricosUS ??= fila.PrecioMinimosHistoricosUS;
			unido.PreciosHistoricosNoOficialesEU ??= fila.PreciosHistoricosNoOficialesEU;
			unido.PreciosHistoricosNoOficialesUS ??= fila.PreciosHistoricosNoOficialesUS;
			unido.PreciosHistoricosMarketplacesEU ??= fila.PreciosHistoricosMarketplacesEU;
			unido.PreciosHistoricosMarketplacesUS ??= fila.PreciosHistoricosMarketplacesUS;
		}

		return unido;
	}

	#region Cambio Diseños

	public Bundles2.BundleDiseño diseñoElegido = Bundles2.BundleDiseño.Cuadricula;

	private string fondoCuadricula = "background: transparent;";

	private async Task MostrarCuadricula(bool guardar)
	{
		fondoCuadricula = "background: var(--botonSeleccionado);";
		fondoLista = "background: transparent;";

		if (guardar == true)
		{
			diseñoElegido = Bundles2.BundleDiseño.Cuadricula;
			await ServicioDiseñoBundle.AsignarDiseño(diseñoElegido);
		}
	}

	private string fondoLista = "background: transparent;";

	private async Task MostrarLista(bool guardar)
	{
		fondoCuadricula = "background: transparent;";
		fondoLista = "background: var(--botonSeleccionado);";

		if (guardar == true)
		{
			diseñoElegido = Bundles2.BundleDiseño.Lista;
			await ServicioDiseñoBundle.AsignarDiseño(diseñoElegido);
		}
	}

	#endregion
}
