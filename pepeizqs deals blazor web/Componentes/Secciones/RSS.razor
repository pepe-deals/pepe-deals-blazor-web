@page "/rss/"

@implements IAsyncDisposable

@using Microsoft.AspNetCore.Components.Web
@using Noticias
@using Tiendas2
@using pepeizqs_deals_blazor_web.Componentes.Interfaz
@using pepeizqs_deals_web.Data

@inject IHttpContextAccessor Contexto
@inject IJSRuntime JavaScript

<Titulo tipo="@Titulo.Tipo.RSS" idioma="@idioma" dominio="@dominio"/>

@if (enseñarAlerta == true)
{
	<div style="width: fit-content; background-color: var(--fondoAlerta); color: var(--colorTexto); padding: 10px 15px; margin: 30px; top: var(--alturaCabecera); left: 0; position: fixed; z-index: 1001; box-shadow: 0px 4px 8px 0px rgba(0, 0, 0, 0.28),0px 0px 2px 0px rgba(0, 0, 0, 0.24);">
		<div style="display: flex; align-items: center; gap: 10px;">
			<div>
				@Herramientas.Idiomas.BuscarTexto(idioma, "String1", "Clipboard")
			</div>

			<button @onclick="CerrarAvisoClipboard" class="boton-pequeño" style="display: flex; padding: 0px; background-color: transparent; width: fit-content; box-shadow: none;">
				<div style="width: 20px; height: 20px;">
					<svg class="svg-boton" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
						<path d="M183.1 137.4C170.6 124.9 150.3 124.9 137.8 137.4C125.3 149.9 125.3 170.2 137.8 182.7L275.2 320L137.9 457.4C125.4 469.9 125.4 490.2 137.9 502.7C150.4 515.2 170.7 515.2 183.2 502.7L320.5 365.3L457.9 502.6C470.4 515.1 490.7 515.1 503.2 502.6C515.7 490.1 515.7 469.8 503.2 457.3L365.8 320L503.1 182.6C515.6 170.1 515.6 149.8 503.1 137.3C490.6 124.8 470.3 124.8 457.8 137.3L320.5 274.7L183.1 137.4z" />
					</svg>
				</div>
			</button>
		</div>
	</div>
}

<div class="subcabecera" style="background: color-mix(in srgb, var(--fondoSubcabecera) 45%, var(--fondoBotonPequeño)); position: sticky; top: var(--alturaCabecera); z-index: 100;">
	<div class="cuerpo-ancho" style="display: flex; align-items: center; gap: 20px; padding: 10px 0px;">
		<div style="display: flex; align-items: center; gap: 15px;">
			<div style="max-width: 24px; max-height: 24px;">
				<svg class="svg-boton" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M0 64C0 46.3 14.3 32 32 32c229.8 0 416 186.2 416 416c0 17.7-14.3 32-32 32s-32-14.3-32-32C384 253.6 226.4 96 32 96C14.3 96 0 81.7 0 64zM0 416a64 64 0 1 1 128 0A64 64 0 1 1 0 416zM32 160c159.1 0 288 128.9 288 288c0 17.7-14.3 32-32 32s-32-14.3-32-32c0-123.7-100.3-224-224-224c-17.7 0-32-14.3-32-32s14.3-32 32-32z" /></svg>
			</div>

			<div>
				@Herramientas.Idiomas.BuscarTexto(idioma, "Title", "RSS")
			</div>
		</div>
		
		@{
			string scroll1 = "noticias";
			string scroll2 = "ultimasofertas";
			string scroll3 = "deseados";
		}

		<button @onclick="(e => ScrollHastaElemento(e, scroll1))" class="boton-subcabecera">
			@Herramientas.Idiomas.BuscarTexto(idioma, "String1", "RSS")
		</button>

		<button @onclick="(e => ScrollHastaElemento(e, scroll2))" class="boton-subcabecera">
			@Herramientas.Idiomas.BuscarTexto(idioma, "String5", "RSS")
		</button>

        @if (string.IsNullOrEmpty(usuarioId) == false)
        {
            <button @onclick="(e => ScrollHastaElemento(e, scroll3))" class="boton-subcabecera">
                @Herramientas.Idiomas.BuscarTexto(idioma, "String10", "RSS")
            </button>
        }
	</div>
</div>

<div class="cuerpo-ancho" style="margin-top: 40px; margin-bottom: 40px; display: flex; flex-direction: column; gap: 40px;">
	<div id="noticias" class="caja-rss-contenido">
		<div class="caja-rss-titulo">
			@Herramientas.Idiomas.BuscarTexto(idioma, "String1", "RSS")
		</div>

		<div style="padding: 30px; display: flex; flex-direction: column; gap: 20px;">
			<div style="display: flex; align-items: center; gap: 20px;">
				<button @onclick="@(() => CambiarIdiomaNoticias("en"))" class="boton-rss-opciones @(idiomaNoticias.ToLower() == "en" ? "seleccionado" : "")" style="display: flex; align-items: center; gap: 8px;">
					@if (idiomaNoticias.ToLower() == "en")
					{
						<div style="width: 22px; height: 22px; flex-shrink: 0;">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" style="fill: none; stroke: var(--colorTexto); stroke-width: 60; stroke-linecap: round; stroke-linejoin: round;">
								<path d="M128 340 L280 480 L512 160" />
							</svg>
						</div>
					}

					<img src="/imagenes/banderas/english.svg" style="display: block; width: 22px; max-height: 22px; flex-shrink: 0;" />
				</button>

				<button @onclick="@(() => CambiarIdiomaNoticias("es"))" class="boton-rss-opciones @(idiomaNoticias.ToLower() == "es" ? "seleccionado" : "")" style="display: flex; align-items: center; gap: 8px;">
					@if (idiomaNoticias.ToLower() == "es")
					{
						<div style="width: 22px; height: 22px; flex-shrink: 0;">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" style="fill: none; stroke: var(--colorTexto); stroke-width: 60; stroke-linecap: round; stroke-linejoin: round;">
								<path d="M128 340 L280 480 L512 160" />
							</svg>
						</div>
					}

					<img src="/imagenes/banderas/spanish.svg" style="display: block; width: 22px; max-height: 22px; flex-shrink: 0;" />
				</button>
			</div>

			<div style="display: flex; align-items: center; gap: 20px;">
				<button @onclick="@(() => CambiarCategoriasNoticias("all"))" class="boton-rss-opciones @(categoriasNoticias.Contains("all") ? "seleccionado" : "")" style="display: flex; align-items: center; gap: 8px;">
					@if (categoriasNoticias.Contains("all"))
					{
						<div style="width: 22px; height: 22px;">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" style="fill: none; stroke: var(--colorTexto); stroke-width: 60; stroke-linecap: round; stroke-linejoin: round;">
								<path d="M128 340 L280 480 L512 160" />
							</svg>
						</div>
					}

					<div>@Herramientas.Idiomas.BuscarTexto(idioma, "String2", "RSS")</div>
				</button>

				@foreach (NoticiaMostrar mostrar in NoticiasCargar.CargarNoticiasMostrar())
				{
					if (mostrar.Mostrar == true)
					{
						<button @onclick="@(() => CambiarCategoriasNoticias(((int)mostrar.Tipo).ToString()))" class="boton-rss-opciones @(categoriasNoticias.Contains(((int)mostrar.Tipo).ToString().ToLower()) ? " seleccionado" : "" )" style="display: flex; align-items: center; gap: 8px;">
							@if (categoriasNoticias.Contains(((int)mostrar.Tipo).ToString().ToLower()))
							{
								<div style="width: 22px; height: 22px;">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" style="fill: none; stroke: var(--colorTexto); stroke-width: 60; stroke-linecap: round; stroke-linejoin: round;">
										<path d="M128 340 L280 480 L512 160" />
									</svg>
								</div>
							}

							<div>@Noticias.NoticiasCargar.Traduccion(mostrar.Tipo, idioma)</div>
						</button>
					}
				}
			</div>
			
			<div style="display: flex; align-items: center; gap: 20px; background-color: var(--fondoSubcabecera); border: 2px solid var(--fondoBotonPequeño);">
				<div style="padding: 10px 15px;">
					<label style="text-decoration: none; cursor: initial;">@enlaceNoticiasFinal</label>
				</div>

				<button @onclick="(e => CopiarAlClipboard(e, enlaceNoticiasFinal))" class="juego-boton-pequeño" style="width: fit-content; padding: 10px 15px; display: flex; margin-left: auto;">
					<div style="width: 24px;">
						<svg class="svg-boton" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
							<path d="M288 64C252.7 64 224 92.7 224 128L224 384C224 419.3 252.7 448 288 448L480 448C515.3 448 544 419.3 544 384L544 183.4C544 166 536.9 149.3 524.3 137.2L466.6 81.8C454.7 70.4 438.8 64 422.3 64L288 64zM160 192C124.7 192 96 220.7 96 256L96 512C96 547.3 124.7 576 160 576L352 576C387.3 576 416 547.3 416 512L416 496L352 496L352 512L160 512L160 256L176 256L176 192L160 192z" />
						</svg>
					</div>
				</button>
			</div>
		</div>
	</div>

	<div id="ultimasofertas" class="caja-rss-contenido">
		<div class="caja-rss-titulo">
			@Herramientas.Idiomas.BuscarTexto(idioma, "String5", "RSS")
		</div>

		<div style="padding: 30px; display: flex; flex-direction: column; gap: 20px;">
			<div>
				@Herramientas.Idiomas.BuscarTexto(idioma, "String6", "RSS")
			</div>

			<div style="display: flex; align-items: center; gap: 20px; background-color: var(--fondoSubcabecera); border: 2px solid var(--fondoBotonPequeño);">
				<div style="padding: 10px 15px;">
					<label style="text-decoration: none; cursor: initial;">@enlaceOfertas1</label>
				</div>

				<button @onclick="(e => CopiarAlClipboard(e, enlaceOfertas1))" class="juego-boton-pequeño" style="width: fit-content; padding: 10px 15px; display: flex; margin-left: auto;">
					<div style="width: 24px;">
						<svg class="svg-boton" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
							<path d="M288 64C252.7 64 224 92.7 224 128L224 384C224 419.3 252.7 448 288 448L480 448C515.3 448 544 419.3 544 384L544 183.4C544 166 536.9 149.3 524.3 137.2L466.6 81.8C454.7 70.4 438.8 64 422.3 64L288 64zM160 192C124.7 192 96 220.7 96 256L96 512C96 547.3 124.7 576 160 576L352 576C387.3 576 416 547.3 416 512L416 496L352 496L352 512L160 512L160 256L176 256L176 192L160 192z" />
						</svg>
					</div>
				</button>
			</div>

			<div>
				@Herramientas.Idiomas.BuscarTexto(idioma, "String7", "RSS")
			</div>

			<div style="display: flex; align-items: center; gap: 20px; background-color: var(--fondoSubcabecera); border: 2px solid var(--fondoBotonPequeño);">
				<div style="padding: 10px 15px;">
					<label style="text-decoration: none; cursor: initial;">@enlaceOfertas2</label>
				</div>

				<button @onclick="(e => CopiarAlClipboard(e, enlaceOfertas2))" class="juego-boton-pequeño" style="width: fit-content; padding: 10px 15px; display: flex; margin-left: auto;">
					<div style="width: 24px;">
						<svg class="svg-boton" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
							<path d="M288 64C252.7 64 224 92.7 224 128L224 384C224 419.3 252.7 448 288 448L480 448C515.3 448 544 419.3 544 384L544 183.4C544 166 536.9 149.3 524.3 137.2L466.6 81.8C454.7 70.4 438.8 64 422.3 64L288 64zM160 192C124.7 192 96 220.7 96 256L96 512C96 547.3 124.7 576 160 576L352 576C387.3 576 416 547.3 416 512L416 496L352 496L352 512L160 512L160 256L176 256L176 192L160 192z" />
						</svg>
					</div>
				</button>
			</div>

			<div>
				@Herramientas.Idiomas.BuscarTexto(idioma, "String8", "RSS")
			</div>

			<div>
				@Herramientas.Idiomas.BuscarTexto(idioma, "String9", "RSS")
			</div>
		</div>
	</div>

	@if (string.IsNullOrEmpty(usuarioId) == false)
	{
		<div id="deseados" class="caja-rss-contenido">
			<div class="caja-rss-titulo">
				@Herramientas.Idiomas.BuscarTexto(idioma, "String10", "RSS")
			</div>

			<div style="padding: 30px; display: flex; flex-direction: column; gap: 20px;">
				<div style="display: flex; align-items: center; gap: 25px;">
					<button @onclick="@(() => CambiarDeseadosCategoria(1))" class="boton-rss-opciones @(categoriaDeseados == 1 ? "seleccionado" : "")" style="display: flex; align-items: center; gap: 8px;">
						@if (categoriaDeseados == 1)
						{
							<div style="width: 22px; height: 22px;">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" style="fill: none; stroke: var(--colorTexto); stroke-width: 60; stroke-linecap: round; stroke-linejoin: round;">
									<path d="M128 340 L280 480 L512 160" />
								</svg>
							</div>
						}

						<div>@Herramientas.Idiomas.BuscarTexto(idioma, "String11", "RSS")</div>
					</button>

					<button @onclick="@(() => CambiarDeseadosCategoria(0))" class="boton-rss-opciones @(categoriaDeseados == 0 ? "seleccionado" : "")" style="display: flex; align-items: center; gap: 8px;">
						@if (categoriaDeseados == 0)
						{
							<div style="width: 22px; height: 22px;">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" style="fill: none; stroke: var(--colorTexto); stroke-width: 60; stroke-linecap: round; stroke-linejoin: round;">
									<path d="M128 340 L280 480 L512 160" />
								</svg>
							</div>
						}

						<div>@Herramientas.Idiomas.BuscarTexto(idioma, "String12", "RSS")</div>
					</button>
				</div>

				<div style="display: flex; align-items: center; gap: 20px; background-color: var(--fondoSubcabecera); border: 2px solid var(--fondoBotonPequeño);">
					<div style="padding: 10px 15px;">
						<label style="text-decoration: none; cursor: initial;">@enlaceDeseadosFinal</label>
					</div>

					<button @onclick="(e => CopiarAlClipboard(e, enlaceDeseadosFinal))" class="juego-boton-pequeño" style="width: fit-content; padding: 10px 15px; display: flex; margin-left: auto;">
						<div style="width: 24px;">
							<svg class="svg-boton" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
								<path d="M288 64C252.7 64 224 92.7 224 128L224 384C224 419.3 252.7 448 288 448L480 448C515.3 448 544 419.3 544 384L544 183.4C544 166 536.9 149.3 524.3 137.2L466.6 81.8C454.7 70.4 438.8 64 422.3 64L288 64zM160 192C124.7 192 96 220.7 96 256L96 512C96 547.3 124.7 576 160 576L352 576C387.3 576 416 547.3 416 512L416 496L352 496L352 512L160 512L160 256L176 256L176 192L160 192z" />
							</svg>
						</div>
					</button>
				</div>

				<div>@Herramientas.Idiomas.BuscarTexto(idioma, "String13", "RSS")</div>
			</div>
		</div>
	}
</div>

@code {

	#nullable disable

	private string idioma = "en";
	private string usuarioId = null;
	private string dominio = null;

	private TiendaRegion usuarioRegion = TiendaRegion.Europa;
	private bool usuarioTiendasNoOficial = false;
	[PersistentState] public Usuario opciones { get; set; }

	private string enlaceOfertas1 = null;
	private string enlaceOfertas2 = null;

	private string idiomaNoticias = "en";
	private string categoriasNoticias = "all";
	private string enlaceNoticiasFinal = null;

	private int categoriaDeseados = 1;
	private string enlaceDeseadosFinal = null;

	protected override async Task OnInitializedAsync()
	{
		Herramientas.ContextoUsuarioDatos datos = Herramientas.ContextoUsuario.Leer(Contexto);
		idioma = datos.Idioma;
		usuarioId = datos.UsuarioId;
		dominio = datos.Dominio;
		usuarioRegion = datos.Region;
		usuarioTiendasNoOficial = datos.NoOficial;

		if (string.IsNullOrEmpty(usuarioId) == false)
		{
			Task<string> tareaIdioma = BaseDatos.Usuarios.Buscar.IdiomaSobreescribir(usuarioId);
			Task<Usuario> tareaUsuario = (opciones != null) ? Task.FromResult(opciones) : BaseDatos.Usuarios.Buscar.OpcionesRSS(usuarioId);

			await Task.WhenAll(tareaIdioma, tareaUsuario);

			idioma = tareaIdioma.Result;
			opciones = tareaUsuario.Result;

			if (opciones != null)
			{
				if (opciones.Currency.HasValue == true)
				{
					usuarioRegion = (TiendaRegion)opciones.Currency.Value;
				}

				if (opciones.NoOfficial.HasValue == true)
				{
					usuarioTiendasNoOficial = opciones.NoOfficial.Value;
				}
			}
		}

		if (idioma.ToLower() == "es" || idioma.ToLower() == "es-es")
		{
			idiomaNoticias = "es";
		}

        enlaceNoticiasFinal = GenerarEnlaceNoticias("all");
		enlaceDeseadosFinal = GenerarEnlaceDeseados(1);


		if (usuarioRegion == TiendaRegion.Europa)
		{
			enlaceOfertas1 = "https://" + dominio + "/rss/eu/steam/1000";
			enlaceOfertas2 = "https://" + dominio + "/rss/eu/steam,gog/1000";
		}
		else if (usuarioRegion == TiendaRegion.EstadosUnidos)
		{
			enlaceOfertas1 = "https://" + dominio + "/rss/us/steam/1000";
			enlaceOfertas2 = "https://" + dominio + "/rss/us/steam,gog/1000";
		}
	}

	private IJSObjectReference moduloJs;

	protected override async Task OnAfterRenderAsync(bool primerRender)
	{
		if (primerRender == true)
		{
			moduloJs = await JavaScript.InvokeAsync<IJSObjectReference>("import", "/componentes/secciones/RSS.razor.js");
		}
	}

	public async ValueTask DisposeAsync()
	{
		if (moduloJs != null)
		{
			try
			{
				await moduloJs.DisposeAsync();
			}
			catch { }
		}
	}

	#region Portapapeles

	bool enseñarAlerta = false;
	private PeriodicTimer cronometro = null;
	private int cronometroContador = 0;
	private int cronometroLimite = 10;

	private async void CopiarAlClipboard(MouseEventArgs e, string texto)
	{
		enseñarAlerta = true;

		if (moduloJs != null)
		{
			await moduloJs.InvokeVoidAsync("copiarTexto", texto);
		}

		cronometroContador = 0;
		cronometro = new PeriodicTimer(TimeSpan.FromSeconds(1));

		while (await cronometro.WaitForNextTickAsync())
		{
			cronometroContador += 1;

			if (cronometroContador > cronometroLimite)
			{
				enseñarAlerta = false;
				cronometro.Dispose();
				await InvokeAsync(StateHasChanged);
			}
		}
	}

	private void CerrarAvisoClipboard()
	{
		enseñarAlerta = false;
		cronometroContador = 0;

		if (cronometro != null)
		{
			cronometro.Dispose();
		}
	}

	#endregion

	#region Generar Enlaces

	private async Task CambiarIdiomaNoticias(string nuevoIdioma)
	{
		idiomaNoticias = nuevoIdioma;
		enlaceNoticiasFinal = GenerarEnlaceNoticias(categoriasNoticias);
	}

	private async Task CambiarCategoriasNoticias(string nuevaCategoria)
	{
		if (nuevaCategoria == "all")
		{
			categoriasNoticias = "all";
		}
		else
		{
            categoriasNoticias = categoriasNoticias.Replace("all", "").Replace(",,", ",").Trim(',');

			if (string.IsNullOrEmpty(categoriasNoticias) == false && categoriasNoticias.Contains(nuevaCategoria.ToLower()) == false)
			{
				categoriasNoticias = categoriasNoticias + "," + nuevaCategoria.ToLower();
			}
			else if (string.IsNullOrEmpty(categoriasNoticias) == true && categoriasNoticias.Contains(nuevaCategoria.ToLower()) == false)
			{
				categoriasNoticias = nuevaCategoria.ToLower();
			}
			else
			{
				categoriasNoticias = categoriasNoticias.Replace(nuevaCategoria.ToLower(), "").Replace(",,", ",").Trim(',');
			}
		}

        if (string.IsNullOrEmpty(categoriasNoticias) == true || categoriasNoticias.Trim() == ",")
        {
            categoriasNoticias = "all";
        }

		enlaceNoticiasFinal = GenerarEnlaceNoticias(categoriasNoticias); 
	}

	private string GenerarEnlaceNoticias(string categorias)
	{
		string enlace = "https://" + dominio + "/rss2/" + idiomaNoticias + "/" + categorias + ".xml";

		return enlace;
	}

	private async Task CambiarDeseadosCategoria(int nuevaCategoria)
	{
		categoriaDeseados = nuevaCategoria;
		enlaceDeseadosFinal = GenerarEnlaceDeseados(categoriaDeseados);
	}

    private string GenerarEnlaceDeseados(int categoria)
    {
        string enlace = "https://" + dominio + "/rss2/";

        if (usuarioRegion == TiendaRegion.Europa)
        {
            enlace = enlace + "eu/";
        }
        else if (usuarioRegion == TiendaRegion.EstadosUnidos)
        {
            enlace = enlace + "us/";
        }

        enlace = enlace + usuarioTiendasNoOficial.ToString().ToLower() + "/false/" + categoria.ToString() + "/" + usuarioId + ".xml";
        return enlace;
    }

	#endregion

	#region Barra superior

	private async Task ScrollHastaElemento(MouseEventArgs e, string div)
	{
		await JavaScript.InvokeVoidAsync("eval", @"
			const element = document.getElementById('" + div + @"');
			const elementPosition = element.getBoundingClientRect().top;
			const offsetPosition = elementPosition + window.pageYOffset - 140;

			window.scrollTo({
				top: offsetPosition,
				behavior: 'smooth'
			});
		");
	}

	#endregion
}
