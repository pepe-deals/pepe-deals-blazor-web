@page "/curator/{slug}/"

@implements IAsyncDisposable

@using APIs.Steam
@using Juegos
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Tiendas2
@using pepeizqs_deals_web.Data
@using pepeizqs_deals_blazor_web.Componentes.Interfaz

@inject IHttpContextAccessor Contexto
@inject IJSRuntime JavaScript
@inject NavigationManager Navegacion

@if (curator != null)
{
	string titulo = curator.Nombre + " (Curator)";
	string enlace = "https://" + dominio + "/curator/" + slug + "/";
	string imagen = "https://" + dominio + "/logo/logoentrada2.webp";

	string descripcion = string.Empty;

	if (string.IsNullOrEmpty(curator.DescripcionSEO) == false)
	{
		descripcion = curator.DescripcionSEO;
	}

	if (string.IsNullOrEmpty(descripcion) == true)
	{
		if (string.IsNullOrEmpty(curator.Descripcion) == false && curator.Descripcion.Length > 150)
		{
			descripcion = curator.Descripcion;
		}
	}
	
	if (string.IsNullOrEmpty(descripcion) == true || descripcion.Length < 150)
	{
		descripcion = Herramientas.Idiomas.BuscarTexto(idioma, "Subtitle", "Curators");
	}

	if (string.IsNullOrEmpty(curator.Imagen) == false)
	{
		imagen = curator.Imagen;
	}

	string keywords = "curator";

	if (curator.Nombre != null)
	{
		string[] keywordsEnBruto = Herramientas.Buscador.LimpiarNombre(curator.Nombre, false).Split(' ');
		List<string> keywordsLista = new List<string>();
		keywordsLista.AddRange(keywordsEnBruto);

		foreach (string keyword in keywordsLista)
		{
			if (keyword.Length > 3 && keywords.Contains(keyword) == false)
			{
				keywords = keywords + ", " + keyword;
			}
		}
	}

	string contenidoJson = @"{
        ""@context"": ""https://schema.org"",
		""@type"": ""ProfilePage"",
		""mainEntity"": {
			""@type"": ""Organization"",
			""name"": ""@nombreCurator"",
			""description"": ""@descripcion"",
			""image"": ""@imagen""
	";

	contenidoJson = contenidoJson.Replace("@nombreCurator", curator.Nombre);
	contenidoJson = contenidoJson.Replace("@descripcion", descripcion);
	contenidoJson = contenidoJson.Replace("@imagen", imagen);

	if (curator.Web != null)
	{
		if (string.IsNullOrEmpty(curator.Web.Enlace) == false)
		{
			contenidoJson = contenidoJson + $@",
				""sameAs"": [ ""{curator.Web.Enlace}"" ]";
		}
	}

	contenidoJson = contenidoJson + "}" + Environment.NewLine + "}";

	<Titulo tipo="@Titulo.Tipo.Curator" idioma="@idioma" dominio="@dominio" tituloCurator="@titulo" descripcionCurator="@descripcion" enlaceCurator="@enlace"
			imagenCurator="@imagen" keywords="@keywords" contenidoJsonCurator="@contenidoJson"/>

	<div class="subcabecera" style="position: relative; overflow: hidden; backdrop-filter: blur(10px);">
		@if (string.IsNullOrEmpty(curator.ImagenFondo) == false)
		{
			<div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-image: url('@Herramientas.Ficheros.Imagenes.ServidorExterno(curator.ImagenFondo)'); background-size: cover; background-position: center; opacity: 0.3; z-index: 0;"></div>
		}
    
		<div class="cuerpo-ancho sub-subcabecera" style="flex-wrap: nowrap; position: relative; z-index: 2;">
			<div style="display: flex; align-items: center; background: linear-gradient(135deg, rgba(var(--fondoBotonPequeño), 0.8), rgba(var(--fondoCuerpo), 0.9)); backdrop-filter: blur(10px); z-index: 1;">
				<img src="@Herramientas.Ficheros.Imagenes.ServidorExterno(curator.Imagen)"
					 style="width: 100px; height: 100px; border: 1px solid rgba(255,255,255,0.1); box-shadow: 0 8px 24px rgba(0,0,0,0.3);"
					 alt="@curator.Nombre" />

				<div style="display: flex; flex-direction: column; gap: 10px; padding: 20px;">
					<h1 style="font-size: 18px; margin: 0px; width: fit-content;">
						@if (curator.Web != null)
						{
							<a href="@curator.Web.Enlace" target="_blank" style="text-decoration: none;">@curator.Nombre</a>
						}
						else
						{
							@curator.Nombre
						}
					</h1>
				</div>
			</div>
		</div>
	</div>

	@if (juegosDestacados?.Count > 0)
	{
		<div class="subcabecera" style="background: color-mix(in srgb, var(--fondoSubcabecera) 45%, var(--fondoBotonPequeño)); position: sticky; top: var(--alturaCabecera); z-index: 100;">
			<div class="cuerpo-ancho" style="display: flex; align-items: center; gap: 30px; padding: 10px 0px;">
				@{
					string scroll1 = "destacados";
					string scroll2 = "filtro";
				}

				<button @onclick="(e => ScrollHastaElemento(e, scroll1))" class="boton-pequeño" style="background: transparent; width: fit-content; box-shadow: none;">
					@Herramientas.Idiomas.BuscarTexto(idioma, "String1", "Curators")
				</button>

				<button @onclick="(e => ScrollHastaElemento(e, scroll2))" class="boton-pequeño" style="background: transparent; width: fit-content; box-shadow: none;">
					@Herramientas.Idiomas.BuscarTexto(idioma, "String6", "Curators")
				</button>
			</div>
		</div>
	}
	
	<div class="cuerpo-ancho" style="display: flex; flex-direction: column; gap: 80px; margin-bottom: 40px;">
		@if (juegosDestacados?.Count > 0)
		{
			if (Herramientas.Bots.UserAgentEsBot(userAgent) == false)
			{
				<div id="destacados">
					<div style="display: flex; flex-direction: column; gap: 40px;">
						<Virtualize Context="destacado" Items="juegosDestacados">
							<ItemContent>
								<div>
									<div style="font-size: 18px; padding: 20px 25px;">
										@destacado.Nombre
									</div>

									<div class="caja-curator-contenido">
										<div style="width: 66%; aspect-ratio: 16 / 9;">
											<video class="video-autoplay" data-video-id="@destacado.Id"
												   style="width: 100%; height: 100%; object-fit: cover; display: block;"
												   autoplay muted loop playsinline preload="metadata"
												   src="@destacado.Media?.Videos[0]?.Micro"
												   typeof="video/mp4" />
										</div>

										<div style="width: 33%;">
											<a href="/game/@destacado.Id.ToString()/@Herramientas.EnlaceAdaptador.Nombre(destacado.Nombre)/" style="text-align: center;">
												<img src="@destacado.Imagenes.Header_460x215" alt="@destacado.Nombre" />
											</a>

											<div>
												<div style="padding: 20px; display: flex; flex-direction: column; gap: 20px;">
													@if (destacado.Etiquetas?.Count > 3)
													{
														<div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: center;">
															@{
																int i = 0;
																int cantidadEtiquetas = Math.Min(5, destacado.Etiquetas.Count);
																while (i < cantidadEtiquetas)
																{
																	string enlaceEtiqueta = "t" + destacado.Etiquetas[i];

																	<a href="/filter/@enlaceEtiqueta/" target="_blank" style="text-decoration: none;">
																		<div class="etiqueta-curator" style="padding: 3px 8px; font-size: 14px; border-radius: 5px; color: var(--colorTexto);">
																			@Herramientas.Idiomas.BuscarTexto(idioma, destacado.Etiquetas[i], "Tags")
																		</div>
																	</a>

																	i += 1;
																}
															}
														</div>
													}

													@if (string.IsNullOrEmpty(destacado.Analisis?.Porcentaje) == false)
													{
														<div style="display: flex; align-items: center; gap: 15px; justify-content: center;">
															@if (int.Parse(destacado.Analisis.Porcentaje) > 74)
															{
																<img src="/imagenes/analisis/positivo3.svg" style="max-width: 28px; max-height: 28px;" alt="Reviews Good" />
															}

															@if (int.Parse(destacado.Analisis.Porcentaje) > 49 && int.Parse(destacado.Analisis.Porcentaje) < 75)
															{
																<img src="/imagenes/analisis/meh3.svg" style="max-width: 28px; max-height: 28px;" alt="Reviews Meh" />
															}

															@if (int.Parse(destacado.Analisis.Porcentaje) < 50)
															{
																<img src="/imagenes/analisis/negativo3.svg" style="max-width: 28px; max-height: 28px;" alt="Reviews Bad" />
															}

															<div style="font-size: 14px;">
																@Herramientas.Calculadora.RedondearAnalisis(idioma, destacado.Analisis.Cantidad)
															</div>
														</div>
													}

													<div style="display: flex; align-items: center; gap: 20px; flex-wrap: wrap; justify-content: center; margin-top: 10px;">
														@{
															List<Juegos.JuegoPrecio> minimosMostrar = new List<JuegoPrecio>();

															@foreach (var drm in JuegoDRM2.GenerarListado())
															{
																decimal minimoCantidad = 10000000;
																Juegos.JuegoPrecio? minimoFinal = null;

																if (usuarioRegion == TiendaRegion.Europa && destacado.PrecioActualesTiendas?.Count > 0)
																{
																	foreach (var oferta in destacado.PrecioActualesTiendas)
																	{
																		bool drmAdecuado = true;

																		if (oferta.DRM != drm.Id)
																		{
																			drmAdecuado = false;
																		}
																		else if (oferta.DRM == Juegos.JuegoDRM.NoEspecificado)
																		{
																			drmAdecuado = false;
																		}
																		else if (oferta.DRM == Juegos.JuegoDRM.Microsoft)
																		{
																			drmAdecuado = false;
																		}

																		if (drmAdecuado == true)
																		{
																			if (Herramientas.OfertaActiva.Verificar(oferta) == true)
																			{
																				if (oferta.Descuento > 0)
																				{
																					decimal tempPrecio = oferta.Precio;

																					if (oferta.PrecioCambiado > 0)
																					{
																						tempPrecio = oferta.PrecioCambiado;
																					}

																					if (oferta.Moneda != Herramientas.JuegoMoneda.Euro && oferta.PrecioCambiado == 0)
																					{
																						tempPrecio = Herramientas.Divisas.CambioEuro(tempPrecio, oferta.Moneda);
																					}

																					if (tempPrecio < minimoCantidad)
																					{
																						minimoCantidad = tempPrecio;
																						minimoFinal = oferta;
																					}
																				}
																			}
																		}
																	}
																}
																else if (usuarioRegion == TiendaRegion.EstadosUnidos && destacado.PrecioActualesTiendasUS?.Count > 0)
																{
																	foreach (var oferta in destacado.PrecioActualesTiendasUS)
																	{
																		bool drmAdecuado = true;

																		if (oferta.DRM != drm.Id)
																		{
																			drmAdecuado = false;
																		}
																		else if (oferta.DRM == Juegos.JuegoDRM.NoEspecificado)
																		{
																			drmAdecuado = false;
																		}
																		else if (oferta.DRM == Juegos.JuegoDRM.Microsoft)
																		{
																			drmAdecuado = false;
																		}

																		if (drmAdecuado == true)
																		{
																			if (Herramientas.OfertaActiva.Verificar(oferta) == true)
																			{
																				if (oferta.Descuento > 0)
																				{
																					decimal tempPrecio = oferta.Precio;

																					if (oferta.PrecioCambiado > 0)
																					{
																						tempPrecio = oferta.PrecioCambiado;
																					}

																					if (oferta.Moneda != Herramientas.JuegoMoneda.Dolar && oferta.PrecioCambiado == 0)
																					{
																						tempPrecio = Herramientas.Divisas.CambioDolar(tempPrecio, oferta.Moneda);
																					}

																					if (tempPrecio < minimoCantidad)
																					{
																						minimoCantidad = tempPrecio;
																						minimoFinal = oferta;
																					}
																				}
																			}
																		}
																	}
																}

																if (minimoFinal != null)
																{
																	minimosMostrar.Add(minimoFinal);
																}
															}

															if (minimosMostrar.Count > 0)
															{
																foreach (var minimoMostrar in minimosMostrar)
																{
																	decimal minimoFinal2 = minimoMostrar.Precio;

																	if (minimoMostrar.PrecioCambiado > 0)
																	{
																		minimoFinal2 = minimoMostrar.PrecioCambiado;
																	}

																	string enlaceFinal = Herramientas.EnlaceAcortador.Generar(usuarioRegion, minimoMostrar.Enlace, minimoMostrar.Tienda, usuarioPatreon, false);

																	<a href="@enlaceFinal" class="boton-pequeño" target="_blank" style="width: fit-content; padding: 10px 20px;">
																		<div style="display: flex; align-items: center; gap: 15px;">
																			@if (minimoMostrar.DRM == JuegoDRM.DRMFree)
																			{
																				<label style="max-width: 22px; max-height: 22px; font-size: 8px; text-align: center;">DRM Free</label>
																			}
																			else
																			{
																				string iconoDRM = JuegoDRM2.SacarImagen(minimoMostrar.DRM);
																				string iconoDRM1 = iconoDRM.Replace(".webp", "-sm.webp");
																				string iconoDRM2 = iconoDRM.Replace(".webp", "-md.webp");

																				<picture>
																					<source srcset="@iconoDRM1 1x, @iconoDRM2 2x" type="image/webp">
																					<img src="@iconoDRM" alt="@JuegoDRM2.DevolverDRM(minimoMostrar.DRM)" style="max-width: 22px; max-height: 22px; display: flex;" />
																				</picture>
																			}

																			@{
																				string nombreTienda = string.Empty;
																				string iconoTienda = string.Empty;
																				List<Tiendas2.Tienda> tiendas = Tiendas2.TiendasCargar.GenerarListado();

																				foreach (var tienda in tiendas)
																				{
																					if (tienda.Id == minimoMostrar.Tienda)
																					{
																						nombreTienda = tienda.Nombre;
																						iconoTienda = tienda.ImagenIcono;
																						break;
																					}
																				}

																				string iconoTienda1 = iconoTienda.Replace(".webp", "-sm.webp");
																				string iconoTienda2 = iconoTienda.Replace(".webp", "-md.webp");

																				<picture>
																					<source srcset="@iconoTienda1 1x, @iconoTienda2 2x" type="image/webp">
																					<img src="@iconoTienda" alt="@nombreTienda" style="width: 22px; height: 22px; display: flex;" />
																				</picture>
																			}

																			@if (usuarioRegion == TiendaRegion.Europa)
																			{
																				<div>
																					@Herramientas.Precios.Euro(minimoFinal2)
																				</div>
																			}
																			else if (usuarioRegion == TiendaRegion.EstadosUnidos)
																			{
																				<div>
																					@Herramientas.Precios.Dolar(minimoFinal2)
																				</div>
																			}
																		</div>
																	</a>
																}
															}
															else if (minimosMostrar.Count == 0)
															{
																if (destacado.FreeToPlay?.ToLower() == "true" && destacado.IdSteam > 0)
																{
																	string enlaceFinal = Herramientas.EnlaceAcortador.Generar(usuarioRegion, "https://store.steampowered.com/app/" + destacado.IdSteam, "steam", usuarioPatreon, false);

																	<a href="@enlaceFinal" class="boton-pequeño" target="_blank" style="width: fit-content; padding: 10px 20px;">
																		<div style="display: flex; align-items: center; gap: 15px;">
																			<div style="display: flex;">
																				<img src="@JuegoDRM2.SacarImagen(JuegoDRM.Steam)" style="max-width: 22px; max-height: 22px;" alt="@JuegoDRM2.DevolverDRM(JuegoDRM.Steam)" />
																			</div>

																			<div>
																				@Herramientas.Idiomas.BuscarTexto(idioma, "String8", "Curators")
																			</div>
																		</div>
																	</a>
																}
																else
																{
																	<div>
																		@Herramientas.Idiomas.BuscarTexto(idioma, "String7", "Curators")
																	</div>
																}
															}
														}
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</ItemContent>
						</Virtualize>
					</div>
				</div>
			}
			else
			{
				foreach (var destacado in juegosDestacados.Take(1))
				{
					<div>
						<div style="font-size: 18px; padding: 20px 25px;">
							@destacado.Nombre
						</div>

						<div class="caja-curator-contenido">
							<div style="width: 66%; aspect-ratio: 16 / 9;">
								<video class="video-autoplay" data-video-id="@destacado.Id"
									   style="width: 100%; height: 100%; object-fit: cover; display: block;"
									   autoplay muted loop playsinline preload="metadata"
									   src="@destacado.Media.Videos[0].Micro"
									   typeof="video/mp4" />
							</div>

							<div style="width: 33%;">
								<a href="/game/@destacado.Id.ToString()/@Herramientas.EnlaceAdaptador.Nombre(destacado.Nombre)/" style="text-align: center;">
									<img src="@destacado.Imagenes.Header_460x215" alt="@destacado.Nombre" />
								</a>

								<div>
									<div style="padding: 20px; display: flex; flex-direction: column; gap: 20px;">
										@if (destacado.Etiquetas?.Count > 3)
										{
											<div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: center;">
												@{
													int i = 0;
													int cantidadEtiquetas = Math.Min(5, destacado.Etiquetas.Count);
													while (i < cantidadEtiquetas)
													{
														string enlaceEtiqueta = "t" + destacado.Etiquetas[i];

														<a href="/filter/@enlaceEtiqueta/" target="_blank" style="text-decoration: none;">
															<div class="etiqueta-curator" style="padding: 3px 8px; font-size: 14px; border-radius: 5px; color: var(--colorTexto);">
																@Herramientas.Idiomas.BuscarTexto(idioma, destacado.Etiquetas[i], "Tags")
															</div>
														</a>

														i += 1;
													}
												}
											</div>
										}

										@if (string.IsNullOrEmpty(destacado.Analisis?.Porcentaje) == false)
										{
											<div style="display: flex; align-items: center; gap: 15px; justify-content: center;">
												@if (int.Parse(destacado.Analisis.Porcentaje) > 74)
												{
													<img src="/imagenes/analisis/positivo3.svg" style="max-width: 28px; max-height: 28px;" alt="Reviews Good" />
												}

												@if (int.Parse(destacado.Analisis.Porcentaje) > 49 && int.Parse(destacado.Analisis.Porcentaje) < 75)
												{
													<img src="/imagenes/analisis/meh3.svg" style="max-width: 28px; max-height: 28px;" alt="Reviews Meh" />
												}

												@if (int.Parse(destacado.Analisis.Porcentaje) < 50)
												{
													<img src="/imagenes/analisis/negativo3.svg" style="max-width: 28px; max-height: 28px;" alt="Reviews Bad" />
												}

												<div style="font-size: 14px;">
													@Herramientas.Calculadora.RedondearAnalisis(idioma, destacado.Analisis.Cantidad)
												</div>
											</div>
										}

										<div style="display: flex; align-items: center; gap: 20px; flex-wrap: wrap; justify-content: center; margin-top: 10px;">
											@{
												List<Juegos.JuegoPrecio> minimosMostrar = new List<JuegoPrecio>();

												@foreach (var drm in JuegoDRM2.GenerarListado())
												{
													decimal minimoCantidad = 10000000;
													Juegos.JuegoPrecio? minimoFinal = null;

													if (usuarioRegion == TiendaRegion.Europa && destacado.PrecioActualesTiendas?.Count > 0)
													{
														foreach (var oferta in destacado.PrecioActualesTiendas)
														{
															bool drmAdecuado = true;

															if (oferta.DRM != drm.Id)
															{
																drmAdecuado = false;
															}
															else if (oferta.DRM == Juegos.JuegoDRM.NoEspecificado)
															{
																drmAdecuado = false;
															}
															else if (oferta.DRM == Juegos.JuegoDRM.Microsoft)
															{
																drmAdecuado = false;
															}

															if (drmAdecuado == true)
															{
																if (Herramientas.OfertaActiva.Verificar(oferta) == true)
																{
																	if (oferta.Descuento > 0)
																	{
																		decimal tempPrecio = oferta.Precio;

																		if (oferta.PrecioCambiado > 0)
																		{
																			tempPrecio = oferta.PrecioCambiado;
																		}

																		if (oferta.Moneda != Herramientas.JuegoMoneda.Euro && oferta.PrecioCambiado == 0)
																		{
																			tempPrecio = Herramientas.Divisas.CambioEuro(tempPrecio, oferta.Moneda);
																		}

																		if (tempPrecio < minimoCantidad)
																		{
																			minimoCantidad = tempPrecio;
																			minimoFinal = oferta;
																		}
																	}
																}
															}
														}
													}
													else if (usuarioRegion == TiendaRegion.EstadosUnidos && destacado.PrecioActualesTiendasUS?.Count > 0)
													{
														foreach (var oferta in destacado.PrecioActualesTiendasUS)
														{
															bool drmAdecuado = true;

															if (oferta.DRM != drm.Id)
															{
																drmAdecuado = false;
															}
															else if (oferta.DRM == Juegos.JuegoDRM.NoEspecificado)
															{
																drmAdecuado = false;
															}
															else if (oferta.DRM == Juegos.JuegoDRM.Microsoft)
															{
																drmAdecuado = false;
															}

															if (drmAdecuado == true)
															{
																if (Herramientas.OfertaActiva.Verificar(oferta) == true)
																{
																	if (oferta.Descuento > 0)
																	{
																		decimal tempPrecio = oferta.Precio;

																		if (oferta.PrecioCambiado > 0)
																		{
																			tempPrecio = oferta.PrecioCambiado;
																		}

																		if (oferta.Moneda != Herramientas.JuegoMoneda.Dolar && oferta.PrecioCambiado == 0)
																		{
																			tempPrecio = Herramientas.Divisas.CambioDolar(tempPrecio, oferta.Moneda);
																		}

																		if (tempPrecio < minimoCantidad)
																		{
																			minimoCantidad = tempPrecio;
																			minimoFinal = oferta;
																		}
																	}
																}
															}
														}
													}

													if (minimoFinal != null)
													{
														minimosMostrar.Add(minimoFinal);
													}
												}

												if (minimosMostrar.Count > 0)
												{
													foreach (var minimoMostrar in minimosMostrar)
													{
														decimal minimoFinal2 = minimoMostrar.Precio;

														if (minimoMostrar.PrecioCambiado > 0)
														{
															minimoFinal2 = minimoMostrar.PrecioCambiado;
														}

														string enlaceFinal = Herramientas.EnlaceAcortador.Generar(usuarioRegion, minimoMostrar.Enlace, minimoMostrar.Tienda, usuarioPatreon, false);

														<a href="@enlaceFinal" class="boton-pequeño" target="_blank" style="width: fit-content; padding: 10px 20px;">
															<div style="display: flex; align-items: center; gap: 15px;">
																@if (minimoMostrar.DRM == JuegoDRM.DRMFree)
																{
																	<label style="max-width: 22px; max-height: 22px; font-size: 8px; text-align: center;">DRM Free</label>
																}
																else
																{
																	string iconoDRM = JuegoDRM2.SacarImagen(minimoMostrar.DRM);
																	string iconoDRM1 = iconoDRM.Replace(".webp", "-sm.webp");
																	string iconoDRM2 = iconoDRM.Replace(".webp", "-md.webp");

																	<div style="display: flex;">
																		<picture>
																			<source srcset="@iconoDRM1 1x, @iconoDRM2 2x" type="image/webp">
																			<img src="@iconoDRM" alt="@JuegoDRM2.DevolverDRM(minimoMostrar.DRM)" style="max-width: 22px; max-height: 22px; display: block;" />
																		</picture>
																	</div>
																}

																<div style="display: flex;">
																	@{
																		string nombreTienda = string.Empty;
																		string iconoTienda = string.Empty;
																		List<Tiendas2.Tienda> tiendas = Tiendas2.TiendasCargar.GenerarListado();

																		foreach (var tienda in tiendas)
																		{
																			if (tienda.Id == minimoMostrar.Tienda)
																			{
																				nombreTienda = tienda.Nombre;
																				iconoTienda = tienda.ImagenIcono;
																				break;
																			}
																		}

																		string iconoTienda1 = iconoTienda.Replace(".webp", "-sm.webp");
																		string iconoTienda2 = iconoTienda.Replace(".webp", "-md.webp");

																		<picture>
																			<source srcset="@iconoTienda1 1x, @iconoTienda2 2x" type="image/webp">
																			<img src="@iconoTienda" alt="@nombreTienda" style="width: 22px; height: 22px; display: block;" />
																		</picture>
																	}
																</div>

																@if (usuarioRegion == TiendaRegion.Europa)
																{
																	<div>
																		@Herramientas.Precios.Euro(minimoFinal2)
																	</div>
																}
																else if (usuarioRegion == TiendaRegion.EstadosUnidos)
																{
																	<div>
																		@Herramientas.Precios.Dolar(minimoFinal2)
																	</div>
																}
															</div>
														</a>
													}
												}
												else if (minimosMostrar.Count == 0)
												{
													if (destacado.FreeToPlay?.ToLower() == "true" && destacado.IdSteam > 0)
													{
														string enlaceFinal = Herramientas.EnlaceAcortador.Generar(usuarioRegion, "https://store.steampowered.com/app/" + destacado.IdSteam, "steam", usuarioPatreon, false);

														<a href="@enlaceFinal" class="boton-pequeño" target="_blank" style="width: fit-content; padding: 10px 20px;">
															<div style="display: flex; align-items: center; gap: 15px;">
																<div style="display: flex;">
																	<img src="@JuegoDRM2.SacarImagen(JuegoDRM.Steam)" style="max-width: 22px; max-height: 22px;" alt="@JuegoDRM2.DevolverDRM(JuegoDRM.Steam)" />
																</div>

																<div>
																	@Herramientas.Idiomas.BuscarTexto(idioma, "String8", "Curators")
																</div>
															</div>
														</a>
													}
													else
													{
														<div>
															@Herramientas.Idiomas.BuscarTexto(idioma, "String7", "Curators")
														</div>
													}
												}
											}
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				}
			}
		}
		
		<div id="filtro">
			@if (juegosCurator?.Count > 0)
			{
				<div style="display: flex; flex-direction: column; gap: 30px; max-width: 1000px; margin-left: auto; margin-right: auto;">
					@if (Herramientas.Bots.UserAgentEsBot(userAgent) == false && filtrosCurator?.Count > 0)
					{
						var infoFiltros = new[]
						{
							(JuegoTipo.Game, "String2"),
							(JuegoTipo.DLC, "String3"),
							(JuegoTipo.Music, "String4"),
							(JuegoTipo.Software, "String5")
						};

						<div style="display: flex; align-items: center; gap: 30px; justify-content: center;">
							@foreach (var (tipo, textoKey) in infoFiltros)
							{
								var filtro = filtrosCurator[tipo];
                
								@if (filtro.juegos?.Count > 0)
								{
									<button @onclick="(e => MostrarListado(e, tipo))" class="pestaña-curator @(filtro.activo ? "pestaña-activa" : "")">
										<div style="display: flex; align-items: center;">
											@Herramientas.Idiomas.BuscarTexto(idioma, textoKey, "Curators") (@filtro.juegos.Count)
										</div>
									</button>
								}
							}
						</div>
					}

					<div style="display: flex; flex-direction: column; gap: 20px; margin-top: -20px;">
						<Virtualize Context="juego" Items="juegosCuratorMostrar" ItemSize="107" OverscanCount="3">
							<ItemContent>
								<CajaJuego idioma="@idioma" juego="@juego" juegosUsuarioIndex="@juegosUsuarioIndex" usuarioDeseadosImportados="@deseadosImportadosIndex" usuarioDeseadosWeb="@deseadosWebIndex" tipo="CajaJuego.Tipo.CuratorLista" userAgent="@userAgent" />
							</ItemContent>
						</Virtualize>
					</div>
				</div>
			}
		</div>
	</div>	
}

@code {

	#nullable disable

	private string idioma = "en";
	private string usuarioId = null;
	private string userAgent = null;
	private string dominio = null;

	[PersistentState] public Herramientas.UsuarioListadosJuegos juegosUsuario { get; set; }
	[PersistentState] public Herramientas.UsuarioJuegosIndex juegosUsuarioIndex { get; set; }

	[PersistentState] public Usuario deseadosUsuario { get; set; }
	[PersistentState] public Herramientas.UsuarioDeseadosImportadosIndex deseadosImportadosIndex { get; set; }
	[PersistentState] public Herramientas.UsuarioDeseadosWebIndex deseadosWebIndex { get; set; }

	private bool usuarioPatreon = false;
	private TiendaRegion usuarioRegion = TiendaRegion.Europa;

	[Parameter]
	public string slug { get; set; }

	[PersistentState] public BaseDatos.Curators.Curator curator { get; set; }
	[PersistentState] public List<Juegos.Juego> juegosCurator { get; set; }
	private List<Juegos.Juego> juegosDestacados = new List<Juegos.Juego>();

	protected override async Task OnInitializedAsync()
	{
		Herramientas.ContextoUsuarioDatos datos = Herramientas.ContextoUsuario.Leer(Contexto);
		idioma = datos.Idioma;
		usuarioId = datos.UsuarioId;
		userAgent = datos.UserAgent;
		dominio = datos.Dominio;
		usuarioRegion = datos.Region;

		if (string.IsNullOrEmpty(usuarioId) == false)
		{
			Task<string> tareaIdioma = BaseDatos.Usuarios.Buscar.IdiomaSobreescribir(usuarioId);
			Task<Herramientas.UsuarioListadosJuegos> tareaJuegos = Herramientas.UsuarioJuegos.Cargar(usuarioId);
			Task<Usuario> tareaDeseados = BaseDatos.Usuarios.Buscar.DeseadosTiene(usuarioId);
			Task<DateTime?> tareaPatreon = BaseDatos.Usuarios.Buscar.FechaPatreon(usuarioId);
			Task<int> tareaRegion = BaseDatos.Usuarios.Buscar.OpcionInt(usuarioId, "Currency");

			await Task.WhenAll(tareaIdioma, tareaJuegos, tareaDeseados, tareaPatreon, tareaRegion);

			idioma = tareaIdioma.Result;
			juegosUsuario = tareaJuegos.Result;
			deseadosUsuario = tareaDeseados.Result;
			usuarioPatreon = Herramientas.Patreon.VerificarActivo(tareaPatreon.Result);
			usuarioRegion = (TiendaRegion)tareaRegion.Result;

			if (juegosUsuarioIndex == null)
			{
				juegosUsuarioIndex = Herramientas.UsuarioJuegos.CrearIndex(juegosUsuario);
			}

			if (deseadosImportadosIndex == null)
			{
				deseadosImportadosIndex = Herramientas.Deseados.CrearImportadosIndex(deseadosUsuario);
			}

			if (deseadosWebIndex == null)
			{
				deseadosWebIndex = Herramientas.Deseados.CrearWebIndex(deseadosUsuario);
			}
		}

		if (string.IsNullOrEmpty(slug) == false)
		{
			curator ??= await BaseDatos.Curators.Buscar.Uno(slug);
		}

		if (curator == null)
		{
			Navegacion.NavigateTo("/", true);			
		}

		if (curator?.IdSteam > 0)
		{
			if (string.IsNullOrEmpty(curator.ImagenFondo) == true)
			{
				SteamCuratorAPIVanidad api = await APIs.Steam.Curator.ExtraerVanidad(curator.IdSteam.ToString());

				if (api != null)
				{
					if (string.IsNullOrEmpty(api.Imagen) == false)
					{
						BaseDatos.Curators.Actualizar.ImagenFondo(api.Imagen, curator.IdSteam);
						curator.ImagenFondo = api.Imagen;
					}
				}
			}

			if (curator.Fecha == null)
			{
				global::BaseDatos.Curators.Actualizar.Ejecutar(curator);
			}
			else
			{
				if (DateTime.Now.Subtract(curator.Fecha.Value) > TimeSpan.FromDays(90))
				{
					SteamCuratorAPI nuevoCurator = await APIs.Steam.Curator.Extraer(curator.IdSteam.ToString());

					if (nuevoCurator != null)
					{
						curator.Nombre = nuevoCurator.Nombre;
						curator.SteamIds = nuevoCurator.SteamIds;
						curator.Descripcion = nuevoCurator.Descripcion;
						curator.Imagen = nuevoCurator.Imagen;
						curator.Web = nuevoCurator.Web;

						SteamCuratorAPIVanidad api = await APIs.Steam.Curator.ExtraerVanidad(curator.IdSteam.ToString());

						if (api != null)
						{
							if (string.IsNullOrEmpty(api.Imagen) == false)
							{
								BaseDatos.Curators.Actualizar.ImagenFondo(api.Imagen, curator.IdSteam);
								curator.ImagenFondo = api.Imagen;
							}
						}

						global::BaseDatos.Curators.Actualizar.Ejecutar(curator);
					}
				}
			}

			juegosCurator ??= await global::BaseDatos.Juegos.Buscar.MultiplesJuegosSteam2(false, usuarioRegion, curator.SteamIds);

			if (juegosCurator?.Count > 0)
			{
				InicializarFiltros();

				List<Juegos.Juego> destacados = new();

				foreach (var juego in juegosCurator)
				{
					if (filtrosCurator.ContainsKey(juego.Tipo) == true)
					{
						filtrosCurator[juego.Tipo].juegos.Add(juego);

						if (juego.Tipo == JuegoTipo.Game && juego.Media?.Videos?.Count > 0 && destacados.Count < 4)
						{
							destacados.Add(juego);
						}
					}
				}

				juegosDestacados = destacados;

				JuegoTipo[] orden = new[] { JuegoTipo.Game, JuegoTipo.DLC, JuegoTipo.Music, JuegoTipo.Software };
				foreach (var tipo in orden)
				{
					if (filtrosCurator[tipo].juegos.Count > 0)
					{
						filtrosCurator[tipo].activo = true;
						break;
					}
				}
			}
		}
	}

	private IJSObjectReference moduloJs;

	protected override async Task OnAfterRenderAsync(bool primerRender)
	{
		if (primerRender == true)
		{
			moduloJs = await JavaScript.InvokeAsync<IJSObjectReference>("import", "/componentes/secciones/Curator.razor.js");

			if (moduloJs != null)
			{
				await moduloJs.InvokeVoidAsync("cargarVideos");
			}
		}
	}

	public async ValueTask DisposeAsync()
	{
		if (moduloJs != null)
		{
			try
			{
				await moduloJs.DisposeAsync();
			}
			catch { }
		}
	}

	private void MostrarListado(MouseEventArgs e, JuegoTipo tipo)
	{
		if (filtrosCurator[tipo].activo == true)
		{
			foreach (var filtro in filtrosCurator.Values)
			{
				filtro.activo = false;
			}
		}
		else
		{
			foreach (var filtro in filtrosCurator.Values)
			{
				filtro.activo = false;
			}

			filtrosCurator[tipo].activo = true;
		}
	}

	private class FiltroCurator
	{
		public JuegoTipo tipo { get; set; }
		public bool activo { get; set; }
		public List<global::Juegos.Juego> juegos { get; set; } = new();

		public string ObtenerEstilo()
		{
			return activo ? "background-color: var(--fondoBotonPequeño);" : "background-color: transparent;";
		}
	}

	private Dictionary<JuegoTipo, FiltroCurator> filtrosCurator = new();

	private void InicializarFiltros()
	{
		filtrosCurator = new Dictionary<JuegoTipo, FiltroCurator>
		{
			[JuegoTipo.Game] = new() { tipo = JuegoTipo.Game },
			[JuegoTipo.DLC] = new() { tipo = JuegoTipo.DLC },
			[JuegoTipo.Music] = new() { tipo = JuegoTipo.Music },
			[JuegoTipo.Software] = new() { tipo = JuegoTipo.Software }
		};
	}

	private List<Juegos.Juego> juegosCuratorMostrar
	{
		get
		{
			if (filtrosCurator == null || filtrosCurator.Count == 0)
			{
				return new List<Juegos.Juego>();
			}

			var filtroActivo = filtrosCurator?.Values.FirstOrDefault(f => f.activo);
			return filtroActivo?.juegos ?? new List<Juegos.Juego>();
		}
	}

	#region Barra superior

	private async Task ScrollHastaElemento(MouseEventArgs e, string div)
	{
		await JavaScript.InvokeVoidAsync("eval", @"
			const element = document.getElementById('" + div + @"');
			const elementPosition = element.getBoundingClientRect().top;
			const offsetPosition = elementPosition + window.pageYOffset - 140;

			window.scrollTo({
				top: offsetPosition,
				behavior: 'smooth'
			});
		");
	}

	#endregion
}
