@page "/last-added"

@using BaseDatos.Juegos
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using pepeizqs_deals_blazor_web.Componentes.Interfaz
@using pepeizqs_deals_web.Data

@{
	string keywords = "last, added";

	if (juegosMostrar?.Count > 0)
	{
		int i = 0;
		foreach (var juego in juegosMostrar)
		{
			if (i < 10)
			{
				string[] keywordsEnBruto = Herramientas.Buscador.LimpiarNombre(juego.Nombre, false).Split(' ');
				List<string> keywordsLista = new List<string>();
				keywordsLista.AddRange(keywordsEnBruto);

				foreach (var keyword in keywordsLista)
				{
					if (keywords.Contains(keyword) == false && keyword.Length > 3)
					{
						keywords = keywords + ", " + keyword;
					}
				}
			}
			else
			{
				break;
			}

			i += 1;
		}
	}

	<Titulo tipo="@Titulo.Tipo.UltimosAñadidos" idioma="@idioma" dominio="@dominio" keywords="@keywords"/>
}

<div class="subcabecera">
	<div class="cuerpo-ancho sub-subcabecera">
		<h1 style="font-size: 18px; width: fit-content; margin: 0px; padding: 10px 0px;">
			@Herramientas.Idiomas.BuscarTexto(idioma, "String1", "LastAdded")
		</h1>
	</div>
</div>

@if (juegosMostrar?.Count > 0)
{
	<div style="max-width: 1000px; margin: 20px auto 40px auto; display: flex; flex-direction: column; gap: 30px;">
		<Virtualize Context="juego" Items="juegosMostrar" ItemSize="107">
			<ItemContent>
				<CajaJuego idioma="@idioma" juego="@juego" juegosUsuarioIndex="@juegosUsuarioIndex" usuarioDeseadosImportados="@deseadosImportadosIndex" usuarioDeseadosWeb="@deseadosWebIndex" tipo="CajaJuego.Tipo.NuevosAñadidos" userAgent="@userAgent" />
			</ItemContent>
		</Virtualize>
	</div>
}

@code {

	#nullable disable

	[CascadingParameter] private Herramientas.ContextoUsuarioDatos datos { get; set; }

	private string idioma = "en";
	private string usuarioId = null;
	private string userAgent = null;
	private string dominio = null;

	[PersistentState] public Herramientas.UsuarioListadosJuegos juegosUsuario { get; set; }
	[PersistentState] public Herramientas.UsuarioJuegosIndex juegosUsuarioIndex { get; set; }

	[PersistentState] public Usuario deseadosUsuario { get; set; }
	[PersistentState] public Herramientas.UsuarioDeseadosImportadosIndex deseadosImportadosIndex { get; set; }
	[PersistentState] public Herramientas.UsuarioDeseadosWebIndex deseadosWebIndex { get; set; }

	[PersistentState] public List<Juegos.Juego> juegosMostrar { get; set; }

	protected override async Task OnInitializedAsync()
	{
		idioma = datos.Idioma;
		usuarioId = datos.UsuarioId;
		userAgent = datos.UserAgent;
		dominio = datos.Dominio;

		if (string.IsNullOrEmpty(usuarioId) == false)
		{
			Task<string> tareaIdioma = BaseDatos.Usuarios.Buscar.IdiomaSobreescribir(usuarioId);
			Task<Herramientas.UsuarioListadosJuegos> tareaJuegos = (juegosUsuario != null) ? Task.FromResult(juegosUsuario) : Herramientas.UsuarioJuegos.Cargar(usuarioId);
			Task<Usuario> tareaDeseados = (deseadosUsuario != null) ? Task.FromResult(deseadosUsuario) : BaseDatos.Usuarios.Buscar.DeseadosTiene(usuarioId);

			await Task.WhenAll(tareaIdioma, tareaJuegos, tareaDeseados);

			idioma = tareaIdioma.Result;
			juegosUsuario = tareaJuegos.Result;
			deseadosUsuario = tareaDeseados.Result;

			if (juegosUsuarioIndex == null)
			{
				juegosUsuarioIndex = Herramientas.UsuarioJuegos.CrearIndex(juegosUsuario);
			}

			if (deseadosImportadosIndex == null)
			{
				deseadosImportadosIndex = Herramientas.Deseados.CrearImportadosIndex(deseadosUsuario);
			}

			if (deseadosWebIndex == null)
			{
				deseadosWebIndex = Herramientas.Deseados.CrearWebIndex(deseadosUsuario);
			}
		}

		juegosMostrar ??= await Buscar.Ultimos("juegos", 500);
	}
}
