									<div style="display: flex; align-items: center; gap: 10px;">
										@if (int.Parse(categoria.Id) < 64)
										{
											<div style="max-width: 30px;">
												@{
													string imagenCategoria = "/imagenes/categorias/" + categoria.Id + ".webp";
												}

												<img src="@imagenCategoria" style="width: 100%; height: 100%; display: block;" alt="@categoria.Contenido"/>
											</div>
										}

										<div style="width: 100%; font-size: 14px;">
											@categoria.Contenido
										</div>
									</div>
								</button>
							}
						</div>
					}
				</div>
			}

			@if (accesibilidad?.Count > 0)
			{
				string letra = "a";

				<div>
					<button @onclick="(e => AbrirAccesibilidad(e))" style="background-color: transparent; color: var(--colorTexto); border: 0px; width: 100%; text-align: center; padding: 10px; background-color: var(--fondoBotonPequeño);">
						<div style="display: flex; align-items: center;">
							<div style="width: 100%;">
								@Herramientas.Idiomas.BuscarTexto(idioma, "String10", "Filter") (@CantidadIDs(letra))
							</div>

							<div>
								@if (enseñarAccesibilidad == true)
								{
									<div style="max-width: 16px;">
										<svg class="svg-boton" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
											<path d="M233.4 105.4c12.5-12.5 32.8-12.5 45.3 0l192 192c12.5 12.5 12.5 32.8 0 45.3s-32.8 12.5-45.3 0L256 173.3 86.6 342.6c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3l192-192z" />
										</svg>
									</div>
								}
								else
								{
									<div style="max-width: 16px;">
										<svg class="svg-boton" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
											<path d="M233.4 406.6c12.5 12.5 32.8 12.5 45.3 0l192-192c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L256 338.7 86.6 169.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l192 192z" />
										</svg>
									</div>
								}
							</div>
						</div>
					</button>

					@if (enseñarAccesibilidad == true)
					{
						<div class="caja-filtro-contenido" style="display: flex; flex-direction: column; gap: 10px;">
							@foreach (var acceso in accesibilidad)
							{
								string fondo = string.Empty;

								if (idsLista?.Count > 0)
								{
									foreach (var id2 in idsLista)
									{
										if (letra + acceso.Id == id2)
										{
											fondo = "background-color: var(--fondoBotonPequeño);";
											break;
										}
									}
								}

								<button @onclick="(e => CambiarIDs(e, acceso.Id, letra))" class="boton-expandir" style="color: var(--colorTexto); border: 0px; width: 100%; text-align: center; padding: 10px; @fondo">
									<div style="display: flex; align-items: center; gap: 10px;">
										<div style="width: 100%; font-size: 14px;">
											@acceso.Contenido
										</div>
									</div>
								</button>
							}
						</div>
					}
				</div>
			}
		</div>

		@if (resultadosGestor?.Count > 0)
		{
			<div style="width: 100%;">
				<div style="margin: -30px 0px; display: flex; flex-direction: column; gap: 30px;">
					<Virtualize Context="juego" Items="@resultadosGestor">
						<ItemContent>
							<CajaJuego idioma="@idioma" juego="@juego" juegosUsuarioIndex="@juegosUsuarioIndex" usuarioDeseadosImportados="@deseadosImportadosIndex" usuarioDeseadosWeb="@deseadosWebIndex" tipo="CajaJuego.Tipo.Filtro" userAgent="@userAgent" />
						</ItemContent>
					</Virtualize>
				</div>

				@if (Herramientas.Bots.UserAgentEsBot(userAgent) == false)
				{
					<div style="margin-top: 40px; width: 100%; display: flex; align-items: center; gap: 20px; justify-content: center;">
						@if (cargandoMas == false)
						{
							<button class="boton-pequeño" @onclick="CargarMasResultados" style="width: fit-content; padding: 10px 25px;">
								@Herramientas.Idiomas.BuscarTexto(idioma, "String11", "Filter")
							</button>
						}
						else
						{
							<div style="padding: 10px 25px;">
								@Herramientas.Idiomas.BuscarTexto(idioma, "String12", "Filter")
							</div>
						}
					</div>
				}
			</div>
		}
	</div>
}

@code {

	#nullable disable

	[Parameter]
	public string ids { get; set; }

	private string idioma = "en";
	private string usuarioId = null;
	private string userAgent = null;
	private string dominio = null;

	[PersistentState] public Herramientas.UsuarioListadosJuegos juegosUsuario { get; set; }
	[PersistentState] public Herramientas.UsuarioJuegosIndex juegosUsuarioIndex { get; set; }

	[PersistentState] public Usuario deseadosUsuario { get; set; }
	[PersistentState] public Herramientas.UsuarioDeseadosImportadosIndex deseadosImportadosIndex { get; set; }
	[PersistentState] public Herramientas.UsuarioDeseadosWebIndex deseadosWebIndex { get; set; }

	private string descripcion = string.Empty;

	private bool cargado = false;

	private List<string> idsLista = new List<string>();

	[PersistentState] public List<Juegos.Juego> resultadosGestor { get; set; }

	protected override async Task OnInitializedAsync()
	{
		cargado = false;

		Herramientas.ContextoUsuarioDatos datos = Herramientas.ContextoUsuario.Leer(Contexto);
		idioma = datos.Idioma;
		usuarioId = datos.UsuarioId;
		userAgent = datos.UserAgent;
		dominio = datos.Dominio;

		if (string.IsNullOrEmpty(usuarioId) == false)
		{
			Task<string> tareaIdioma = BaseDatos.Usuarios.Buscar.IdiomaSobreescribir(usuarioId);
			Task<Herramientas.UsuarioListadosJuegos> tareaJuegos = (juegosUsuario != null) ? Task.FromResult(juegosUsuario) : Herramientas.UsuarioJuegos.Cargar(usuarioId);
			Task<Usuario> tareaDeseados = (deseadosUsuario != null) ? Task.FromResult(deseadosUsuario) : BaseDatos.Usuarios.Buscar.DeseadosTiene(usuarioId);

			await Task.WhenAll(tareaIdioma, tareaJuegos, tareaDeseados);

			idioma = tareaIdioma.Result;
			juegosUsuario = tareaJuegos.Result;
			deseadosUsuario = tareaDeseados.Result;

			if (juegosUsuarioIndex == null)
			{
				juegosUsuarioIndex = Herramientas.UsuarioJuegos.CrearIndex(juegosUsuario);
			}

			if (deseadosImportadosIndex == null)
			{
				deseadosImportadosIndex = Herramientas.Deseados.CrearImportadosIndex(deseadosUsuario);
			}

			if (deseadosWebIndex == null)
			{
				deseadosWebIndex = Herramientas.Deseados.CrearWebIndex(deseadosUsuario);
			}			
		}

		Task tareaDeck = CargarDeck();
		Task tareaTipos = CargarTipos();
		Task tareaSistemas = CargarSistemas();
		Task tareaEtiquetas = CargarEtiquetas();
		Task tareaCategoriasyAccesibilidad = CargarCategoriasyAccesibilidad();

		await Task.WhenAll(tareaDeck, tareaTipos, tareaSistemas, tareaEtiquetas, tareaCategoriasyAccesibilidad);

		idsLista = Herramientas.Listados.Generar(ids);

		if (idsLista?.Count > 0)
		{
			if (idsLista[0].Contains("d") == true)
			{
				string idBuscar = idsLista[0];
				idBuscar = idBuscar.Replace("d", null);

				descripcion = Herramientas.Idiomas.BuscarTexto("en", "seo-Deck" + idBuscar, "Filter");
			}

			if (idsLista[0].Contains("s") == true)
			{
				string idBuscar = idsLista[0];
				idBuscar = idBuscar.Replace("s", null);

				descripcion = Herramientas.Idiomas.BuscarTexto("en", "seo-System" + idBuscar, "Filter");
			}

			if (idsLista[0].Contains("i") == true)
			{
				string idBuscar = idsLista[0];
				idBuscar = idBuscar.Replace("i", null);

				descripcion = Herramientas.Idiomas.BuscarTexto("en", "seo-Type" + idBuscar, "Filter");
			}

			if (idsLista[0].Contains("t") == true)
			{
				string idBuscar = idsLista[0];
				idBuscar = idBuscar.Replace("t", null);

				descripcion = Herramientas.Idiomas.BuscarTexto("en", "seo-" + idBuscar, "Tags");
			}

			if (idsLista[0].Contains("c") == true || idsLista[0].Contains("a") == true)
			{
				string idBuscar = idsLista[0];
				idBuscar = idBuscar.Replace("c", null);
				idBuscar = idBuscar.Replace("a", null);

				descripcion = Herramientas.Idiomas.BuscarTexto("en", "seo-" + idBuscar, "Categories");
			}

			if (string.IsNullOrEmpty(descripcion) == true)
			{
				Navegacion.NavigateTo("/", true);
			}

			foreach (var id in idsLista)
			{
				if (string.IsNullOrEmpty(id) == false)
				{
					if (id.Contains("d") == true)
					{
						enseñarDeck = true;
					}

					if (id.Contains("i") == true)
					{
						enseñarTipos = true;
					}

					if (id.Contains("s") == true)
					{
						enseñarSistemas = true;
					}

					if (id.Contains("t") == true)
					{
						enseñarEtiquetas = true;
					}

					if (id.Contains("c") == true)
					{
						enseñarCategorias = true;
					}

					if (id.Contains("a") == true)
					{
						enseñarAccesibilidad = true;
					}
				}
			}
		}

		if (string.IsNullOrEmpty(descripcion) == true)
		{
			descripcion = Herramientas.Idiomas.BuscarTexto("en", "seo-Filter", "Filter");
		}

		resultadosGestor ??= await BaseDatos.Juegos.Buscar.Filtro(idsLista, posicion);

		cargado = true;
	}

	private IJSObjectReference moduloJs;

	protected override async Task OnAfterRenderAsync(bool primerRender)
	{
		if (primerRender == true)
		{
			moduloJs = await JavaScript.InvokeAsync<IJSObjectReference>("import", "/componentes/secciones/Filtro.razor.js");
		}
	}

	public async ValueTask DisposeAsync()
	{
		if (moduloJs != null)
		{
			try
			{
				await moduloJs.DisposeAsync();
			}
			catch { }
		}
	}

	private class FiltroItem
	{
		public string Id { get; set; }
		public string Contenido { get; set; }
	}

	private async Task CambiarIDs(MouseEventArgs e, string nuevaId, string letra)
	{
		nuevaId = letra + nuevaId;

		bool encontrado = false;

		int i = 0;
		if (idsLista?.Count > 0)
		{
			foreach (var id in idsLista)
			{
				if (id == nuevaId)
				{
					encontrado = true;
					break;
				}

				i += 1;
			}
		}

		if (encontrado == false)
		{
			if (idsLista == null)
			{
				idsLista = new List<string>();
			}

			idsLista.Add(nuevaId);
		}
		else
		{
			idsLista.RemoveAt(i);
		}

		ids = null;

		foreach (var id in idsLista)
		{
			ids = ids + "," + id;
		}

		if (string.IsNullOrEmpty(ids) == false)
		{
			ids = ids.Remove(0, 1);
		}

		resultadosGestor = await BaseDatos.Juegos.Buscar.Filtro(idsLista, 250);

		if (moduloJs != null)
		{
			if (string.IsNullOrEmpty(ids) == false)
			{
				await moduloJs.InvokeVoidAsync("cambiarEnlace", "/filter/" + ids + "/");
			}
			else
			{
				await moduloJs.InvokeVoidAsync("cambiarEnlace", "/filter/");
			}
		}

		await InvokeAsync(StateHasChanged);
	}

	private int CantidadIDs(string letra)
	{
		int i = 0;

		if (idsLista?.Count > 0)
		{
			foreach (var id in idsLista)
			{
				if (id.Contains(letra) == true)
				{
					i += 1;
				}
			}
		}

		return i;
	}

	#region Deck

	private List<FiltroItem> decks = new List<FiltroItem>();

	private async Task CargarDeck()
	{
		List<string> cadenas = new List<string>();
		cadenas.Add("2");
		cadenas.Add("3");

		foreach (var cadena in cadenas)
		{
			FiltroItem nuevoDeck = new FiltroItem();
			nuevoDeck.Id = cadena;
			nuevoDeck.Contenido = Herramientas.Idiomas.BuscarTexto(idioma, "Deck" + cadena, "Filter");

			decks.Add(nuevoDeck);
		}
	}

	private bool enseñarDeck = false;

	private void AbrirDeck(MouseEventArgs e)
	{
		if (enseñarDeck == true)
		{
			enseñarDeck = false;
		}
		else
		{
			enseñarDeck = true;
		}
	}

	#endregion

	#region Tipos

	private List<FiltroItem> tipos = new List<FiltroItem>();

	private async Task CargarTipos()
	{
		List<string> cadenas = new List<string>();
		cadenas.Add("0");
		cadenas.Add("1");
		cadenas.Add("3");
		cadenas.Add("4");

		foreach (var cadena in cadenas)
		{
			FiltroItem nuevoTipo = new FiltroItem();
			nuevoTipo.Id = cadena;
			nuevoTipo.Contenido = Herramientas.Idiomas.BuscarTexto(idioma, "Type" + cadena, "Filter");

			tipos.Add(nuevoTipo);
		}
	}

	private bool enseñarTipos = false;

	private void AbrirTipos(MouseEventArgs e)
	{
		if (enseñarTipos == true)
		{
			enseñarTipos = false;
		}
		else
		{
			enseñarTipos = true;
		}
	}

	#endregion

	#region Sistemas

	private List<FiltroItem> sistemas = new List<FiltroItem>();

	private async Task CargarSistemas()
	{
		List<string> cadenas = new List<string>();
		cadenas.Add("1");
		cadenas.Add("2");
		cadenas.Add("3");

		foreach (var cadena in cadenas)
		{
			FiltroItem nuevoSistema = new FiltroItem();
			nuevoSistema.Id = cadena;
			nuevoSistema.Contenido = Herramientas.Idiomas.BuscarTexto(idioma, "System" + cadena, "Filter");

			sistemas.Add(nuevoSistema);
		}
	}

	private bool enseñarSistemas = false;

	private void AbrirSistemas(MouseEventArgs e)
	{
		if (enseñarSistemas == true)
		{
			enseñarSistemas = false;
		}
		else
		{
			enseñarSistemas = true;
		}
	}

	#endregion

	#region Etiquetas

	private List<FiltroItem> etiquetas = new List<FiltroItem>();

	private async Task CargarEtiquetas()
	{
		string json = Herramientas.Idiomas.CogerTodo(idioma, "Tags");

		if (string.IsNullOrEmpty(json) == false)
		{
			var items2 = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(json);

			foreach (var item2 in items2)
			{
				FiltroItem nuevaEtiqueta = new FiltroItem();
				nuevaEtiqueta.Id = item2.Key;
				nuevaEtiqueta.Contenido = item2.Value.ToString();

				etiquetas.Add(nuevaEtiqueta);
			}
		}
	}

	private bool enseñarEtiquetas = false;

	private void AbrirEtiquetas(MouseEventArgs e)
	{
		if (enseñarEtiquetas == true)
		{
			enseñarEtiquetas = false;
		}
		else
		{
			enseñarEtiquetas = true;
		}
	}

	#endregion

	#region Categorias y Accesibilidad

	private List<FiltroItem> categorias = new List<FiltroItem>();
	private List<FiltroItem> accesibilidad = new List<FiltroItem>();

	private async Task CargarCategoriasyAccesibilidad()
	{
		string json = Herramientas.Idiomas.CogerTodo(idioma, "Categories");

		if (string.IsNullOrEmpty(json) == false)
		{
			var items2 = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(json);

			foreach (var item2 in items2)
			{
				if (item2.Key.Contains("seo-") == false)
				{
					if (int.Parse(item2.Key) < 64)
					{
						FiltroItem nuevaCategoria = new FiltroItem();
						nuevaCategoria.Id = item2.Key;
						nuevaCategoria.Contenido = item2.Value.ToString();
						categorias.Add(nuevaCategoria);
					}
					else
					{
						FiltroItem nuevaAccesibilidad = new FiltroItem();
						nuevaAccesibilidad.Id = item2.Key;
						nuevaAccesibilidad.Contenido = item2.Value.ToString();
						accesibilidad.Add(nuevaAccesibilidad);
					}
				}
			}
		}
	}

	private bool enseñarCategorias = false;

	private void AbrirCategorias(MouseEventArgs e)
	{
		if (enseñarCategorias == true)
		{
			enseñarCategorias = false;
		}
		else
		{
			enseñarCategorias = true;
		}
	}

	private bool enseñarAccesibilidad = false;

	private void AbrirAccesibilidad(MouseEventArgs e)
	{
		if (enseñarAccesibilidad == true)
		{
			enseñarAccesibilidad = false;
		}
		else
		{
			enseñarAccesibilidad = true;
		}
	}

	#endregion

	private int posicion = 0;
	private bool cargandoMas = false;

	private async Task CargarMasResultados()
	{
		posicion = posicion + 50;

		cargandoMas = true;

		resultadosGestor.AddRange(await BaseDatos.Juegos.Buscar.Filtro(idsLista, posicion));

		cargandoMas = false;
	}
}
