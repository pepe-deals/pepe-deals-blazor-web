@code {

    #nullable disable

    [Parameter]
    public string idioma { get; set; }

    [Parameter]
    public string usuarioId { get; set; }

    private Usuario usuario = new Usuario();

    private int cantidadJuegos = 0;

    private bool trabajando = false;
    private int importados = 0;

    protected override async Task OnInitializedAsync()
    {
        usuario = await BaseDatos.Usuarios.Buscar.OpcionesAmazon(usuarioId);

        if (usuario != null)
        {
            if (string.IsNullOrEmpty(usuario.AmazonGames) == false)
            {
                cantidadJuegos = Herramientas.Listados.Generar(usuario.AmazonGames)?.Count ?? 0;
            }
        }
    }

    private IJSObjectReference moduloJs;

	protected override async Task OnAfterRenderAsync(bool primerRender)
	{
		if (primerRender == true)
		{
            try
            {
                moduloJs = await JavaScript.InvokeAsync<IJSObjectReference>("import", "/componentes/cuenta/juegos/Amazon.razor.js");
            }
            catch { }
		}
	}

	public async ValueTask DisposeAsync()
	{
		if (moduloJs != null)
		{
			try
			{
				await moduloJs.DisposeAsync();
			}
			catch { }
		}
	}

    private void CerrarPestañas()
    {
        mostrarAmazon = false;
        mostrarGogGalaxy = false;
        mostrarPlaynite = false;
        mostrarHeroicGames = false;
    }

    private bool mostrarAmazon = false;

    private void MostrarAmazon(MouseEventArgs e)
    {
        CerrarPestañas();
        mostrarAmazon = true;
    }

    private bool mostrarGogGalaxy = false;

    private void MostrarGogGalaxy(MouseEventArgs e)
    {
        CerrarPestañas();
        mostrarGogGalaxy = true;
    }

    private bool mostrarPlaynite = false;

    private void MostrarPlaynite(MouseEventArgs e)
    {
        CerrarPestañas();
        mostrarPlaynite = true;
    }

    private bool mostrarHeroicGames = false;

    private void MostrarHeroicGames(MouseEventArgs e)
    {
        CerrarPestañas();
        mostrarHeroicGames = true;
    }

    private async Task AmazonCargarFichero(InputFileChangeEventArgs e)
    {
        trabajando = true;

        if (e.File.Name.ToLower().Contains("gameuserinteractionsinfo") == true)
        {
            importados = 0;
            importados = await Herramientas.Ficheros.Amazon.Cargar(e.File, usuario.Id);
        }

        trabajando = false;

        await InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }

    private async Task GogGalaxyCargarFichero(InputFileChangeEventArgs e)
    {
        trabajando = true;

        if (e.File.Name.ToLower().Contains("galaxy-2.0") == true)
        {
            importados = 0;
            importados = await Herramientas.Ficheros.GogGalaxy.Cargar(JuegoDRM.Amazon, e.File, usuario.Id);
        }

        trabajando = false;

        await InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }

    private async Task PlayniteCargarFichero(InputFileChangeEventArgs e)
    {
        trabajando = true;

        if (e.File.Name.ToLower().Contains("games") == true)
        {
            importados = 0;
            importados = await Herramientas.Ficheros.Playnite.Cargar(JuegoDRM.Amazon, e.File, usuarioId);
        }

        trabajando = false;

        await InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }

    private async Task HeroicGamesCargarFichero(InputFileChangeEventArgs e)
    {
        trabajando = true;

        if (e.File.Name.ToLower().Contains("library") == true)
        {
            importados = 0;
            importados = await Herramientas.Ficheros.HeroicGames.Cargar(JuegoDRM.Amazon, e.File, usuarioId);
        }

        trabajando = false;

        await InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }

    private async Task ClickearBorrarJuegos(MouseEventArgs args)
    {
        usuario.AmazonGames = null;
        cantidadJuegos = 0;

        usuario.Id = usuarioId;
        await BaseDatos.Usuarios.Actualizar.Amazon(usuario);
    }

    private async Task ActivarTooltip(string triggerId, string tooltipId)
	{
		if (moduloJs != null)
		{
            try
            {
                await moduloJs.InvokeVoidAsync("activarTooltip", triggerId, tooltipId);
            }
            catch { }
		}
	}

	private async Task DesactivarTooltip(string triggerId)
	{
		if (moduloJs != null)
		{
            try
            {
                await moduloJs.InvokeVoidAsync("desactivarTooltip", triggerId);
            }
            catch { }
		}
	}
}
