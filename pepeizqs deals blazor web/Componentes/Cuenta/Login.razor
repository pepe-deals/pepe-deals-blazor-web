<Accesos idioma="@idioma" mostrarLogin="false" />

@code {

    #nullable disable

    [CascadingParameter] private Herramientas.ContextoUsuarioDatos datos { get; set; }

    private string idioma = "en";
    private string usuarioId = null;
    private string userAgent = null;
    private string dominio = null;

    private string mensajeError = string.Empty;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; }

    [SupplyParameterFromQuery]
    private string ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string code { get; set; }

    [SupplyParameterFromQuery]
    private bool steam1 { get; set; }

    [SupplyParameterFromQuery]
    private bool steam2 { get; set; }

    [SupplyParameterFromQuery]
    private string error { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        idioma = datos.Idioma;
        usuarioId = datos.UsuarioId;
        userAgent = datos.UserAgent;
        dominio = datos.Dominio;

        if (string.IsNullOrEmpty(usuarioId) == false)
        {
            NavManager.NavigateTo("/", true);
        }

        if (Contexto.HttpContext != null)
        {
            if (HttpMethods.IsGet(Contexto.HttpContext.Request.Method))
            {
                try
                {
                    await Contexto.HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
                }
                catch { }
            }
        } 
    }

    public async Task LoginUser()
    {
        SignInResult resultado = null;

        try
        {
            resultado = await SignInManager.PasswordSignInAsync(Input.Email, Input.Password, Input.RememberMe, lockoutOnFailure: false);
        }
        catch { }

        if (resultado != null)
        {
            if (resultado.Succeeded == true)
            {
                NavManager.NavigateTo("/", true);
            }
            else if (resultado.RequiresTwoFactor == true)
            {
                string returnUrlSafe = ReturnUrl ?? "/";
                NavManager.NavigateTo($"/account/login2fa?rememberMe={Input.RememberMe}&returnUrl={Uri.EscapeDataString(returnUrlSafe)}", true);
            }
            else
            {
                mensajeError = Herramientas.Idiomas.BuscarTexto(idioma, "String9", "Login");
            }
        }
        else
        {
            mensajeError = Herramientas.Idiomas.BuscarTexto(idioma, "String8", "Login");
        }
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [Display(Name = "Remember me?")]
        public bool RememberMe { get; set; }
    }
}
