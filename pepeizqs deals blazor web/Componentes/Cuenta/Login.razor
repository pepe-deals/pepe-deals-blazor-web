@page "/account/login"

@attribute [ExcludeFromInteractiveRouting]

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using pepeizqs_deals_web.Data

@inject IHttpContextAccessor Contexto
@inject SignInManager<Usuario> SignInManager
@inject NavigationManager NavigationManager
@inject NavigationManager NavManager

@{
    string titulo = Herramientas.Idiomas.BuscarTexto(idioma, "Title", "Login") + " • pepe's deals";
    string enlace = "https://" + dominio + "/login";
    string imagen = "https://" + dominio + "/logo/logoentrada.webp";
}

<HeadContent>
    <PageTitle>@titulo</PageTitle>

    <meta name="og:title" content="@titulo" />
    <meta name="og:url" content="@enlace" />
    <meta name="og:image" content="@imagen" />
    <meta name="og:site_name" content="pepe's deals" />
    <meta name="og:type" content="website" />
    <meta name="robots" content="index, follow" />
</HeadContent>

@if (steam1 == true || steam2 == true)
{
    <div style="margin: 40px auto 0px auto; background-color: var(--fondoPeligro); padding: 15px 20px; text-align: center; max-width: 600px;">
        @Herramientas.Idiomas.BuscarTexto(idioma, "String10", "Login")
    </div>
}

@if (string.IsNullOrEmpty(error) == false && code == "steam")
{
    <div style="margin: 40px auto 0px auto; background-color: var(--fondoPeligro); padding: 15px 20px; text-align: center; max-width: 600px;">
        @Herramientas.Idiomas.BuscarTexto(idioma, "String21", "Login")
    </div>
}

@if (string.IsNullOrEmpty(mensajeError) == false)
{
    <div style="margin: 40px auto 0px auto; background-color: var(--fondoPeligro); padding: 15px 20px; text-align: center; max-width: 600px;">
        @mensajeError
    </div>
}

@if (string.IsNullOrEmpty(code) == false && code == "registered")
{
    <div style="margin: 40px auto 0px auto; background-color: var(--fondoBien); padding: 15px 20px; text-align: center; max-width: 600px;">
        @Herramientas.Idiomas.BuscarTexto(idioma, "String10", "Login")
    </div>
}

<div class="caja-login-contenido" style="margin: 40px auto;">
    <EditForm Model="Input" method="post" OnValidSubmit="LoginUser" FormName="login" style="border-top-left-radius: inherit; border-top-right-radius: inherit; margin: 0;">
        <DataAnnotationsValidator />
        <div class="caja-login-titulo">
            @Herramientas.Idiomas.BuscarTexto(idioma, "String1", "Login")
        </div>

        <div style="padding: 30px 40px 40px 40px;">
            <ValidationSummary class="texto-peligro-entrada" role="alert" />

            <div style="margin-bottom: 20px;">
                <div for="Input.Email" style="margin-bottom: 5px; margin-left: 10px;">@Herramientas.Idiomas.BuscarTexto(idioma, "String2", "Login")</div>
                <InputText @bind-Value="Input.Email" id="Input.Email" class="entrada-texto" autocomplete="username" aria-required="true" placeholder="@Herramientas.Idiomas.BuscarTexto(idioma, "String4", "Login")" />

                <ValidationMessage For="() => Input.Email" class="texto-peligro-entrada" />
            </div>

            <div style="margin-bottom: 20px;">
                <div for="Input.Password" style="margin-bottom: 5px; margin-left: 10px;">@Herramientas.Idiomas.BuscarTexto(idioma, "String3", "Login")</div>
                <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="entrada-texto" autocomplete="current-password" aria-required="true" placeholder="@Herramientas.Idiomas.BuscarTexto(idioma, "String5", "Login")" />

                <ValidationMessage For="() => Input.Password" class="texto-peligro-entrada" />
            </div>

            <div style="margin: 30px 0px 20px 0px;">
                <div style="display: flex; align-items: center; gap: 15px;">
                    <div class="checkbox-caja">
                        <InputCheckbox @bind-Value="Input.RememberMe" class="checkbox-interior" />
                    </div>

                    <div style="cursor: pointer;">
                        @Herramientas.Idiomas.BuscarTexto(idioma, "String6", "Login")
                    </div>
                </div>
            </div>

            @if (Herramientas.Bots.UserAgentEsBot(userAgent) == false)
            {
                <div>
                    <button id="login-submit" type="submit" class="boton-pequeño" style="text-align: center; font-size: 20px; padding: 15px 20px;">
                        @Herramientas.Idiomas.BuscarTexto(idioma, "String7", "Login")
                    </button>
                </div>
            }
        </div>    
    </EditForm>
</div>

