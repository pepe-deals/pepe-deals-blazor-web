            <div class="sidebar-separador"></div>

            <div class="sidebar-seccion">
                <button @onclick="MostrarJuegos" class="sidebar-item @(seccion == "games" ? "sidebar-item-activo" : "")">
                    <div class="sidebar-item-icono">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path d="M448 128C554 128 640 214 640 320C640 426 554 512 448 512L192 512C86 512 0 426 0 320C0 214 86 128 192 128L448 128zM192 240C178.7 240 168 250.7 168 264L168 296L136 296C122.7 296 112 306.7 112 320C112 333.3 122.7 344 136 344L168 344L168 376C168 389.3 178.7 400 192 400C205.3 400 216 389.3 216 376L216 344L248 344C261.3 344 272 333.3 272 320C272 306.7 261.3 296 248 296L216 296L216 264C216 250.7 205.3 240 192 240zM432 336C414.3 336 400 350.3 400 368C400 385.7 414.3 400 432 400C449.7 400 464 385.7 464 368C464 350.3 449.7 336 432 336zM496 240C478.3 240 464 254.3 464 272C464 289.7 478.3 304 496 304C513.7 304 528 289.7 528 272C528 254.3 513.7 240 496 240z" /></svg>
                    </div>
                    <span>@Herramientas.Idiomas.BuscarTexto(idioma, "String35", "Account")</span>
                </button>

                <button @onclick="MostrarJuegosExcluir" class="sidebar-item @(seccion == "excluded-games" ? "sidebar-item-activo" : "")">
                    <div class="sidebar-item-icono">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path d="M431.2 476.5L163.5 208.8C141.1 240.2 128 278.6 128 320C128 426 214 512 320 512C361.5 512 399.9 498.9 431.2 476.5zM476.5 431.2C498.9 399.8 512 361.4 512 320C512 214 426 128 320 128C278.5 128 240.1 141.1 208.8 163.5L476.5 431.2zM64 320C64 178.6 178.6 64 320 64C461.4 64 576 178.6 576 320C576 461.4 461.4 576 320 576C178.6 576 64 461.4 64 320z" /></svg>
                    </div>
                    <span>@Herramientas.Idiomas.BuscarTexto(idioma, "String39", "Account")</span>
                </button>

                <button @onclick="MostrarPerfil" class="sidebar-item @(seccion == "profile" ? "sidebar-item-activo" : "")">
                    <div class="sidebar-item-icono">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path d="M320 312C386.3 312 440 258.3 440 192C440 125.7 386.3 72 320 72C253.7 72 200 125.7 200 192C200 258.3 253.7 312 320 312zM290.3 368C191.8 368 112 447.8 112 546.3C112 562.7 125.3 576 141.7 576L498.3 576C514.7 576 528 562.7 528 546.3C528 447.8 448.2 368 349.7 368L290.3 368z" /></svg>
                    </div>
                    <span>@Herramientas.Idiomas.BuscarTexto(idioma, "String33", "Account")</span>
                </button>
            </div>
        </nav>

        <select class="cuenta-select-mobile" @onchange="CambiarSeccionMovil">
            <optgroup label="@Herramientas.Idiomas.BuscarTexto(idioma, "SidebarCuenta", "Account")">
                <option value="email" selected="@(seccion == "email")">@Herramientas.Idiomas.BuscarTexto(idioma, "String2", "Account")</option>
                <option value="password" selected="@(seccion == "password")">@Herramientas.Idiomas.BuscarTexto(idioma, "String4", "Account")</option>
                <option value="data" selected="@(seccion == "data")">@Herramientas.Idiomas.BuscarTexto(idioma, "String7", "Account")</option>
                <option value="language" selected="@(seccion == "language")">@Herramientas.Idiomas.BuscarTexto(idioma, "String24", "Account")</option>
                <option value="keys" selected="@(seccion == "keys")">@Herramientas.Idiomas.BuscarTexto(idioma, "String6", "Account")</option>
                <option value="mail-patreon" selected="@(seccion == "mail-patreon")">@Herramientas.Idiomas.BuscarTexto(idioma, "String37", "Account")</option>
                <option value="authenticator" selected="@(seccion == "authenticator")">@Herramientas.Idiomas.BuscarTexto(idioma, "String41", "Account")</option>
            </optgroup>
            <optgroup label="@Herramientas.Idiomas.BuscarTexto(idioma, "SidebarNotificaciones", "Account")">
                <option value="notifications-email" selected="@(seccion == "notifications-email")">@Herramientas.Idiomas.BuscarTexto(idioma, "String3", "Account")</option>
                <option value="notifications-push" selected="@(seccion == "notifications-push")">@Herramientas.Idiomas.BuscarTexto(idioma, "String21", "Account")</option>
            </optgroup>
            <optgroup label="@Herramientas.Idiomas.BuscarTexto(idioma, "SidebarJuegos", "Account")">
                <option value="games" selected="@(seccion == "games")">@Herramientas.Idiomas.BuscarTexto(idioma, "String35", "Account")</option>
                <option value="excluded-games" selected="@(seccion == "excluded-games")">@Herramientas.Idiomas.BuscarTexto(idioma, "String39", "Account")</option>
                <option value="profile" selected="@(seccion == "profile")">@Herramientas.Idiomas.BuscarTexto(idioma, "String33", "Account")</option>
            </optgroup>
        </select>

        <div class="cuenta-contenido">
            @if (string.IsNullOrEmpty(seccion) == true)
            {
                <div class="cuenta-contenido-vacio">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" style="width: 48px; height: 48px; opacity: 0.2; fill: var(--colorTexto);"><path d="M320 312C386.3 312 440 258.3 440 192C440 125.7 386.3 72 320 72C253.7 72 200 125.7 200 192C200 258.3 253.7 312 320 312zM290.3 368C191.8 368 112 447.8 112 546.3C112 562.7 125.3 576 141.7 576L498.3 576C514.7 576 528 562.7 528 546.3C528 447.8 448.2 368 349.7 368L290.3 368z" /></svg>
                    <div style="opacity: 0.4; font-size: 15px;">@Herramientas.Idiomas.BuscarTexto(idioma, "String1", "Account")</div>
                </div>
            }

            @if (mostrarCorreo == true)
            {
                <Correo idioma="@idioma" dominio="@dominio" />
            }

            @if (mostrarContraseña == true)
            {
                <CambioContrasena idioma="@idioma" />
            }

            @if (mostrarDatosPersonales == true)
            {
                <DatosPersonales idioma="@idioma" />
            }

            @if (mostrarIdioma == true)
            {
                <Idioma idioma="@idioma" usuarioId="@usuarioId" />
            }

            @if (mostrarClaves == true)
            {
                <Claves idioma="@idioma" usuarioId="@usuarioId" />
            }

            @if (mostrarForo == true)
            {
                <Foro idioma="@idioma" />
            }

            @if (mostrarJuegos == true)
            {
                <Juegos idioma="@idioma" usuarioId="@usuarioId" fondoCabecera="background-color: var(--fondoSubsubcabecera);" />
            }

            @if (mostrarPerfil == true)
            {
                <Perfil idioma="@idioma" />
            }

            @if (mostrarNotificacionesCorreo == true)
            {
                <NotificacionesCorreo idioma="@idioma" usuarioId="@usuarioId" />
            }

            @if (mostrarNotificacionesPush == true)
            {
                <NotificacionesPush idioma="@idioma" />
            }

            @if (mostrarCorreoPatreon == true)
            {
                <CorreoPatreon idioma="@idioma" usuarioId="@usuarioId" />
            }

            @if (mostrarJuegosExcluir == true)
            {
                <JuegosExcluir idioma="@idioma" usuarioId="@usuarioId" />
            }

            @if (mostrarDobleAutentificacion == true)
            {
                <DobleAutentificacion idioma="@idioma" />
            }
        </div>

    </div>
</div>

@code {

    #nullable disable

    [PersistentState]
    public string tituloNavegador { get; set; }

    private string idioma = "en";
    private string usuarioId = null;
    private string userAgent = null;
    private string dominio = null;
    private bool usuarioPatreon = false;
    private bool usuarioAdmin = false;

    [Parameter]
    public string seccion { get; set; }

    private Usuario opcionesCuenta = null;

    private string tituloOpcion = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Herramientas.ContextoUsuarioDatos datos = Herramientas.ContextoUsuario.Leer(Contexto);
        idioma = datos.Idioma;
        usuarioId = datos.UsuarioId;
        userAgent = datos.UserAgent;
        dominio = datos.Dominio;

        if (string.IsNullOrEmpty(usuarioId) == false)
        {
            Task<string> tareaIdioma = BaseDatos.Usuarios.Buscar.IdiomaSobreescribir(usuarioId);
            Task<Usuario> tareaUsuario = BaseDatos.Usuarios.Buscar.OpcionesCuenta(usuarioId);
            Task<DateTime?> tareaPatreon = BaseDatos.Usuarios.Buscar.FechaPatreon(usuarioId);
            Task<bool> tareaAdmin = BaseDatos.Usuarios.Buscar.RolDios(usuarioId);

            await Task.WhenAll(tareaIdioma, tareaUsuario, tareaPatreon, tareaAdmin);

            idioma = tareaIdioma.Result;
            opcionesCuenta = tareaUsuario.Result;
            usuarioPatreon = Herramientas.Patreon.VerificarActivo(tareaPatreon.Result);
            usuarioAdmin = tareaAdmin.Result;

            if (string.IsNullOrEmpty(seccion) == false)
            {
                switch (seccion)
                {
                    case "email": MostrarCorreo(); break;
                    case "password": MostrarContraseña(); break;
                    case "data": MostrarDatosPersonales(); break;
                    case "language": MostrarIdioma(); break;
                    case "keys": MostrarClaves(); break;
                    case "forum": MostrarForo(); break;
                    case "games": MostrarJuegos(); break;
                    case "profile": MostrarPerfil(); break;
                    case "notifications-email": MostrarNotificacionesCorreo(); break;
                    case "notifications-push": MostrarNotificacionesPush(); break;
                    case "mail-patreon": MostrarCorreoPatreon(); break;
                    case "excluded-games": MostrarJuegosExcluir(); break;
                    case "authenticator": MostrarDobleAutentificacion(); break;
                }
            }
        }

        tituloNavegador ??= Herramientas.Idiomas.BuscarTexto(idioma, "Title", "Account") + " • pepe's deals";
    }

    private IJSObjectReference moduloJs;

    protected override async Task OnAfterRenderAsync(bool primerRender)
    {
        if (primerRender == true)
        {
            try
            {
                moduloJs = await JavaScript.InvokeAsync<IJSObjectReference>("import", "/componentes/cuenta/cuenta/Indice.razor.js");
            }
            catch {}
        }

        if (moduloJs != null)
        {
            if (string.IsNullOrEmpty(seccion) == true)
            {
                try
                {
                    await moduloJs.InvokeVoidAsync("cambiarEnlace", "/account/");
                }
                catch { }
            }
            else
            {
                try
                {
                    await moduloJs.InvokeVoidAsync("cambiarEnlace", "/account/" + seccion + "/");
                }
                catch { }
            }
        }     
    }

    public async ValueTask DisposeAsync()
    {
        if (moduloJs != null)
        {
            try
            {
                await moduloJs.DisposeAsync();
            }
            catch { }
        }
    }

    private void CerrarPestañas()
    {
        tituloOpcion = string.Empty;

        mostrarCorreo = false;
        mostrarContraseña = false;
        mostrarDatosPersonales = false;
        mostrarIdioma = false;
        mostrarClaves = false;
        mostrarForo = false;
        mostrarJuegos = false;
        mostrarPerfil = false;
        mostrarNotificacionesCorreo = false;
        mostrarNotificacionesPush = false;
        mostrarCorreoPatreon = false;
        mostrarJuegosExcluir = false;
        mostrarDobleAutentificacion = false;
    }

    private async Task CambiarSeccionMovil(ChangeEventArgs e)
    {
        seccion = e.Value?.ToString();
        CerrarPestañas();

        switch (seccion)
        {
            case "email": MostrarCorreo(); break;
            case "password": MostrarContraseña(); break;
            case "data": MostrarDatosPersonales(); break;
            case "language": MostrarIdioma(); break;
            case "keys": MostrarClaves(); break;
            case "forum": MostrarForo(); break;
            case "games": MostrarJuegos(); break;
            case "profile": MostrarPerfil(); break;
            case "notifications-email": MostrarNotificacionesCorreo(); break;
            case "notifications-push": MostrarNotificacionesPush(); break;
            case "mail-patreon": MostrarCorreoPatreon(); break;
