@page "/account/patreon-store/"

@rendermode @(new InteractiveServerRenderMode(prerender: false))

@attribute [Authorize]

@using BaseDatos.Recompensas
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Identity
@using System.Text.Json
@using pepeizqs_deals_web.Data

@inject UserManager<Usuario> UserManager
@inject IConfiguration Configuracion

@{
	string titulo = Herramientas.Idiomas.BuscarTexto(idioma, "Title", "PatreonStore") + " • pepe's deals";
}

<HeadContent>
	<PageTitle>@titulo</PageTitle>
</HeadContent>

@if (usuarioPatreon == false)
{
	<div class="caja-patreontienda" style="background-color: var(--noResultados); justify-content: center; margin: 40px auto; padding: 20px; border-radius: 30px; max-width: 600px; flex-direction: column;">
		<div style="display: flex; align-items: center; gap: 30px;">
			<div style="width: 30px; height: 30px; flex-shrink: 0;">
				<svg class="svg-boton" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
					<path d="M528 320C528 205.1 434.9 112 320 112C205.1 112 112 205.1 112 320C112 434.9 205.1 528 320 528C434.9 528 528 434.9 528 320zM64 320C64 178.6 178.6 64 320 64C461.4 64 576 178.6 576 320C576 461.4 461.4 576 320 576C178.6 576 64 461.4 64 320zM320 240C302.3 240 288 254.3 288 272C288 285.3 277.3 296 264 296C250.7 296 240 285.3 240 272C240 227.8 275.8 192 320 192C364.2 192 400 227.8 400 272C400 319.2 364 339.2 344 346.5L344 350.3C344 363.6 333.3 374.3 320 374.3C306.7 374.3 296 363.6 296 350.3L296 342.2C296 321.7 310.8 307 326.1 302C332.5 299.9 339.3 296.5 344.3 291.7C348.6 287.5 352 281.7 352 272.1C352 254.4 337.7 240.1 320 240.1zM288 432C288 414.3 302.3 400 320 400C337.7 400 352 414.3 352 432C352 449.7 337.7 464 320 464C302.3 464 288 449.7 288 432z" />
				</svg>
			</div>

			<div>
				@Herramientas.Idiomas.BuscarTexto(idioma, "String13", "PatreonStore")
			</div>
		</div>
		
		<a href="@enlacePatreon" target="_blank" class="boton-pequeño" style="width: fit-content; padding: 15px 25px; background: color-mix(in srgb, var(--noResultados) 35%, var(--fondoBotonPequeño));">
			@Herramientas.Idiomas.BuscarTexto(idioma, "String7", "PatreonStore")
		</a>
	</div>
}
else
{
	if (cargando == true)
	{
		<div style="min-height: 200px; display: flex; align-items: center; justify-content: space-around;">
			<div class="cargando" />
		</div>
	}
	else
	{
		<div class="cuerpo-ancho" style="width: 100%; margin: 40px auto;">
			@if (opciones?.PatreonCoins >= 120)
			{
				<div class="caja-patreontienda" style="background-color: var(--noResultados); justify-content: center; gap: 30px; width: 100%; padding: 20px 30px; border-radius: 20px; margin-bottom: 40px;">
					<div style="width: 30px; height: 30px; flex-shrink: 0;">
						<svg class="svg-boton" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
							<path d="M320 64C334.7 64 348.2 72.1 355.2 85L571.2 485C577.9 497.4 577.6 512.4 570.4 524.5C563.2 536.6 550.1 544 536 544L104 544C89.9 544 76.8 536.6 69.6 524.5C62.4 512.4 62.1 497.4 68.8 485L284.8 85C291.8 72.1 305.3 64 320 64zM320 416C302.3 416 288 430.3 288 448C288 465.7 302.3 480 320 480C337.7 480 352 465.7 352 448C352 430.3 337.7 416 320 416zM320 224C301.8 224 287.3 239.5 288.6 257.7L296 361.7C296.9 374.2 307.4 384 319.9 384C332.5 384 342.9 374.3 343.8 361.7L351.2 257.7C352.5 239.5 338.1 224 319.8 224z" />
						</svg>
					</div>

					@Herramientas.Idiomas.BuscarTexto(idioma, "Limit", "PatreonStore")
				</div>
			}
			else
			{
				if (mostrarMensaje == true)
				{
					<button @onclick="OcultarMensaje" class="caja-patreontienda" style="display: flex; align-items: center; gap: 30px; width: 100%; padding: 20px 30px; border-radius: 20px; margin-bottom: 40px;">
						<div style="width: 30px; height: 30px; flex-shrink: 0;">
							<svg class="svg-boton" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
								<path d="M528 320C528 205.1 434.9 112 320 112C205.1 112 112 205.1 112 320C112 434.9 205.1 528 320 528C434.9 528 528 434.9 528 320zM64 320C64 178.6 178.6 64 320 64C461.4 64 576 178.6 576 320C576 461.4 461.4 576 320 576C178.6 576 64 461.4 64 320zM320 240C302.3 240 288 254.3 288 272C288 285.3 277.3 296 264 296C250.7 296 240 285.3 240 272C240 227.8 275.8 192 320 192C364.2 192 400 227.8 400 272C400 319.2 364 339.2 344 346.5L344 350.3C344 363.6 333.3 374.3 320 374.3C306.7 374.3 296 363.6 296 350.3L296 342.2C296 321.7 310.8 307 326.1 302C332.5 299.9 339.3 296.5 344.3 291.7C348.6 287.5 352 281.7 352 272.1C352 254.4 337.7 240.1 320 240.1zM288 432C288 414.3 302.3 400 320 400C337.7 400 352 414.3 352 432C352 449.7 337.7 464 320 464C302.3 464 288 449.7 288 432z" />
							</svg>
						</div>

						<div style="color: var(--colorTexto); text-align: left;">
							@Herramientas.Idiomas.BuscarTexto(idioma, "Problem", "PatreonStore")
						</div>

						<div style="width: 30px; height: 30px; flex-shrink: 0;">
							<svg class="svg-boton" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
								<path d="M183.1 137.4C170.6 124.9 150.3 124.9 137.8 137.4C125.3 149.9 125.3 170.2 137.8 182.7L275.2 320L137.9 457.4C125.4 469.9 125.4 490.2 137.9 502.7C150.4 515.2 170.7 515.2 183.2 502.7L320.5 365.3L457.9 502.6C470.4 515.1 490.7 515.1 503.2 502.6C515.7 490.1 515.7 469.8 503.2 457.3L365.8 320L503.1 182.6C515.6 170.1 515.6 149.8 503.1 137.3C490.6 124.8 470.3 124.8 457.8 137.3L320.5 274.7L183.1 137.4z" />
							</svg>
						</div>
					</button>
				}
			}

			<div style="display: flex; align-items: center; justify-content: center; margin-bottom: 40px; transition: transform 0.3s ease, opacity 0.3s ease; width: fit-content; margin-left: auto; margin-right: auto; flex-wrap: wrap;">
				<div class="caja-patreontienda">
					<button @onclick="MostrarTodosJuegos" class="boton-patreontienda" style="@fondoTodosJuegos border: 0px; height: 50px; padding: 15px 25px; display: flex; align-items: center; color: var(--colorTexto); border-radius: inherit;">
						@Herramientas.Idiomas.BuscarTexto(idioma, "String2", "PatreonStore")
					</button>

					<button @onclick="MostrarJuegosNoTiene" class="boton-patreontienda" style="@fondoJuegosNoTiene border: 0px; height: 50px; padding: 15px 25px; display: flex; align-items: center; color: var(--colorTexto); border-radius: inherit;">
						@Herramientas.Idiomas.BuscarTexto(idioma, "String5", "PatreonStore")
					</button>
				</div>

				@{
					int? monedas = 0;

					if (opciones != null)
					{
						monedas = opciones.PatreonCoins;
					}

					if (monedas == null)
					{
						monedas = 0;
					}

					<label style="font-size: 14px; margin-left: 30px;">
						@string.Format(Herramientas.Idiomas.BuscarTexto(idioma, "String1", "PatreonStore"), monedas.ToString())
					</label>
				}

				@if (entradas?.Count > 0)
				{
					<button class="boton-pequeño" @onclick="EnseñarHistorial" style="width: fit-content; margin-left: 30px; border: 0px; background-color: transparent; box-shadow: none;">
						<div style="width: 26px;">
							<svg class="svg-boton" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
								<path d="M128 128C128 92.7 156.7 64 192 64L341.5 64C358.5 64 374.8 70.7 386.8 82.7L493.3 189.3C505.3 201.3 512 217.6 512 234.6L512 512C512 547.3 483.3 576 448 576L192 576C156.7 576 128 547.3 128 512L128 128zM336 122.5L336 216C336 229.3 346.7 240 360 240L453.5 240L336 122.5zM248 320C234.7 320 224 330.7 224 344C224 357.3 234.7 368 248 368L392 368C405.3 368 416 357.3 416 344C416 330.7 405.3 320 392 320L248 320zM248 416C234.7 416 224 426.7 224 440C224 453.3 234.7 464 248 464L392 464C405.3 464 416 453.3 416 440C416 426.7 405.3 416 392 416L248 416z" />
							</svg>
						</div>
					</button>
				}
			</div>

			<div style="width: 100%; display: flex; flex-direction: column; box-shadow: 0 22px 34px 0 rgba(0, 0, 0, 0.25); border: 2px solid var(--glaseadoBorde); border-radius: 20px; background-color: var(--fondoSubsubcabecera);">
				<div style="padding: 30px; display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 30px; justify-items: center;">
					@if (juegos?.Count > 0)
					{
						foreach (var item in juegosConDatos)
						{
							var recompensaJuego = item.recompensa;
							var juego = item.juego;

							if (juego != null)
							{
								bool usuarioTieneJuego = Herramientas.UsuarioJuegos.ComprobarSiTiene(juegosUsuarioIndex, juego, recompensaJuego.DRM);
								bool usuarioTieneDeseado = false;

								string fondoColor = "background-color: var(--fondoBotonPequeño);";

								if (usuarioTieneJuego == true)
								{
									fondoColor = "background-color: var(--fondoBien);";
								}
								else
								{
									usuarioTieneDeseado = Herramientas.Deseados.ComprobarSiEstaImportado(deseadosImportadosIndex, juego, recompensaJuego.DRM);

									if (usuarioTieneDeseado == true)
									{
										fondoColor = "background-color: var(--fondoAlerta);";
									}
									else
{
										usuarioTieneDeseado = Herramientas.Deseados.ComprobarSiEstaWeb(deseadosWebIndex, juego, recompensaJuego.DRM);
										
										if (usuarioTieneDeseado == true)
										{
											fondoColor = "background-color: var(--fondoAlerta);";
										}
									}
								}

								bool enseñar = ocultarJuegos == false || usuarioTieneJuego == false;

								if (enseñar == true)
								{
									<button @onclick="@(e => MostrarJuego(e, recompensaJuego, juego))" class="recompensa-expandir"
											title="@juego.Nombre" style="text-align: left; border: 0; width: 100%; font-size: 15px; padding: 0px; color: var(--colorTexto); background-color: var(--fondoBotonPequeño); box-shadow: 0px 4px 8px 0px rgba(0, 0, 0, 0.28),0px 0px 2px 0px rgba(0, 0, 0, 0.24);">

										<div style="@fondoColor display: flex; flex-direction: column;">
											<img src="@juego.Imagenes.Library_600x900" style="width: 100%; height: 100%;" />

											<div style="display: flex; align-items: center; padding: 10px;">
												@{
													string imagenDRM = global::Juegos.JuegoDRM2.SacarImagen(recompensaJuego.DRM);
												}

												<img src="@imagenDRM" style="width: 20px; height: 20px;" />
												<div style="width: 100%; text-align: right;">@recompensaJuego.Coins Coins</div>
											</div>
										</div>
									</button>
								}
							}
						}
					}
				</div>
			</div>
		</div>
	}
}

@if (mostrarJuego == true)
{
	<div class="opciones-panel">
		<div style="max-width: 800px; width: 100%; background-color: var(--fondoSubcabecera); border: 2px solid var(--fondoSubcabecera); margin: 20px auto; overflow-y: scroll; scrollbar-color: var(--fondoCodigo) var(--fondoOscuro); border-radius: 20px; box-shadow: 0px 4px 8px 0px rgba(0, 0, 0, 0.28),0px 0px 2px 0px rgba(0, 0, 0, 0.24);">
			<div style="display: flex; align-items: center; gap: 30px; padding: 20px 30px; background: color-mix(in srgb, var(--fondoSubcabecera) 55%, var(--fondoBotonPequeño));">
				<button class="boton-pequeño" @onclick="OcultarJuego" style="width: fit-content; padding: 10px 15px;">
					<div style="max-width: 24px; max-height: 24px;">
						<svg class="svg-icono" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
							<path d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.2 288 416 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-306.7 0L214.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z" />
						</svg>
					</div>
				</button>

				<div style="font-size: 20px;">
					<a href="/game/@juegoMostrar.Id/@Herramientas.EnlaceAdaptador.Nombre(juegoMostrar.Nombre)/" target="_blank" style="text-decoration: none;">
						@juegoMostrar.Nombre
					</a>
				</div>
			</div>

			<div style="display: flex; flex-direction: column; gap: 30px; padding: 30px;">
				<div style="display: flex; align-items: center; gap: 30px;">
					<a href="/game/@juegoMostrar.Id/@Herramientas.EnlaceAdaptador.Nombre(juegoMostrar.Nombre)/" target="_blank">
						<img src="@juegoMostrar.Imagenes.Library_600x900" style="width: 200px;" />
					</a>

					<div>
						@{
							bool puedeComprar = true;

							if (opciones?.PatreonCoins == null)
							{
								puedeComprar = false;
							}
							else
							{
								if (opciones?.PatreonCoins < recompensaMostrar.Coins)
								{
									puedeComprar = false;
								}
							}

							// if (usuarioAdmin == true)
							// {
							// 	puedeComprar = true;
							// }
						}

						@if (puedeComprar == false)
						{
							<div style="background-color: var(--fondoPeligro); padding: 20px; display: flex; align-items: center; gap: 20px; border-radius: 20px; border-radius: 15px; border: 1px solid var(--glaseadoBorde);">
								<div style="max-width: 30px;">
									<svg class="svg-boton" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
										<path d="M256 512A256 256 0 1 0 256 0a256 256 0 1 0 0 512zm0-384c13.3 0 24 10.7 24 24l0 112c0 13.3-10.7 24-24 24s-24-10.7-24-24l0-112c0-13.3 10.7-24 24-24zM224 352a32 32 0 1 1 64 0 32 32 0 1 1 -64 0z" />
									</svg>
								</div>

								<div style="display: flex; flex-direction: column; gap: 20px;">
									@if (usuarioPatreon == false)
									{
										<div>
											@Herramientas.Idiomas.BuscarTexto(idioma, "String6", "PatreonStore")
										</div>

										<a href="@enlacePatreon" target="_blank">
											@Herramientas.Idiomas.BuscarTexto(idioma, "String7", "PatreonStore")
										</a>
									}
									else
									{
										int monedas2 = 0;

										if (opciones?.PatreonCoins != null)
										{
											monedas2 = (int)opciones.PatreonCoins;
										}

										<div>
											@string.Format(Herramientas.Idiomas.BuscarTexto(idioma, "String12", "PatreonStore"), ((recompensaMostrar.Coins - monedas2) / 2).ToString())
										</div>
									}
								</div>
							</div>
						}
						else
						{
							if (string.IsNullOrEmpty(claveJuegoSeleccionado) == true)
							{
								<div style="display: flex; flex-direction: column; gap: 30px;">
									<div style="padding: 0px 20px; display: flex; align-items: center; gap: 20px;">
										<div>
											@string.Format(Herramientas.Idiomas.BuscarTexto(idioma, "String9", "PatreonStore"), recompensaMostrar.Coins.ToString())
										</div>
									</div>

									@if (recompensaMostrar.FechaCaduca != null)
									{
										<div style="background-color: var(--fondoAlerta); padding: 10px 20px; display: flex; align-items: center; gap: 20px;">
											<div>
												@string.Format(Herramientas.Idiomas.BuscarTexto(idioma, "String11", "PatreonStore"), recompensaMostrar.FechaCaduca.Value.Day.ToString() + "/" + recompensaMostrar.FechaCaduca.Value.Month.ToString() + "/" + recompensaMostrar.FechaCaduca.Value.Year.ToString())
											</div>
										</div>
									}

									<button @onclick="@(e => ComprarJuego(e, recompensaMostrar))" class="boton-pequeño" style="text-align: center; border: 0; width: fit-content; padding: 15px 25px; font-size: 18px; margin-left: auto; margin-right: auto;">
										@Herramientas.Idiomas.BuscarTexto(idioma, "String8", "PatreonStore")
									</button>
								</div>
							}
							else
							{
								<div style="display: flex; flex-direction: column; gap: 10px;">
									<div style="min-width: 250px; text-align: center;">
										@claveJuegoSeleccionado
									</div>

									@if (recompensaMostrar.DRM == global::Juegos.JuegoDRM.Steam)
									{
										<div style="margin-left: auto; margin-right: auto;">
											<a href="https://store.steampowered.com/account/registerkey?key=@claveJuegoSeleccionado" target="_blank" style="text-decoration: none;">
												@Herramientas.Idiomas.BuscarTexto(idioma, "Redeem", "PatreonStore")
											</a>
										</div>
									}

									<div style="margin-left: auto; margin-right: auto;">
										<a href="/account/keys/" target="_blank" style="text-decoration: none;">
											@Herramientas.Idiomas.BuscarTexto(idioma, "String10", "PatreonStore")
										</a>
									</div>
								</div>
							}
						}
					</div>
				</div>
			</div>
		</div>
	</div>
}

@if (mostrarHistorial == true)
{
	<div class="opciones-panel">
		<div style="max-width: 800px; width: 100%; background-color: var(--fondoSubcabecera); border: 2px solid var(--fondoSubcabecera); margin: 20px auto; overflow-y: scroll; scrollbar-color: var(--fondoCodigo) var(--fondoOscuro); border-radius: 20px; box-shadow: 0px 4px 8px 0px rgba(0, 0, 0, 0.28),0px 0px 2px 0px rgba(0, 0, 0, 0.24);">
			<div style="display: flex; align-items: center; gap: 30px; padding: 20px 30px; background: color-mix(in srgb, var(--fondoSubcabecera) 55%, var(--fondoBotonPequeño));">
				<button class="boton-pequeño" @onclick="OcultarHistorial" style="width: fit-content; padding: 10px 15px;">
					<div style="max-width: 24px; max-height: 24px;">
						<svg class="svg-icono" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
							<path d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.2 288 416 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-306.7 0L214.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z" />
						</svg>
					</div>
				</button>

				<div style="font-size: 20px;">
					@Herramientas.Idiomas.BuscarTexto(idioma, "String17", "PatreonStore")
				</div>
			</div>

			<div style="padding: 30px;">
				<div style="display: flex; flex-direction: column; gap: 10px;">
					@if (entradas?.Count > 0)
					{
						@foreach (var entrada in entradas)
						{
							<div style="display: flex; align-items: center; gap: 20px; font-size: 14px; padding: 15px 20px; border-bottom: 1px solid var(--glaseadoBorde);">
								<div style="width: 30px; text-align: center;">
									@if (entrada.Coins >= 0)
									{
										<label>+@entrada.Coins</label>
									}
									else
									{
										<label>@entrada.Coins</label>
									}
								</div>

								<div style="flex-grow: 1;">
									@if (string.IsNullOrEmpty(entrada.Razon) == false)
									{
										string cadena = entrada.Razon;
										string juego = string.Empty;

										if (cadena.Contains("Buy") == true)
										{
											juego = cadena.Remove(0, 4);
											cadena = "Buy2";
										}

										<label>@Herramientas.Idiomas.BuscarTexto(idioma, cadena, "PatreonStore") @juego</label>
									}
								</div>

								<div style="text-align: right;">
									@entrada.Fecha.Day/@entrada.Fecha.Month/@entrada.Fecha.Year
								</div>
							</div>
						}
					}
				</div>
			</div>
		</div>
	</div>
}

@code {

	#nullable disable

	[CascadingParameter] private Herramientas.ContextoUsuarioDatos datos { get; set; }

	private string idioma = "en";
	private string usuarioId = null;
	private string userAgent = null;
	private string dominio = null;

	[PersistentState] public Herramientas.UsuarioListadosJuegos juegosUsuario { get; set; }
	[PersistentState] public Herramientas.UsuarioJuegosIndex juegosUsuarioIndex { get; set; }

	[PersistentState] public Usuario deseadosUsuario { get; set; }
	[PersistentState] public Herramientas.UsuarioDeseadosImportadosIndex deseadosImportadosIndex { get; set; }
	[PersistentState] public Herramientas.UsuarioDeseadosWebIndex deseadosWebIndex { get; set; }

	private bool usuarioPatreon = false;
	private bool usuarioAdmin = false;
	[PersistentState] public Usuario opciones { get; set; }

	[PersistentState] public List<RecompensaHistorial> entradas { get; set; }

	private string claveJuegoSeleccionado = null;
	private string enlacePatreon = null;

	protected override async Task OnInitializedAsync()
	{
		enlacePatreon = Configuracion.GetValue<string>("RedesSociales:Patreon");

		idioma = datos.Idioma;
		usuarioId = datos.UsuarioId;
		userAgent = datos.UserAgent;
		dominio = datos.Dominio;

		if (string.IsNullOrEmpty(usuarioId) == false)
		{
			Task<string> tareaIdioma = BaseDatos.Usuarios.Buscar.IdiomaSobreescribir(usuarioId);
			Task<Herramientas.UsuarioListadosJuegos> tareaJuegos = Herramientas.UsuarioJuegos.Cargar(usuarioId);
			Task<Usuario> tareaDeseados = BaseDatos.Usuarios.Buscar.DeseadosTiene(usuarioId);
			Task<DateTime?> tareaPatreon = BaseDatos.Usuarios.Buscar.FechaPatreon(usuarioId);
			Task<bool> tareaAdmin = BaseDatos.Usuarios.Buscar.RolDios(usuarioId);
			Task<Usuario> tareaOpciones = BaseDatos.Usuarios.Buscar.OpcionesPatreon(usuarioId);

			await Task.WhenAll(tareaIdioma, tareaJuegos, tareaDeseados, tareaPatreon, tareaAdmin, tareaOpciones);

			idioma = tareaIdioma.Result;
			juegosUsuario = tareaJuegos.Result;
			deseadosUsuario = tareaDeseados.Result;
			usuarioPatreon = Herramientas.Patreon.VerificarActivo(tareaPatreon.Result);
			usuarioAdmin = tareaAdmin.Result;
			opciones = tareaOpciones.Result;

			if (juegosUsuarioIndex == null)
			{
				juegosUsuarioIndex = Herramientas.UsuarioJuegos.CrearIndex(juegosUsuario);
			}

			if (deseadosImportadosIndex == null)
			{
				deseadosImportadosIndex = Herramientas.Deseados.CrearImportadosIndex(deseadosUsuario);
			}

			if (deseadosWebIndex == null)
			{
				deseadosWebIndex = Herramientas.Deseados.CrearWebIndex(deseadosUsuario);
			}

			if (opciones != null)
			{
				if (entradas == null)
				{
					entradas = await BaseDatos.Recompensas.Historial.Leer(usuarioId);
				}
				
				if (usuarioAdmin == true)
				{
					usuarioPatreon = true;
				}

				if (opciones.PatreonOption2 == true)
				{
					mostrarMensaje = false;
				}

				if (opciones.PatreonOption1.HasValue == true)
				{
					if (opciones.PatreonOption1 == true)
					{
						await MostrarJuegosNoTiene();
					}
					else
					{
						await MostrarTodosJuegos();
					}
				}
			}
		}
	}

	private bool mostrarJuego = false;
	private RecompensaJuego recompensaMostrar = null;
	private global::Juegos.Juego juegoMostrar = null;

	private void MostrarJuego(MouseEventArgs e, RecompensaJuego juego, global::Juegos.Juego juego2)
	{
		claveJuegoSeleccionado = null;

		mostrarJuego = true;
		recompensaMostrar = juego;
		juegoMostrar = juego2;
	}

	private void OcultarJuego()
	{
		mostrarJuego = false;
	}

	private async Task ComprarJuego(MouseEventArgs e, RecompensaJuego juego)
	{
		await BaseDatos.Recompensas.Juegos.Actualizar(recompensaMostrar.Id, usuarioId);
		await BaseDatos.Recompensas.Historial.Insertar(usuarioId, -recompensaMostrar.Coins, "Buy " + recompensaMostrar.JuegoNombre, DateTime.Now);

		opciones.PatreonCoins = opciones.PatreonCoins - recompensaMostrar.Coins;

		List<BaseDatos.Usuarios.Clave> claves = new List<BaseDatos.Usuarios.Clave>();

		if (string.IsNullOrEmpty(opciones.Keys) == false)
		{
			claves = JsonSerializer.Deserialize<List<BaseDatos.Usuarios.Clave>>(opciones.Keys);
		}

		BaseDatos.Usuarios.Clave nuevaClave = new BaseDatos.Usuarios.Clave();
		nuevaClave.Nombre = recompensaMostrar.JuegoNombre;
		nuevaClave.Codigo = recompensaMostrar.Clave;
		nuevaClave.JuegoId = recompensaMostrar.JuegoId.ToString();

		if (claves == null)
		{
			claves = new List<BaseDatos.Usuarios.Clave>();
		}

		claves.Add(nuevaClave);

		claveJuegoSeleccionado = recompensaMostrar.Clave;

		await BaseDatos.Usuarios.Actualizar.Opcion("keys", JsonSerializer.Serialize(claves), usuarioId);

		juegos.Clear();
		juegos = await BaseDatos.Recompensas.Juegos.Disponibles();
	}

