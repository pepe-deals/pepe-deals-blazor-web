	private bool ocultarJuegos = false;
	private string fondoTodosJuegos = "background: transparent;";
	private string fondoJuegosNoTiene = "background: transparent;";

	private async Task MostrarTodosJuegos()
	{
		fondoTodosJuegos = "background: var(--botonSeleccionado);";
		fondoJuegosNoTiene = "background: transparent;";

		await CargarJuegos(false);
	}

	private async Task MostrarJuegosNoTiene()
	{
		fondoTodosJuegos = "background: transparent;";
		fondoJuegosNoTiene = "background: var(--botonSeleccionado);";

		await CargarJuegos(true);
	}

	private bool cargando = false;

	[PersistentState] public List<RecompensaJuego> juegos { get; set; }
	private List<(RecompensaJuego recompensa, global::Juegos.Juego juego)> juegosConDatos;

	private async Task CargarJuegos(bool ocultarJuegos2)
	{
		cargando = true;

		ocultarJuegos = ocultarJuegos2;

		juegos ??= await BaseDatos.Recompensas.Juegos.Disponibles();

		juegosConDatos = new List<(RecompensaJuego, global::Juegos.Juego)>();

		var recompensasSinUsuario = juegos.Where(r => string.IsNullOrEmpty(r.UsuarioId)).ToList();

		List<string> ids = recompensasSinUsuario.Select(r => r.JuegoId.ToString()).Distinct().ToList();
		var juegosBD = await BaseDatos.Juegos.Buscar.MultiplesJuegos(ids);
		var juegosDict = juegosBD.ToDictionary(j => j.Id);

		juegosConDatos = recompensasSinUsuario
			.Where(r => juegosDict.ContainsKey(r.JuegoId))
			.Select(r => (r, juegosDict[r.JuegoId]))
			.ToList();

		if (string.IsNullOrEmpty(usuarioId) == false)
		{
			await BaseDatos.Usuarios.Actualizar.Opcion("PatreonOption1", ocultarJuegos, usuarioId);
		}

		await InvokeAsync(StateHasChanged);

		cargando = false;
	}
