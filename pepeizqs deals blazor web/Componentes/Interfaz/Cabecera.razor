    private bool cargandoBusqueda = false;

    private CancellationTokenSource cts;
    private int busquedaActualId = 0;
    private const int retraso = 150;
    private const int minimosCaracteresBusqueda = 2;
    private const int resultadosMaximos = 30; 

    private string claseBuscador => buscadorActivo || string.IsNullOrEmpty(textoBuscador) == false ? "buscador-activo" : "buscador-inactivo";

    private void ClickBuscador()
    {
        buscadorActivo = true;
    }

    private void PerderBuscador()
    {
        if (string.IsNullOrEmpty(textoBuscador) == true)
        {
            buscadorActivo = false;
        }
    }

    [JSInvokable]
    public async Task EventoTecleoBuscador(string texto)
    {
        if (texto.Length < minimosCaracteresBusqueda)
        {
            await LimpiarResultados();
            return;
        }

        CancelarBusquedaAnterior();

        int busquedaId = ++busquedaActualId;
        CancellationToken token = cts.Token;

        try
        {
            cargandoBusqueda = true;
            await InvokeAsync(StateHasChanged);

            await Task.Delay(retraso, token);

            var resultados = await BaseDatos.Juegos.Buscar.Nombre3(usuarioRegion, texto, resultadosMaximos, 10, 10, excluirJuegosIds);

            if (busquedaId == busquedaActualId && token.IsCancellationRequested == false)
            {
                List<Juego> resultados2 = resultados.juegos;
                cantidadExcluidos = resultados.excluidos;

                List<JuegoMostrar> resultadosMostrar2 = new List<JuegoMostrar>();

                if (resultados2?.Count > 0)
                {
                    foreach (var resultado in resultados2)
                    {
                        JuegoMostrar resultadoMostrar = new JuegoMostrar
                        {
                            Juego = resultado,
                            DeseadoImportado = false,
                            DeseadoWeb = false,
                            Tiene = false,
                            Color = "var(--fondoBotonPequeño)"
                        };

                        if (Herramientas.UsuarioJuegos.ComprobarSiTiene(juegosUsuarioIndex, resultado) == true)
                        {
                            resultadoMostrar.Color = "var(--fondoBien)";
                            resultadoMostrar.Tiene = true;
                        }
                        else
                        {
                            if (Herramientas.Deseados.ComprobarSiEstaImportado(deseadosImportadosIndex, resultado) == true)
                            {
                                resultadoMostrar.Color = "var(--fondoAlerta)";
                                resultadoMostrar.DeseadoImportado = true;
                            }
                            else
                            {
                                if (Herramientas.Deseados.ComprobarSiEstaWeb(deseadosWebIndex, resultado) == true)
                                {
                                    resultadoMostrar.Color = "var(--fondoAlerta)";
                                    resultadoMostrar.DeseadoWeb = true;
                                }
                            }
                        }

                        resultadosMostrar2.Add(resultadoMostrar);
                    }
                }

                ActualizarResultadosPorTipo(resultadosMostrar2);
                ActivarPrimeraPestañaDisponible();

                await ActualizarScrollBody(resultados2.Any());
            }
        }
        catch
        {
            if (busquedaId == busquedaActualId)
            {
                LimpiarTodasLasPestañas();
            }
        }
        finally
        {
            if (busquedaId == busquedaActualId)
            {
                cargandoBusqueda = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void ActualizarResultadosPorTipo(List<JuegoMostrar> resultados)
    {
        foreach (PestañaBuscador pestaña in pestañasBuscador.Values)
        {
            pestaña.resultados.Clear();
            pestaña.visible = false;
        }

        foreach (JuegoMostrar juego in resultados)
        {
            if (pestañasBuscador.TryGetValue(juego.Juego.Tipo, out var pestaña))
            {
                pestaña.resultados.Add(juego);
            }
        }

        foreach (PestañaBuscador pestaña in pestañasBuscador.Values)
        {
            pestaña.visible = pestaña.resultados.Count > 0;
        }
    }

    private void ActivarPrimeraPestañaDisponible()
    {
        foreach (PestañaBuscador pestaña in pestañasBuscador.Values)
        {
            pestaña.activa = false;
        }

        var orden = new[] { JuegoTipo.Game, JuegoTipo.DLC, JuegoTipo.Music, JuegoTipo.Software, JuegoTipo.Curator, JuegoTipo.Bundle };

        foreach (JuegoTipo tipo in orden)
        {
            if (pestañasBuscador[tipo].visible)
            {
                pestañasBuscador[tipo].activa = true;
                break;
            }
        }
    }

    private void CancelarBusquedaAnterior()
    {
        if (cts != null)
        {
            try
            {
                if (cts.IsCancellationRequested == false)
                {
                    cts.Cancel();
                }
            }
            catch (ObjectDisposedException)
            {
            }
            finally
            {
                try
                {
                    cts.Dispose();
                }
                catch (ObjectDisposedException)
                {
                }
            }
        }

        cts = new CancellationTokenSource();
    }

    private async Task LimpiarBusqueda(MouseEventArgs e)
    {
        cts?.Cancel();
        cts?.Dispose();
        busquedaActualId++;

        textoBuscador = string.Empty;
        await LimpiarResultados();
        buscadorActivo = false;
    }

    private async Task LimpiarResultados()
    {
        cargandoBusqueda = false;
        LimpiarTodasLasPestañas();
        await ActualizarScrollBody(false);
        StateHasChanged();
    }

    private void LimpiarTodasLasPestañas()
    {
        foreach (var pestaña in pestañasBuscador.Values)
        {
            pestaña.resultados.Clear();
            pestaña.visible = false;
            pestaña.activa = false;
        }

        pestañasBuscador[JuegoTipo.Game].activa = true;
        pestañasBuscador[JuegoTipo.Game].visible = true;
    }

