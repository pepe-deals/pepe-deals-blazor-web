    protected override async Task OnInitializedAsync()
    {
        Herramientas.ContextoUsuarioDatos datos = Herramientas.ContextoUsuario.Leer(Contexto);
        idioma = datos.Idioma;
        usuarioId = datos.UsuarioId;
        userAgent = datos.UserAgent;
        dominio = datos.Dominio;
        usuarioRegion = datos.Region;

        if (string.IsNullOrEmpty(usuarioId) == false)
        {
            Task<string> tareaIdioma = BaseDatos.Usuarios.Buscar.IdiomaSobreescribir(usuarioId);
            Task<Herramientas.UsuarioListadosJuegos> tareaJuegos = Herramientas.UsuarioJuegos.Cargar(usuarioId);
            Task<Usuario> tareaDeseados = BaseDatos.Usuarios.Buscar.DeseadosTiene(usuarioId);
            Task<DateTime?> tareaPatreon = BaseDatos.Usuarios.Buscar.FechaPatreon(usuarioId);
            Task<bool> tareaAdmin = BaseDatos.Usuarios.Buscar.RolDios(usuarioId);
            Task<Usuario> tareaUsuario = BaseDatos.Usuarios.Buscar.OpcionesCabecera(usuarioId);

            await Task.WhenAll(tareaIdioma, tareaJuegos, tareaDeseados, tareaPatreon, tareaAdmin, tareaUsuario);

            idioma = tareaIdioma.Result;
            juegosUsuario = tareaJuegos.Result;
            deseadosUsuario = tareaDeseados.Result;
            usuarioPatreon = Herramientas.Patreon.VerificarActivo(tareaPatreon.Result);
            usuarioAdmin = tareaAdmin.Result;
            opcionesCabecera = tareaUsuario.Result;

            if (juegosUsuarioIndex == null)
            {
                juegosUsuarioIndex = Herramientas.UsuarioJuegos.CrearIndex(juegosUsuario);
            }

            excluirJuegosIds = juegosUsuarioIndex.Excluidos.ToList();

            if (deseadosImportadosIndex == null)
            {
                deseadosImportadosIndex = Herramientas.Deseados.CrearImportadosIndex(deseadosUsuario);
            }

            if (deseadosWebIndex == null)
            {
                deseadosWebIndex = Herramientas.Deseados.CrearWebIndex(deseadosUsuario);
            }

            if (opcionesCabecera != null)
            {
                usuarioRegion = (TiendaRegion)opcionesCabecera.Currency;
            }
        }

        enlaceChrome = Configuracion.GetValue<string>("Extension:Chrome");
        enlaceFirefox = Configuracion.GetValue<string>("Extension:Firefox");
        enlaceEdge = Configuracion.GetValue<string>("Extension:Edge");
        enlacePatreon = Configuracion.GetValue<string>("RedesSociales:Patreon");

        InicializarPestañasBuscador();
        cts = new CancellationTokenSource();

        await GenerarDeseadosDropdown();

        NavManager.LocationChanged += OnLocationChanged;
    }

    private IJSObjectReference moduloJs;

    protected override async Task OnAfterRenderAsync(bool primerRender)
    {
        if (primerRender == true)
        {
            moduloJs = await JavaScript.InvokeAsync<IJSObjectReference>("import", "/componentes/interfaz/Cabecera.razor.js");

            if (moduloJs != null)
            {
                await moduloJs.InvokeVoidAsync("iniciarScrollCabecera");
            }

            cabeceraReferencia = DotNetObjectReference.Create(this);

            if (moduloJs != null)
            {
                await moduloJs.InvokeVoidAsync("teclearBusqueda", inputBuscador, cabeceraReferencia, 200);
            }

            if (string.IsNullOrEmpty(Search) == false)
            {
                textoBuscador = Search;

                buscadorActivo = true;
                cargandoBusqueda = true;

                try
                {
                    var resultados = await BaseDatos.Juegos.Buscar.Nombre3(usuarioRegion, textoBuscador, resultadosMaximos, 10, 10, excluirJuegosIds);

                    if (resultados.juegos?.Count > 0)
                    {
                        List<Juego> resultados2 = resultados.juegos;
                        cantidadExcluidos = resultados.excluidos;

                        List<JuegoMostrar> resultadosMostrar2 = new List<JuegoMostrar>();

                        if (resultados2?.Count > 0)
                        {
                            foreach (var resultado in resultados2)
                            {
                                JuegoMostrar resultadoMostrar = new JuegoMostrar
                                {
                                    Juego = resultado,
                                    DeseadoImportado = false,
                                    DeseadoWeb = false,
                                    Tiene = false,
                                    Color = "var(--fondoBotonPequeño)"
                                };

                                if (Herramientas.UsuarioJuegos.ComprobarSiTiene(juegosUsuarioIndex, resultado) == true)
                                {
                                    resultadoMostrar.Color = "var(--fondoBien)";
                                    resultadoMostrar.Tiene = true;
                                }
                                else
                                {
                                    if (Herramientas.Deseados.ComprobarSiEstaImportado(deseadosImportadosIndex, resultado) == true)
                                    {
                                        resultadoMostrar.Color = "var(--fondoAlerta)";
                                        resultadoMostrar.DeseadoImportado = true;
                                    }
                                    else
                                    {
                                        if (Herramientas.Deseados.ComprobarSiEstaWeb(deseadosWebIndex, resultado) == true)
                                        {
                                            resultadoMostrar.Color = "var(--fondoAlerta)";
                                            resultadoMostrar.DeseadoWeb = true;
                                        }
                                    }
                                }

                                resultadosMostrar2.Add(resultadoMostrar);
                            }
                        }

                        ActualizarResultadosPorTipo(resultadosMostrar2);
                        ActivarPrimeraPestañaDisponible();

                        await ActualizarScrollBody(resultados2.Any());
                    }
                }
                catch
                {
                    LimpiarTodasLasPestañas();
                }
                finally
                {
                    cargandoBusqueda = false;
                    StateHasChanged();
                }

                if (moduloJs != null)
                {
                    await moduloJs.InvokeVoidAsync("toggleBodyScroll", resultadosMostrar.Any());                    
                }
            }
        }

        await GenerarDeseadosDropdown();
