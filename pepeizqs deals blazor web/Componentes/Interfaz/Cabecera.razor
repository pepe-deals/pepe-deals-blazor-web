@rendermode @(new InteractiveServerRenderMode(prerender: false))

@attribute [StreamRendering(true)]

@implements IAsyncDisposable

@using BaseDatos.Usuarios
@using Juegos
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using System.Text.Json
@using Tiendas2
@using pepeizqs_deals_web.Data
@using static pepeizqs_deals_blazor_web.Componentes.Secciones.Minimos.Minimos

@inject NavigationManager NavManager
@inject IHttpContextAccessor Contexto
@inject IJSRuntime JavaScript
@inject IConfiguration Configuracion
@inject Servicios.Moneda ServiciosMoneda
@inject Servicios.Opciones ServicioOpciones

@if (enseñarAlerta == true)
{
    <div style="width: fit-content; background-color: var(--fondoAlerta); color: var(--colorTexto); padding: 10px 15px; margin: 30px; top: var(--alturaCabecera); left: 0; position: fixed; z-index: 1001; box-shadow: 0px 4px 8px 0px rgba(0, 0, 0, 0.28),0px 0px 2px 0px rgba(0, 0, 0, 0.24);">
        <div style="display: flex; align-items: center; gap: 10px;">
            <div>
                @Herramientas.Idiomas.BuscarTexto(idioma, "String1", "Clipboard")
            </div>

            <button @onclick="CerrarAvisoClipboard" class="boton-pequeño" style="display: flex; padding: 0px; background-color: transparent; width: fit-content; box-shadow: none;">
                <div style="width: 20px; height: 20px;">
                    <svg class="svg-boton" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                        <path d="M183.1 137.4C170.6 124.9 150.3 124.9 137.8 137.4C125.3 149.9 125.3 170.2 137.8 182.7L275.2 320L137.9 457.4C125.4 469.9 125.4 490.2 137.9 502.7C150.4 515.2 170.7 515.2 183.2 502.7L320.5 365.3L457.9 502.6C470.4 515.1 490.7 515.1 503.2 502.6C515.7 490.1 515.7 469.8 503.2 457.3L365.8 320L503.1 182.6C515.6 170.1 515.6 149.8 503.1 137.3C490.6 124.8 470.3 124.8 457.8 137.3L320.5 274.7L183.1 137.4z" />
                    </svg>
                </div>
            </button>
        </div>
    </div>
}

<div class="contenedor-cabeceras">
    <header class="cabecera-superior">

    </header>

    <header class="cabecera2">
        <nav style="padding: 0px; width: 100%;">
            <div class="cabecera-poner">
                <a href="/" id="cabecera" class="texto-logo">
                    pepe's deals
                </a>

                <div style="display: flex; align-items: center; gap: 10px; width: 100%;">
                    <AuthorizeView>
                        <Authorized>
                            @if (string.IsNullOrEmpty(usuarioId) == false)
                            {
                                if (usuarioAdmin == true)
                                {
                                    <a class="boton-superior" href="/admin" style="font-size: 15px;">
                                        <div style="@GenerarEstilo("/admin") display: flex; align-items: center; gap: 15px;">
                                            Admin
                                        </div>
                                    </a>
                                }
                            }
                        </Authorized>
                    </AuthorizeView>

                    @if (Herramientas.Bots.UserAgentEsBot(userAgent) == false)
                    {
                        <div class="@claseBuscador" style="padding: 0px 15px 0px 5px; border-radius: 15px; display: flex; align-items: center; gap: 10px; transition: background-color 0.1s ease, border-color 0.3s ease; box-shadow: 0px 2px 4px 0px rgba(0, 0, 0, 0.28),0px 0px 1px 0px rgba(0, 0, 0, 0.24);">
                            <input @ref="inputBuscador" type="text" @bind-value="@textoBuscador" @onclick="ClickBuscador" @onfocusout="PerderBuscador" class="entrada-texto buscador-placeholder" style="background-color: transparent; min-width: 50%; font-size: 14px; border: 0px;" placeholder="@Herramientas.Idiomas.BuscarTexto(idioma, "SearchPlaceholder", "Header")" autocomplete="off" />

                            <div id="spinner-buscador" style="display: none; width: 24px; height: 24px; align-items: center; justify-content: space-around;">
                                <div class="cargando-busqueda" />
                            </div>

                            <div id="icono-buscador" style="width: 24px; height: 24px;">
                                <svg class="svg-icono" style="fill: var(--colorBuscador)" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                                    <path d="M480 272C480 317.9 465.1 360.3 440 394.7L566.6 521.4C579.1 533.9 579.1 554.2 566.6 566.7C554.1 579.2 533.8 579.2 521.3 566.7L394.7 440C360.3 465.1 317.9 480 272 480C157.1 480 64 386.9 64 272C64 157.1 157.1 64 272 64C386.9 64 480 157.1 480 272zM272 416C351.5 416 416 351.5 416 272C416 192.5 351.5 128 272 128C192.5 128 128 192.5 128 272C128 351.5 192.5 416 272 416z" />
                                </svg>
                            </div>
                        </div>
                    }

                    <div class="botones-escritorio">
                        @if (string.IsNullOrEmpty(usuarioId) == false)
                        {
                            <div class="menu-dropdown2">
                                <a @onclick="AbrirDeseados" href="@enlaceDeseados" class="boton-superior" style="font-size: 15px;">
                                    @if (deseadosCantidad > 0)
                                    {
                                        <div class="boton-cabecera-deseados" style="display: flex; align-items: center; color: var(--colorTexto); background-color: color-mix(in srgb, var(--fondoBotonPequeño) 50%, var(--fondoAlerta)); border-radius: 5px; box-shadow: 0px 2px 4px 0px rgba(0, 0, 0, 0.28),0px 0px 1px 0px rgba(0, 0, 0, 0.24);">
                                            <div style="background-color: var(--fondoAlerta); padding: 5px 15px; font-size: 17px; border-radius: 5px 0px 0px 5px; border: 2px solid var(--fondoAlerta);">
                                                @deseadosCantidad
                                            </div>

                                            <div style="padding: 5px 15px; border: 2px solid var(--fondoAlerta); border-radius: 0px 5px 5px 0px;">
                                                @Herramientas.Idiomas.BuscarTexto(idioma, "Wishlist", "Header")
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div style="@GenerarEstilo("/wishlist")">
                                            @Herramientas.Idiomas.BuscarTexto(idioma, "Wishlist", "Header")
                                        </div>
                                    }
                                </a>

                                @if (mostrarDeseadosDropdown == true && deseadosCantidad > 0)
                                {
                                    <div class="menu-dropdown-contenido-centrado" style="min-width: 400px; background-color: color-mix(in srgb, var(--fondoBotonPequeño) 50%, var(--fondoAlerta)); border-radius: 5px; border: 2px solid var(--fondoAlerta); display: flex; flex-direction: column; gap: 5px;">
                                        @foreach (var juego in datosDeseados.Juegos.OrderByDescending(j => j.Fecha).Take(5))
                                        {
                                            List<Tiendas2.Tienda> tiendas = Tiendas2.TiendasCargar.GenerarListado();
                                            var tienda = tiendas.FirstOrDefault(t => t.Id == juego.Tienda);
                                            string iconoTienda = tienda?.ImagenIcono ?? string.Empty;
                                            string enlaceFinal = Herramientas.EnlaceAcortador.Generar(juego.Enlace, juego.Tienda, usuarioPatreon, false);

                                            <a @key="juego.Enlace" @onclick="(e => AbrirDeseado(e, juego.Enlace))" class="boton-superior" href="@enlaceFinal" target="_blank" style="font-size: 15px; padding: 0px; border-radius: 5px;">
                                                <div style="text-align: center; display: flex; align-items: center; gap: 15px;">
                                                    <img src="@juego.Imagen2" style="width: 173px; height: 65px; display: block;" />

                                                    <div style="width: 100%;">
                                                        <div style="text-align: left; flex-shrink: 0; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                            @juego.Nombre2
                                                        </div>

                                                        <div style="margin-top: 5px; display: flex; align-items: center; gap: 10px;">
                                                            <img src="@JuegoDRM2.SacarImagen(juego.DRM)" style="width: 20px; height: 20px; display: block;" loading="lazy" />
                                                            <img src="@iconoTienda" style="width: 20px; height: 20px; display: block;" loading="lazy" />
                                                        </div>
                                                    </div>

                                                    <div style="text-align: center; display: flex; align-items: center;">
                                                        <div style="background-color: var(--fondoBien); padding: 5px 10px;">
                                                            @juego.Descuento%
                                                        </div>

                                                        <div style="background-color: var(--fondoBotonPequeño); padding: 5px 10px;">
                                                            @juego.Precio
                                                        </div>
                                                    </div>
                                                </div>
                                            </a>
                                        }
                                    </div>
                                }
                            </div>
                        }

                        <div class="menu-dropdown2">
                            <div style="display: flex; align-items: center; font-size: 14px; cursor: pointer; gap: 15px;">
                                <a @onclick="AbrirMinimos" class="boton-superior" style="font-size: 15px;">
                                    <div style="@GenerarEstilo("/historical-lows")">
                                        @Herramientas.Idiomas.BuscarTexto(idioma, "HistoricalLows", "Header")
                                    </div>
                                </a>
                            </div>

                            @if (mostrarMinimosDropdown == true)
                            {
                                <div class="menu-dropdown-contenido-centrado">
                                    <a href="/historical-lows" @onclick='() => mostrarMinimosDropdown = false' style="font-size: 15px;">
                                        <div style="text-align: center;">
                                            @Herramientas.Idiomas.BuscarTexto(idioma, "HistoricalLows", "Header")
                                        </div>
                                    </a>
                                    <hr style="margin: 5px 0px; border-top: var(--glaseadoCabeceraBorde) solid; opacity: 0.6;" />
                                    <a href="/steamdeck" @onclick='() => mostrarMinimosDropdown = false' style="font-size: 15px;">
                                        <div style="text-align: center; display: flex; align-items: center; gap: 15px; justify-content: center;">
                                            @{
                                                string iconoSteamDeck = "/imagenes/otros/steamdeck_cabecera.webp";
                                                string iconoSteamDeck1 = iconoSteamDeck.Replace(".webp", "-sm.webp");
                                                string iconoSteamDeck2 = iconoSteamDeck.Replace(".webp", "-md.webp");
                                            }

                                            <picture>
                                                <source srcset="@iconoSteamDeck1 1x, @iconoSteamDeck2 2x" type="image/webp">
                                                <img src="@iconoSteamDeck" alt="Steam Deck" loading="eager" decoding="async" style="display: block;" width="20" height="20" />
                                            </picture>

                                            <div>
                                                Steam Deck
                                            </div>
                                        </div>
                                    </a>
                                    <a href="/steammachine" @onclick='() => mostrarMinimosDropdown = false' style="font-size: 15px;">
                                        <div style="text-align: center; display: flex; align-items: center; gap: 15px; justify-content: center;">
                                            @{
                                                string iconoSteamMachine = "/imagenes/otros/steammachine_cabecera.webp";
                                                string iconoSteamMachine1 = iconoSteamMachine.Replace(".webp", "-sm.webp");
                                                string iconoSteamMachine2 = iconoSteamMachine.Replace(".webp", "-md.webp");
                                            }

                                            <picture>
                                                <source srcset="@iconoSteamMachine1 1x, @iconoSteamMachine2 2x" type="image/webp">
                                                <img src="@iconoSteamMachine" alt="Steam Machine" loading="eager" decoding="async" style="display: block;" width="20" height="20" />
                                            </picture>

                                            <div>
                                                Steam Machine
                                            </div>
                                        </div>
                                    </a>
                                    <a href="/steamframe" @onclick='() => mostrarMinimosDropdown = false' style="font-size: 15px;">
                                        <div style="text-align: center; display: flex; align-items: center; gap: 15px; justify-content: center;">
                                            @{
                                                string iconoSteamFrame = "/imagenes/otros/steamframe_cabecera.webp";
                                                string iconoSteamFrame1 = iconoSteamFrame.Replace(".webp", "-sm.webp");
                                                string iconoSteamFrame2 = iconoSteamFrame.Replace(".webp", "-md.webp");
                                            }

                                            <picture>
                                                <source srcset="@iconoSteamFrame1 1x, @iconoSteamFrame2 2x" type="image/webp">
                                                <img src="@iconoSteamFrame" alt="Steam Frame" loading="eager" decoding="async" style="display: block;" width="20" height="20" />
                                            </picture>

                                            <div>
                                                Steam Frame
                                            </div>
                                        </div>
                                    </a>
                                    <a href="/steamos" @onclick='() => mostrarMinimosDropdown = false' style="font-size: 15px;">
                                        <div style="text-align: center; display: flex; align-items: center; gap: 15px; justify-content: center;">
                                            @{
                                                string iconoSteamOS = Juegos.JuegoDRM2.SacarImagen(Juegos.JuegoDRM.Steam);
                                                string iconoSteamOS1 = iconoSteamOS.Replace(".webp", "-sm.webp");
                                                string iconoSteamOS2 = iconoSteamOS.Replace(".webp", "-md.webp");
                                            }

                                            <picture>
                                                <source srcset="@iconoSteamOS1 1x, @iconoSteamOS2 2x" type="image/webp">
                                                <img src="@iconoSteamOS" alt="SteamOS" loading="eager" decoding="async" style="display: block;" width="20" height="20" />
                                            </picture>

                                            <div>
                                                SteamOS
                                            </div>
                                        </div>
                                    </a>
                                    <hr style="margin: 5px 0px; border-top: var(--glaseadoCabeceraBorde) solid; opacity: 0.6;" />
                                    <a href="/geforcenow" @onclick='() => mostrarMinimosDropdown = false' style="font-size: 15px;">
                                        <div style="text-align: center; display: flex; align-items: center; gap: 15px; justify-content: center;">
                                            @{
                                                string iconoGeforceNow = "/imagenes/streaming/geforcenow_icono.webp";
                                                string iconoGeforceNow1 = iconoGeforceNow.Replace(".webp", "-sm.webp");
                                                string iconoGeforceNow2 = iconoGeforceNow.Replace(".webp", "-md.webp");
                                            }

                                            <picture>
                                                <source srcset="@iconoGeforceNow1 1x, @iconoGeforceNow2 2x" type="image/webp">
                                                <img src="@iconoGeforceNow" alt="Geforce NOW" loading="eager" decoding="async" style="display: block;" width="20" height="20" />
                                            </picture>

                                            <div>
                                                Geforce NOW
                                            </div>
                                        </div>
                                    </a>
                                    <a href="/boosteroid" @onclick='() => mostrarMinimosDropdown = false' style="font-size: 15px;">
                                        <div style="text-align: center; display: flex; align-items: center; gap: 15px; justify-content: center;">
                                            @{
                                                string iconoBoosteroid = "/imagenes/streaming/boosteroid_icono.webp";
                                                string iconoBoosteroid1 = iconoBoosteroid.Replace(".webp", "-sm.webp");
                                                string iconoBoosteroid2 = iconoBoosteroid.Replace(".webp", "-md.webp");
                                            }

                                            <picture>
                                                <source srcset="@iconoBoosteroid1 1x, @iconoBoosteroid2 2x" type="image/webp">
                                                <img src="@iconoBoosteroid" alt="Boosteroid" loading="eager" decoding="async" style="display: block;" width="20" height="20" />
                                            </picture>

                                            <div>
                                                Boosteroid
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            }
                        </div>

                        <a class="boton-superior" href="/bundles" style="font-size: 15px;">
                            <div style="@GenerarEstilo("/bundles")">
                                @Herramientas.Idiomas.BuscarTexto(idioma, "Bundles", "Header")
                            </div>
                        </a>

                        <a class="boton-superior" href="/free" style="font-size: 15px;">
                            <div style="@GenerarEstilo("/free")">
                                @Herramientas.Idiomas.BuscarTexto(idioma, "Free", "Header")
                            </div>
                        </a>

                        <a class="boton-superior" href="/subscriptions" style="font-size: 15px;">
                            <div style="@GenerarEstilo("/subscriptions")">
                                @Herramientas.Idiomas.BuscarTexto(idioma, "Subscriptions", "Header")
                            </div>
                        </a>

                        <div class="menu-dropdown2">
                            <a @onclick="AbrirExtension" class="boton-superior" title="@Herramientas.Idiomas.BuscarTexto(idioma, "String3", "Header")">
                                <div style="width: 22px; height: 22px;">
                                    <svg class="svg-icono" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                                        <path d="M0 256C0 209.4 12.5 165.6 34.3 127.1L144.1 318.3C166 357.5 207.9 384 256 384C270.3 384 283.1 381.7 296.8 377.4L220.5 509.6C95.9 492.3 0 385.3 0 256zM365.1 321.6C377.4 302.4 384 279.1 384 256C384 217.8 367.2 183.5 340.7 160H493.4C505.4 189.6 512 222.1 512 256C512 397.4 397.4 511.1 256 512L365.1 321.6zM477.8 128H256C193.1 128 142.3 172.1 130.5 230.7L54.2 98.5C101 38.5 174 0 256 0C350.8 0 433.5 51.5 477.8 128V128zM168 256C168 207.4 207.4 168 256 168C304.6 168 344 207.4 344 256C344 304.6 304.6 344 256 344C207.4 344 168 304.6 168 256z" />
                                    </svg>
                                </div>
                            </a>

                            @if (mostrarExtensionDropdown == true)
                            {
                                <div class="menu-dropdown-contenido-centrado">
                                    <a href="https://pepeizqapps.com/extension/pepeizq-deals" target="_blank" @onclick='() => mostrarExtensionDropdown = false' style="font-size: 15px;">
                                        <div style="text-align: center;">
                                            @Herramientas.Idiomas.BuscarTexto(idioma, "String3", "Header")
                                        </div>
                                    </a>
                                    <hr style="margin: 5px 0px; border-top: var(--glaseadoCabeceraBorde) solid; opacity: 0.6;" />
                                    <a href="@enlaceChrome" target="_blank" @onclick='() => mostrarExtensionDropdown = false' style="font-size: 15px;">
                                        <div style="text-align: center; display: flex; align-items: center; gap: 15px; justify-content: center;">
                                            <div style="width: 24px; height: 24px;">
                                                <svg class="svg-icono" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                                                    <path d="M64 320C64 273.4 76.5 229.6 98.3 191.1L208.1 382.3C230 421.5 271.9 448 320 448C334.3 448 347.1 445.7 360.8 441.4L284.5 573.6C159.9 556.3 64 449.3 64 320zM429.1 385.6C441.4 366.4 448 343.1 448 320C448 281.8 431.2 247.5 404.7 224L557.4 224C569.4 253.6 576 286.1 576 320C576 461.4 461.4 575.1 320 576L429.1 385.6zM541.8 192L320 192C257.1 192 206.3 236.1 194.5 294.7L118.2 162.5C165 102.5 238 64 320 64C414.8 64 497.5 115.5 541.8 192zM408 320C408 368.6 368.6 408 320 408C271.4 408 232 368.6 232 320C232 271.4 271.4 232 320 232C368.6 232 408 271.4 408 320z" />
                                                </svg>
                                            </div>

                                            <div>
                                                Chrome
                                            </div>
                                        </div>
                                    </a>
                                    <a href="@enlaceFirefox" target="_blank" @onclick='() => mostrarExtensionDropdown = false' style="font-size: 15px;">
                                        <div style="text-align: center; display: flex; align-items: center; gap: 15px; justify-content: center;">
                                            <div style="width: 24px; height: 24px;">
                                                <svg class="svg-icono" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                                                    <path d="M194.2 191.5L194.2 191.5zM545.6 236.9C535 211.4 513.5 183.9 496.7 175.2C510.4 202.1 518.4 229.1 521.4 249.2C521.4 249.3 521.4 249.5 521.5 249.6C493.9 180.8 447.1 153.1 408.9 92.8C393.9 69.1 398 67.6 395.8 68.1L395.7 68.2C349 94.2 320.4 146.6 313.1 190.9C296.5 191.8 280.2 195.9 265.2 203C263.8 203.6 262.7 204.7 262.1 206C261.5 207.3 261.2 208.8 261.5 210.3C261.7 211.1 262.1 211.9 262.6 212.6C263.1 213.3 263.8 213.9 264.5 214.3C265.2 214.7 266.1 215 266.9 215.1C267.7 215.2 268.6 215.1 269.4 214.8L269.9 214.6C285.4 207.3 302.3 203.4 319.4 203.3C382.2 202.7 416.6 247.3 427 265.6C414 256.4 390.6 247.4 368.2 251.3C455.9 295.2 432.4 445.8 310.8 440.5C251.3 437.9 213.7 389.5 210.3 349.7C210.3 349.7 221.5 307.8 290.9 307.8C298.4 307.8 319.8 286.9 320.2 280.8C320.1 278.8 277.7 261.9 261.1 245.6C252.3 236.9 248 232.7 244.3 229.5C242.3 227.8 240.2 226.2 238 224.7C232.4 205.2 232.2 184.7 237.3 165.1C212.2 176.5 192.7 194.5 178.6 210.5L178.5 210.5C168.8 198.3 169.5 157.9 170.1 149.4C170 148.9 162.9 153.1 161.9 153.7C153.3 159.8 145.4 166.6 138.1 174.1C121.8 190.7 94 224.3 82.6 275.3C78.1 295.7 75.8 319.7 75.8 327.6C75.8 462.3 185 571.5 319.7 571.5C440.3 571.5 542.7 484.3 560.1 368.9C571.7 292.2 545.4 237.8 545.4 236.9z" />
                                                </svg>
                                            </div>

                                            <div>
                                                Firefox
                                            </div>
                                        </div>
                                    </a>
                                    <a href="@enlaceEdge" target="_blank" @onclick='() => mostrarExtensionDropdown = false' style="font-size: 15px;">
                                        <div style="text-align: center; display: flex; align-items: center; gap: 15px; justify-content: center;">
                                            <div style="width: 24px; height: 24px;">
                                                <svg class="svg-icono" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                                                    <path d="M184.1 101.4C225.1 76.2 271.7 63.2 319 64C487 64 576 187.8 576 283.5C575.9 316.2 563 347.4 540.1 370.7C517.2 393.9 486.1 407.2 453.4 407.7C378.2 407.7 361.9 384.6 361.9 375.7C361.9 371.9 363.1 369.5 366.7 366.3L367.7 365.1L368.1 363.5C378.6 352 384 337.3 384 321.9C384 243.2 301.8 179.2 200 179.2C162.5 178.9 125.5 188.1 92.5 206.1C119.5 148.6 175.2 108.5 183.8 102.3C184.6 101.7 184.1 101.5 184.1 101.5zM199.7 419.5C198.3 449.5 204.3 479.5 216.1 506.7C229.7 533.1 248.8 557.7 272.6 576C213.1 564.5 161.1 532.1 123.2 486.7C85.1 440.3 64 382.4 64 321.9C64 270.7 126.4 227.5 200 227.5C236.6 226.9 272.4 238.4 301.8 260.2L298.2 261.4C246.7 279 199.7 352.1 199.7 419.5zM533.8 464L533.1 464.1C521.3 482.9 507.2 499.2 490.9 513.6C460.1 541.6 422.8 559.1 382.1 563.5C363.5 563.8 345.3 560.3 328.3 552.1C302.7 541.8 281.2 522.1 266.7 499.1C252.3 475.2 245.6 447.4 247.7 419.5C247.1 399.4 253.1 379.2 262.7 361.3C276.6 394.4 300.2 422.6 330.3 442.1C360.4 461.6 395.8 471.6 431.7 470.7C462.7 471 493.8 464 521.9 450.2L523.8 449.3C527.7 447 531.5 445.4 535.4 449.3C539.9 454.2 537.2 458.5 534.2 463.3C534 463.5 533.9 463.8 533.8 464z" />
                                                </svg>
                                            </div>

                                            <div>
                                                Edge
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            }
                        </div>

                        @if (usuarioPatreon == false)
