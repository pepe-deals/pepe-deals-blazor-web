    private async Task GenerarDeseadosDropdown()
    {
        if (string.IsNullOrEmpty(usuarioId) == false)
        {
            Usuario deseadosCabecera = await BaseDatos.Usuarios.Buscar.OpcionesCabeceraDeseados(usuarioId);

            if (string.IsNullOrEmpty(deseadosCabecera?.WishlistData) == false)
            {
                datosDeseados = JsonSerializer.Deserialize<DeseadosDatos>(deseadosCabecera?.WishlistData);

                if (datosDeseados != null)
                {
                    deseadosCantidad = datosDeseados.Cantidad;

                    if (datosDeseados.UltimaVisita != null && datosDeseados.UltimoJuego != null)
                    {
                        if (datosDeseados.UltimaVisita?.Subtract((DateTime)datosDeseados.UltimoJuego).TotalDays > 7)
                        {
                            deseadosCantidad = 0;
                            datosDeseados.Juegos = null;
                        }
                    }
                    else if (datosDeseados.UltimaVisita == null && datosDeseados.UltimoJuego != null)
                    {
                        if (DateTime.Now.Subtract((DateTime)datosDeseados.UltimoJuego).TotalDays > 7)
                        {
                            deseadosCantidad = 0;
                            datosDeseados.Juegos = null;
                        }
                    }

                    if (deseadosCantidad > 0 && datosDeseados.Juegos?.Count > 0)
                    {
                        enlaceDeseados = null;

                        List<string> juegosBuscar = datosDeseados.Juegos.Select(j => j.Id.ToString()).ToList();

                        if (juegosBuscar?.Count > 0)
                        {
                            var juegosBuscados = await BaseDatos.Juegos.Buscar.MultiplesJuegosReducido(juegosBuscar);

                            if (juegosBuscados?.Count > 0)
                            {
                                foreach (var juego in juegosBuscados)
