	}

	#region Abrir Enlace

	private async void AbrirEnlace(MouseEventArgs e, string enlace, bool nuevaVentana = true)
	{
		if (nuevaVentana == false)
		{
			await JavaScript.InvokeVoidAsync("open", enlace, "_self");
		}
		else
		{
			await JavaScript.InvokeVoidAsync("open", enlace, "_blank");
		}
	}

	#endregion

	#region Portapapeles

	private bool enseñarAlerta = false;
	private PeriodicTimer cronometro = null;
	private int cronometroContador = 0;
	private int cronometroLimite = 10;

	private async void CopiarAlClipboard(MouseEventArgs e, string textoEnlace)
	{
		enseñarAlerta = true;

		if (moduloJs != null)
		{
			await moduloJs.InvokeVoidAsync("copiarTexto", textoEnlace);
		}

		cronometroContador = 0;
		cronometro = new PeriodicTimer(TimeSpan.FromSeconds(1));

		while (await cronometro.WaitForNextTickAsync())
		{
			cronometroContador += 1;

			if (cronometroContador > cronometroLimite)
			{
				enseñarAlerta = false;
				cronometro.Dispose();
				await InvokeAsync(StateHasChanged);
			}
		}
	}

	private void CerrarAvisoClipboard()
	{
		enseñarAlerta = false;
		cronometroContador = 0;

		if (cronometro != null)
		{
			cronometro.Dispose();
		}
	}

	#endregion

	#region Enseñar Tooltip Juego

	bool enseñarTooltip = false;

	private async Task ActivarTooltip(string triggerId, string tooltipId)
	{
		if (Herramientas.Bots.UserAgentEsBot(userAgent) == false)
		{
			enseñarTooltip = true;
		}

		if (moduloJs != null)
		{
			await moduloJs.InvokeVoidAsync("activarTooltip", triggerId, tooltipId);
		}
	}

	private async Task DesactivarTooltip(string triggerId)
	{
		if (moduloJs != null)
		{
			await moduloJs.InvokeVoidAsync("desactivarTooltip", triggerId);
		}
	}

	#endregion
