@code {

	#nullable disable

	private string idTooltip = string.Empty;

	[Parameter]
	public TiendaRegion region { get; set; } = TiendaRegion.Europa;

	[Parameter]
	public string idioma { get; set; }

	[Parameter]
	public string userAgent { get; set; }

	[Parameter]
	public string color { get; set; }

	[Parameter]
	public Herramientas.UsuarioJuegosIndex juegosUsuarioIndex { get; set; }

	[Parameter]
	public Herramientas.UsuarioDeseadosImportadosIndex usuarioDeseadosImportados { get; set; }

	[Parameter]
	public Herramientas.UsuarioDeseadosWebIndex usuarioDeseadosWeb { get; set; }

