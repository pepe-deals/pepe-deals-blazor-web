@implements IAsyncDisposable

@using Juegos
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Tiendas2

@inject IJSRuntime JavaScript

@if (enseñarAlerta == true)
{
	<div style="width: fit-content; background-color: var(--fondoAlerta); color: var(--colorTexto); padding: 10px 15px; margin: 30px; top: var(--alturaCabecera); left: 0; position: fixed; z-index: 1001; box-shadow: 0px 4px 8px 0px rgba(0, 0, 0, 0.28),0px 0px 2px 0px rgba(0, 0, 0, 0.24);">
		<div style="display: flex; align-items: center; gap: 10px;">
			<div>
				@Herramientas.Idiomas.BuscarTexto(idioma, "String2", "Clipboard")
			</div>

			<button @onclick="CerrarAvisoClipboard" class="boton-pequeño" style="display: flex; padding: 0px; background-color: transparent; width: fit-content; box-shadow: none;">
				<div style="width: 20px; height: 20px;">
					<svg class="svg-boton" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
						<path d="M183.1 137.4C170.6 124.9 150.3 124.9 137.8 137.4C125.3 149.9 125.3 170.2 137.8 182.7L275.2 320L137.9 457.4C125.4 469.9 125.4 490.2 137.9 502.7C150.4 515.2 170.7 515.2 183.2 502.7L320.5 365.3L457.9 502.6C470.4 515.1 490.7 515.1 503.2 502.6C515.7 490.1 515.7 469.8 503.2 457.3L365.8 320L503.1 182.6C515.6 170.1 515.6 149.8 503.1 137.3C490.6 124.8 470.3 124.8 457.8 137.3L320.5 274.7L183.1 137.4z" />
					</svg>
				</div>
			</button>
		</div>
	</div>
}

@if (juego != null)
{
	#nullable disable

	int idMaestra = juego.IdMaestra;

	if (tipo == Tipo.Bundle || tipo == Tipo.Noticia || tipo == Tipo.Filtro || tipo == Tipo.CuratorDestacado || tipo == Tipo.CuratorLista || tipo == Tipo.CuratorJuego || tipo == Tipo.Gratis || tipo == Tipo.Suscripciones || tipo == Tipo.PortadaProximamente || tipo == Tipo.JuegoDLC || tipo == Tipo.JuegoBandaSonora || tipo == Tipo.NuevosAñadidos)
	{
		idMaestra = juego.Id;
	}

	string descuento = string.Empty;
	string precio = string.Empty;
	string enlace = "/game/" + idMaestra + "/" + Herramientas.EnlaceAdaptador.Nombre(juego.Nombre) + "/";
	string enlaceNuevaPestaña = "_self";
	string iconoTienda = string.Empty;
	string codigoTexto = string.Empty;
	DateTime fechaDetectado = DateTime.Now;

	if (tipo == Tipo.PortadaNuevos || tipo == Tipo.PortadaPopulares || tipo == Tipo.PortadaLanzamientos || tipo == Tipo.PortadaProximamente || tipo == Tipo.MinimosHistoricos || tipo == Tipo.SteamDeck || tipo == Tipo.SteamMachine || tipo == Tipo.SteamFrame || tipo == Tipo.SteamOS || tipo == Tipo.GeforceNOW || tipo == Tipo.Boosteroid || tipo == Tipo.AmazonLuna)
	{
		JuegoPrecio oferta = null;

		if (juego.PrecioMinimosHistoricos?.Count > 0)
		{
			oferta = juego.PrecioMinimosHistoricos[0];

			if (tipo == Tipo.PortadaProximamente)
			{
				if (juego.PrecioMinimosHistoricos.Count > 1)
				{
					foreach (var historico in juego.PrecioMinimosHistoricos)
					{
						if (historico.DRM == JuegoDRM.Steam)
						{
							oferta = historico;
							break;
						}
					}
				}
			}
		}
		else if (juego.PrecioMinimosHistoricosUS?.Count > 0)
		{
			oferta = juego.PrecioMinimosHistoricosUS[0];

			if (tipo == Tipo.PortadaProximamente)
			{
				if (juego.PrecioMinimosHistoricosUS.Count > 1)
				{
					foreach (var historico in juego.PrecioMinimosHistoricosUS)
					{
						if (historico.DRM == JuegoDRM.Steam)
						{
							oferta = historico;
							break;
						}
					}
				}
			}
		}
		else if (juego.PreciosHistoricosNoOficialesEU?.Count > 0)
		{
			oferta = juego.PreciosHistoricosNoOficialesEU[0];
		}
		else if (juego.PreciosHistoricosNoOficialesUS?.Count > 0)
		{
			oferta = juego.PreciosHistoricosNoOficialesUS[0];
		}

		if (oferta != null)
		{
			descuento = oferta.Descuento.ToString() + "%";

			if (region == TiendaRegion.Europa)
			{
				if (oferta.PrecioCambiado > 0)
				{
					precio = Herramientas.Precios.Euro(oferta.PrecioCambiado);
				}
				else
				{
					precio = Herramientas.Precios.Euro(oferta.Precio);
				}
			}
			else if (region == TiendaRegion.EstadosUnidos)
			{
				if (oferta.PrecioCambiado > 0)
				{
					precio = Herramientas.Precios.Dolar(oferta.PrecioCambiado);
				}
				else
				{
					precio = Herramientas.Precios.Dolar(oferta.Precio);
				}
			}
			
			codigoTexto = oferta.CodigoTexto;
			fechaDetectado = oferta.FechaDetectado;

			//--------------------------------------------------------

			if (tipo == Tipo.MinimosHistoricos || tipo == Tipo.SteamDeck || tipo == Tipo.SteamMachine || tipo == Tipo.SteamFrame || tipo == Tipo.SteamOS || tipo == Tipo.GeforceNOW || tipo == Tipo.Boosteroid || tipo == Tipo.AmazonLuna)
			{
				if (Herramientas.Bots.UserAgentEsBot(userAgent) == false)
				{
					enlace = Herramientas.EnlaceAcortador.Generar(region, oferta.Enlace, oferta.Tienda, usuarioPatreon, false);
				}
				else
				{
					enlace = oferta.Enlace;
				}
			}

			//--------------------------------------------------------

			List<Tiendas2.Tienda> tiendas = Tiendas2.TiendasCargar.GenerarListado();
			var tienda = tiendas.FirstOrDefault(t => t.Id == oferta.Tienda);
			iconoTienda = tienda?.ImagenIcono ?? string.Empty;
		}
	}

	if (tipo == Tipo.MinimosHistoricos || tipo == Tipo.Noticia || tipo == Tipo.Gratis || tipo == Tipo.Suscripciones)
	{
		enlaceNuevaPestaña = "_blank";
	}

	bool usuarioConectado = false;

	if (juegosUsuarioIndex?.Steam?.Count > 0 || juegosUsuarioIndex?.Gog?.Count > 0)
	{
		usuarioConectado = true;
	}

	int numeroTipo = (int)tipo;
	idTooltip = numeroTipo.ToString() + "-" + idMaestra.ToString() + "-" + drmUsar.ToString() + "-" + tiendaUsar;

	if (idCurator > 0)
	{
		idTooltip = idTooltip + "-" + idCurator.ToString();
	}

	Herramientas.ToolTipDatos tooltip = Herramientas.Tooltip.Generar(idioma, tipo, juego, drmUsar, usuarioConectado, idBundle, tipoGratis, tipoSuscripcion);

	<div class="tooltip-juego" id="trigger-@idTooltip" style="width: auto;"
		 @onmouseenter="@(() => ActivarTooltip($"trigger-{idTooltip}", $"tooltip-{idTooltip}"))"
		 @onmouseleave="@(() => DesactivarTooltip($"trigger-{idTooltip}"))">
		<div id="tooltip-@idTooltip" class="tooltip-relleno">
			@if (enseñarTooltip == true)
			{
				if (string.IsNullOrEmpty(tooltip.Video) == false)
				{
					string videoMostrarMp4 = tooltip.Video;
					string videoMostrarWebm = tooltip.Video.Replace(".mp4", ".webm");

					<video @key="idTooltip" onloadedmetadata="this.muted=true" playsinline autoplay loop muted style="width: 460px; height: 215px; object-fit: cover;" preload="metadata">
						<source src="@videoMostrarWebm" type="video/webm" />
					</video>
				}

				<div style="padding: 15px; text-align: left; max-width: 460px; display: flex; flex-direction: column; gap: 5px;">
					<div>
						@tooltip.Nombre
					</div>

					@if (tooltip.Etiquetas?.Count > 0)
					{
						<div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 5px 0px;">
							@foreach (var etiqueta in tooltip.Etiquetas)
							{
								<div style="background-color: var(--fondoCuerpo); padding: 3px 8px; font-size: 14px; border-radius: 5px;">
									@Herramientas.Idiomas.BuscarTexto(idioma, etiqueta, "Tags")
								</div>
							}
						</div>
					}

					@if (tipo == Tipo.PortadaNuevos || tipo == Tipo.PortadaPopulares || tipo == Tipo.PortadaLanzamientos || tipo == Tipo.PortadaProximamente || tipo == Tipo.MinimosHistoricos || tipo == Tipo.SteamDeck || tipo == Tipo.SteamMachine || tipo == Tipo.SteamFrame || tipo == Tipo.SteamOS || tipo == Tipo.GeforceNOW || tipo == Tipo.Boosteroid || tipo == Tipo.AmazonLuna)
					{
						<div style="display: flex; align-items: center; padding: 5px; text-align: left; justify-content: left;">
							@if (drmUsar != JuegoDRM.NoEspecificado)
							{
								<div style="display: flex; margin-right: 20px;">
									<img src="@JuegoDRM2.SacarImagen(drmUsar)" style="max-width: 20px; max-height: 20px; display: block;" alt="@JuegoDRM2.DevolverDRM(drmUsar)" loading="lazy" />
								</div>
							}

							@if (string.IsNullOrEmpty(iconoTienda) == false)
							{
								<div style="display: flex; margin-right: 20px;">
									<img src="@iconoTienda" style="width: 20px; height: 20px; display: block;" alt="Store" loading="lazy" />
								</div>
							}

							@if (string.IsNullOrEmpty(tooltip.ReviewsIcono) == false)
							{
								<div style="display: flex; margin-right: 20px;">
									<img src="@tooltip.ReviewsIcono" style="width: 20px; height: 20px; display: block;" alt="Reviews" loading="lazy" />
								</div>
							}

							@if (string.IsNullOrEmpty(descuento) == false)
							{
								if (descuento != "0%" && descuento != "00%")
								{
									<div style="margin-right: 15px; background-color: darkgreen; padding: 5px 10px;">
										@descuento
									</div>
								}
							}

							@if (string.IsNullOrEmpty(precio) == false)
							{
								<div>
									@precio
								</div>
							}
						</div>
					}
					else if (tipo == Tipo.Bundle || tipo == Tipo.Suscripciones || tipo == Tipo.Noticia)
					{
						<div style="display: flex; align-items: center; padding: 5px; text-align: left; justify-content: left;">
							<div style="display: flex; margin-right: 20px;">
								<img src="@JuegoDRM2.SacarImagen(drmUsar)" style="max-width: 20px; max-height: 20px; display: block;" alt="@JuegoDRM2.DevolverDRM(drmUsar)" loading="lazy" />
							</div>

							@if (string.IsNullOrEmpty(tooltip.ReviewsIcono) == false)
							{
								<div style="display: flex; margin-right: 20px;">
									<img src="@tooltip.ReviewsIcono" style="width: 20px; height: 20px; display: block;" alt="Reviews" loading="lazy" />
								</div>
							}

							@if (region == TiendaRegion.Europa && juego.PrecioMinimosHistoricos?.Count > 0)
							{
								foreach (var historico in juego.PrecioMinimosHistoricos)
								{
									if (historico.DRM == drmUsar)
									{
										decimal precioUsar = historico.Precio;

										if (historico.PrecioCambiado > 0)
										{
											precioUsar = historico.PrecioCambiado;
										}

										<div style="text-align: center; font-size: 14px;">
											@Herramientas.Idiomas.BuscarTexto(idioma, "String25", "Bundle") @Herramientas.Precios.Euro(precioUsar)
										</div>

										break;
									}
								}
							}
							else if (region == TiendaRegion.EstadosUnidos && juego.PrecioMinimosHistoricosUS?.Count > 0)
							{
								foreach (var historico in juego.PrecioMinimosHistoricosUS)
								{
									if (historico.DRM == drmUsar)
									{
										decimal precioUsar = historico.Precio;

										if (historico.PrecioCambiado > 0)
										{
											precioUsar = historico.PrecioCambiado;
										}

										<div style="text-align: center; font-size: 14px;">
											@Herramientas.Idiomas.BuscarTexto(idioma, "String25", "Bundle") @Herramientas.Precios.Dolar(precioUsar)
										</div>

										break;
									}
								}
							}
						</div>
					}
					else if (tipo == Tipo.Gratis)
					{
						<div style="display: flex; align-items: center; padding: 5px; text-align: left; justify-content: left;">
							<div style="margin-right: 20px;">
								<img src="@JuegoDRM2.SacarImagen(drmUsar)" style="max-width: 20px; max-height: 20px; display: block;" alt="@JuegoDRM2.DevolverDRM(drmUsar)" loading="lazy" />
							</div>

							@if (string.IsNullOrEmpty(tooltip.ReviewsIcono) == false)
							{
								<div style="margin-right: 20px;">
									<img src="@tooltip.ReviewsIcono" style="width: 20px; height: 20px; display: block;" alt="Reviews" loading="lazy" />
								</div>
							}
						</div>
					}
					else if (tipo == Tipo.Filtro || tipo == Tipo.CuratorDestacado || tipo == Tipo.CuratorJuego || tipo == Tipo.CuratorLista)
					{
						<div style="display: flex; align-items: center; padding: 5px; text-align: left; justify-content: left;">
							@if (string.IsNullOrEmpty(tooltip.ReviewsIcono) == false)
							{
								<div style="margin-right: 20px;">
									<img src="@tooltip.ReviewsIcono" style="width: 20px; height: 20px; display: block;" alt="Reviews" loading="lazy" />
								</div>
							}
						</div>
					}

					@if (string.IsNullOrEmpty(tooltip.BundlesActuales) == false || string.IsNullOrEmpty(tooltip.GratisActuales) == false || string.IsNullOrEmpty(tooltip.SuscripcionesActuales) == false)
					{
						<div style="font-size: 14px; padding: 5px;">
							<div style="margin-bottom: 5px;">
								@Herramientas.Idiomas.BuscarTexto(idioma, "String11", "Tooltip")
							</div>

							@if (string.IsNullOrEmpty(tooltip.BundlesActuales) == false)
							{
								<div>
									• @tooltip.BundlesActuales
								</div>
							}

							@if (string.IsNullOrEmpty(tooltip.GratisActuales) == false)
							{
								<div>
									• @tooltip.GratisActuales
								</div>
							}

							@if (string.IsNullOrEmpty(tooltip.SuscripcionesActuales) == false)
							{
								<div>
									• @tooltip.SuscripcionesActuales
								</div>
							}
						</div>
					}

					@if (string.IsNullOrEmpty(tooltip.BundlesPasados) == false || string.IsNullOrEmpty(tooltip.GratisPasados) == false || string.IsNullOrEmpty(tooltip.SuscripcionesPasadas) == false)
					{
						<div style="font-size: 14px; padding: 5px;">
							<div style="margin-bottom: 5px;">
								@Herramientas.Idiomas.BuscarTexto(idioma, "String1", "Tooltip")
							</div>

							@if (string.IsNullOrEmpty(tooltip.BundlesPasados) == false)
							{
								<div>
									• @tooltip.BundlesPasados
								</div>
							}

							@if (string.IsNullOrEmpty(tooltip.GratisPasados) == false)
							{
								<div>
									• @tooltip.GratisPasados
								</div>
							}

							@if (string.IsNullOrEmpty(tooltip.SuscripcionesPasadas) == false)
							{
								<div>
									• @tooltip.SuscripcionesPasadas
								</div>
							}
						</div>
					}
				</div>
			}
		</div>

		@if (tipo == Tipo.PortadaNuevos || tipo == Tipo.PortadaPopulares || tipo == Tipo.PortadaLanzamientos || tipo == Tipo.PortadaProximamente)
		{
			<a class="boton-pequeño" style="padding: 0px; @fondoColor" href="@enlace" target="@enlaceNuevaPestaña">
				<div class="perfil-flexible-centrado">
					<div style="max-width: 230px;">
						<img src="@Herramientas.Ficheros.Imagenes.ServidorExterno(juego.Imagenes.Header_460x215)" loading="lazy" decoding="async" style="width: 100%; height: 100%; display: block;" alt="@juego.Nombre" />
					</div>

					<div class="cjuego-titulo" style="width: 100%; display: flex; flex-flow: column wrap; gap: 10px;">
						<div class="minimo-fuente">@juego.Nombre</div>

						<div style="display: flex; align-items: center; gap: 10px;">
							@if (drmUsar != JuegoDRM.NoEspecificado)
							{
								string iconoDRM = JuegoDRM2.SacarImagen(drmUsar);
								string iconoDRM1 = iconoDRM.Replace(".webp", "-sm.webp");
								string iconoDRM2 = iconoDRM.Replace(".webp", "-md.webp");

								<picture style="display: flex;">
									<source srcset="@iconoDRM1 1x, @iconoDRM2 2x" type="image/webp">
									<img src="@iconoDRM" alt="@JuegoDRM2.DevolverDRM(drmUsar)" loading="lazy" decoding="async" style="width: 18px; height: 18px; display: block;" />
								</picture>

								string iconoTienda1 = iconoTienda.Replace(".webp", "-sm.webp");
								string iconoTienda2 = iconoTienda.Replace(".webp", "-md.webp");

								<picture style="display: flex;">
									<source srcset="@iconoTienda1 1x, @iconoTienda2 2x" type="image/webp">
									<img src="@iconoTienda" alt="Store" loading="lazy" decoding="async" style="width: 18px; height: 18px; display: block;" />
								</picture>
							}

							@if (tipo == Tipo.PortadaNuevos)
							{
								<div class="cjuego-fecha">
									@Herramientas.Calculadora.DiferenciaTiempo(fechaDetectado, idioma, 0)
								</div>
							}
							else if (tipo == Tipo.PortadaLanzamientos)
							{
								<div class="cjuego-fecha">
									@Herramientas.Calculadora.DiferenciaTiempo(juego.Caracteristicas.FechaLanzamientoSteam, idioma, 0)
								</div>
							}
						</div>
					</div>

					<div style="display: flex; align-items: center;">
						@if (string.IsNullOrEmpty(descuento) == false)
						{
							if (descuento != "0%")
							{
								<div class="cjuego-descuento" style="text-align: center; margin: 0px; @fondoDescuento">
									@descuento
								</div>
							}
						}

						<div class="cjuego-precio" style="padding: 5px 15px; text-align: center;">
							@precio
						</div>
					</div>
				</div>
			</a>
		}

		@if (tipo == Tipo.MinimosHistoricos || tipo == Tipo.SteamDeck || tipo == Tipo.SteamMachine || tipo == Tipo.SteamFrame || tipo == Tipo.SteamOS || tipo == Tipo.GeforceNOW || tipo == Tipo.Boosteroid || tipo == Tipo.AmazonLuna)
		{
			string claveJuego = juego.Id.ToString() + "-" + drmUsar + "-" + tiendaUsar;

			<a @key="@claveJuego" class="boton-pequeño" style="padding: 0px; @fondoColor" href="@enlace" target="@enlaceNuevaPestaña">
				<div class="perfil-flexible-centrado">
					<div style="max-width: 230px;">
						<img src="@Herramientas.Ficheros.Imagenes.ServidorExterno(juego.Imagenes.Header_460x215)" style="width: 100%; height: 100%; display: block;" loading="lazy" />
					</div>

					<div style="width: 100%; display: flex; flex-flow: column wrap; padding: 10px 20px;">
						<div class="minimo-fuente">@juego.Nombre</div>

						<div class="perfil-flexible-centrado" style="justify-content: left; margin-top: 12px; gap: 12px;">
							@if (tipo == Tipo.MinimosHistoricos)
							{
								<img src="@JuegoDRM2.SacarImagen(drmUsar)" style="width: 20px; height: 20px; display: block;" loading="lazy" />
							}

							<img src="@iconoTienda" style="width: 20px; height: 20px; display: block;" loading="lazy" />

							@if (string.IsNullOrEmpty(juego.Analisis?.Porcentaje) == false)
							{
								if (int.Parse(juego.Analisis.Porcentaje) > 74)
								{
									<img src="/imagenes/analisis/positivo3.svg" style="max-width: 22px; max-height: 22px; display: block;" loading="lazy" alt="Reviews Good" />
								}

								if (int.Parse(juego.Analisis.Porcentaje) > 49 && int.Parse(juego.Analisis.Porcentaje) < 75)
								{
									<img src="/imagenes/analisis/meh3.svg" style="max-width: 22px; max-height: 22px; display: block;" loading="lazy" alt="Reviews Meh" />
								}

								if (int.Parse(juego.Analisis.Porcentaje) < 50)
								{
									<img src="/imagenes/analisis/negativo3.svg" style="max-width: 22px; max-height: 22px; display: block;" loading="lazy" alt="Reviews Bad" />
								}
							}
						</div>
					</div>

					<div style="display: flex; flex-direction: column; gap: 10px; flex-shrink: 0;">
						<div style="display: flex; align-items: center; justify-content: right;">
							<div style="text-align: center; padding: 10px 15px; margin: 0px; min-width: 65px; @fondoDescuento">
								@descuento
							</div>

							<div style="padding: 5px 15px; min-width: 110px; text-align: center; font-size: 18px;">
								@precio
							</div>
						</div>

						@if (string.IsNullOrEmpty(codigoTexto) == false)
						{
							<div style="background-color: transparent; display: flex; align-items: center; gap: 10px; margin-right: 10px;">
								<button @onclick:preventDefault @onclick="(e => CopiarAlClipboard(e, codigoTexto))" @onclick:stopPropagation class="juego-boton-pequeño" style="width: fit-content; padding: 5px 10px; background-color: rgba(255,255,255,0.1);">
									<div style="display: flex; align-items: center; gap: 10px; text-align: center; font-size: 14px;">
										<div style="flex-shrink: 0;">@Herramientas.Idiomas.BuscarTexto(idioma, "String90", "Game")</div>
										<div>@codigoTexto</div>
									</div>
								</button>
							</div>
						}
					</div>
				</div>
			</a>
		}

		@if (tipo == Tipo.Bundle)
		{
			string claveBundle = juego.Id.ToString() + "-" + drmBundle;

			<a @key="@claveBundle" class="boton-pequeño" style="padding: 0px; @fondoColor" href="@enlace" target="@enlaceNuevaPestaña">
				<div style="padding: 0px; position: relative;">
					@{
						int cantidadBundles = (juego.BundlesActuales?.Count ?? 0) + (juego.BundlesPasados?.Count ?? 0);
						bool añadirNuevo = false;

