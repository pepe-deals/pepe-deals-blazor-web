	public int idBundle { get; set; }

	[Parameter]
	public JuegoDRM drmBundle { get; set; }

	[Parameter]
	public List<string> dlcsBundle { get; set; }

	[Parameter]
	public string enlaceNoticia { get; set; }

	[Parameter]
	public JuegoDRM drmNoticia { get; set; }

	[Parameter]
	public int idCurator { get; set; }

	[Parameter]
	public string enlaceGratis { get; set; }

	[Parameter]
	public JuegoDRM drmGratis { get; set; }

	[Parameter]
	public Gratis2.GratisTipo tipoGratis { get; set; } = Gratis2.GratisTipo.Desconocido;

	[Parameter]
	public int idSuscripcion { get; set; }

	[Parameter]
	public string enlaceSuscripcion { get; set; }

	[Parameter]
	public JuegoDRM drmSuscripcion { get; set; }

	[Parameter]
	public Suscripciones2.SuscripcionTipo tipoSuscripcion { get; set; } = Suscripciones2.SuscripcionTipo.Desconocido;

	[Parameter]
	public EventCallback<(bool tieneJuego, bool tieneDeseadoWeb, bool tieneDeseadoImportado)> OnEstadoUsuario { get; set; }

	public JuegoDRM drmUsar = JuegoDRM.NoEspecificado;
    public string tiendaUsar = string.Empty;

	private bool _estadoInicializado = false;

	public bool usuarioTieneJuego = false;
	public bool usuarioTieneDeseadoWeb = false;
	public bool usuarioTieneDeseadoImportado = false;

	public string fondoColor = "background-color: var(--fondoBotonPequeño);";
	public string fondoDescuento = "background-color: darkgreen;";

	protected override async Task OnParametersSetAsync()
	{
		bool tieneJuego = false;
		bool tieneDeseadoWeb = false;
		bool tieneDeseadoImportado = false;

		drmUsar = JuegoDRM.NoEspecificado;

		if (tipo == Tipo.Bundle)
		{
			drmUsar = drmBundle;
		}
		else if (tipo == Tipo.Noticia)
		{
			drmUsar = drmNoticia;
		}
		else if (tipo == Tipo.Gratis)
		{
			drmUsar = drmGratis;
		}
		else if (tipo == Tipo.Suscripciones)
		{
			drmUsar = drmSuscripcion;
		}
		else
		{
			if (juego.PrecioMinimosHistoricos?.Count > 0)
			{
				drmUsar = juego.PrecioMinimosHistoricos[0].DRM;
				tiendaUsar = juego.PrecioMinimosHistoricos[0].Tienda;
			}
			else if (juego.PrecioMinimosHistoricosUS?.Count > 0)
			{
				drmUsar = juego.PrecioMinimosHistoricosUS[0].DRM;
				tiendaUsar = juego.PrecioMinimosHistoricosUS[0].Tienda;
			}
			else if (juego.PreciosHistoricosNoOficialesEU?.Count > 0)
			{
				drmUsar = juego.PreciosHistoricosNoOficialesEU[0].DRM;
				tiendaUsar = juego.PreciosHistoricosNoOficialesEU[0].Tienda;
			}
			else if (juego.PreciosHistoricosNoOficialesUS?.Count > 0)
			{
				drmUsar = juego.PreciosHistoricosNoOficialesUS[0].DRM;
                tiendaUsar = juego.PreciosHistoricosNoOficialesUS[0].Tienda;
			}
		}

		if (tipo != Tipo.PortadaNuevos && tipo != Tipo.PortadaLanzamientos && tipo != Tipo.PortadaPopulares && tipo != Tipo.PortadaProximamente &&
			tipo != Tipo.MinimosHistoricos && tipo != Tipo.SteamDeck && tipo != Tipo.SteamMachine && tipo != Tipo.SteamFrame && tipo != Tipo.SteamOS && tipo != Tipo.GeforceNOW && tipo != Tipo.Boosteroid)
		{
			string nuevoFondoColor = "background-color: var(--fondoBotonPequeño)";
			string nuevoFondoDescuento = string.Empty;

			if (juegosUsuarioIndex?.EstaVacia == false && string.IsNullOrEmpty(color) == true)
			{
				tieneJuego = Herramientas.UsuarioJuegos.ComprobarSiTiene(juegosUsuarioIndex, juego, drmUsar);

				if (string.IsNullOrEmpty(color) == true)
				{
					if (tieneJuego == true)
					{
						nuevoFondoColor = "background: radial-gradient(ellipse at top left, var(--fondoBotonPequeño), var(--fondoBien));";
						nuevoFondoDescuento = "backdrop-filter: brightness(70%);";
					}
					else
					{
						if (tieneDeseadoImportado == false)
						{
							tieneDeseadoImportado = Herramientas.Deseados.ComprobarSiEstaImportado(usuarioDeseadosImportados, juego, drmUsar);
						}

						if (tieneDeseadoImportado == false && tieneDeseadoWeb == false)
						{
							tieneDeseadoWeb = Herramientas.Deseados.ComprobarSiEstaWeb(usuarioDeseadosWeb, juego, drmUsar);
						}

						if (tieneDeseadoImportado == true || tieneDeseadoWeb == true)
						{
							nuevoFondoColor = "background: radial-gradient(ellipse at top left, var(--fondoBotonPequeño), var(--fondoAlerta));";
							nuevoFondoDescuento = "backdrop-filter: brightness(70%);";
						}
						else
						{
							nuevoFondoColor = "background-color: var(--fondoBotonPequeño);";
						}
					}
				}
				else
				{
					if (string.IsNullOrEmpty(color) == false && color != "var(--fondoBotonPequeño)")
					{
						fondoColor = "background: radial-gradient(ellipse at top left, var(--fondoBotonPequeño), " + color + ");";
						fondoDescuento = "backdrop-filter: brightness(70%);";
					}
				}
			}
			else
			{
				if (string.IsNullOrEmpty(color) == false && color != "var(--fondoBotonPequeño)")
				{
					nuevoFondoColor = "background: radial-gradient(ellipse at top left, var(--fondoBotonPequeño), " + color + ");";
					nuevoFondoDescuento = "backdrop-filter: brightness(70%);";
				}
				else
				{
					nuevoFondoColor = "background-color: var(--fondoBotonPequeño)";
				}
			}

			if (fondoColor != nuevoFondoColor || fondoDescuento != nuevoFondoDescuento)
			{
				fondoColor = nuevoFondoColor;
				fondoDescuento = nuevoFondoDescuento;
			}

			if (_estadoInicializado == false || tieneJuego != usuarioTieneJuego || tieneDeseadoWeb != usuarioTieneDeseadoWeb || tieneDeseadoImportado != usuarioTieneDeseadoImportado)
			{
				usuarioTieneJuego = tieneJuego;
				usuarioTieneDeseadoWeb = tieneDeseadoWeb;
				usuarioTieneDeseadoImportado = tieneDeseadoImportado;
				_estadoInicializado = true;

				await OnEstadoUsuario.InvokeAsync((usuarioTieneJuego, usuarioTieneDeseadoWeb, usuarioTieneDeseadoImportado));
			}
		}	
		else
		{
			string nuevoFondoColor = (string.IsNullOrEmpty(color) == false && color != "var(--fondoBotonPequeño)")
				? "background: radial-gradient(ellipse at top left, var(--fondoBotonPequeño), " + color + ");"
				: "background-color: var(--fondoBotonPequeño)";
			string nuevoFondoDescuento = (string.IsNullOrEmpty(color) == false && color != "var(--fondoBotonPequeño)") ? "backdrop-filter: brightness(70%);" : "background-color: darkgreen;";

			if (fondoColor != nuevoFondoColor)
			{
				fondoColor = nuevoFondoColor;
				fondoDescuento = nuevoFondoDescuento;
			}
		}
	}

	private IJSObjectReference moduloJs;

	protected override async Task OnAfterRenderAsync(bool primerRender)
	{
        if (primerRender == true)
        {
			moduloJs = await JavaScript.InvokeAsync<IJSObjectReference>("import", "/componentes/interfaz/CajaJuego.razor.js");
        }
	}

	public async ValueTask DisposeAsync()
	{
		if (moduloJs != null)
		{
			try
			{
				await moduloJs.DisposeAsync();
			}
			catch { }
		}
	}

