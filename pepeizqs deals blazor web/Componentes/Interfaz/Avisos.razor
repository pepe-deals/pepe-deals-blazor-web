@inject Servicios.Avisos ServicioAvisos

@if (ultimoAviso != null)
{
	string enlaceActualizacion = "https://pepeizqapps.com/updates/" + ultimoAviso.Id + "/" + Herramientas.EnlaceAdaptador.Nombre(ultimoAviso.Titulo) + "/";

	<div style="display: flex; align-items: center; gap: 10px; justify-content: center; background-color: rgba(0,0,0,.2);
		width: 100%; padding: 15px 25px; border: 1px solid rgba(0,0,0,.3);">

		<a href="@enlaceActualizacion" target="_blank" style="text-decoration: none; margin-left: auto; margin-right: auto;">
			@titulo
		</a>

		<button @onclick="CambiarFechaAviso" class="boton-cerrar-aviso" style="background-color: transparent; border: 0px;">
			<div style="width: 24px; height: 24px;">
				<svg class="svg-boton" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
					<path d="M183.1 137.4C170.6 124.9 150.3 124.9 137.8 137.4C125.3 149.9 125.3 170.2 137.8 182.7L275.2 320L137.9 457.4C125.4 469.9 125.4 490.2 137.9 502.7C150.4 515.2 170.7 515.2 183.2 502.7L320.5 365.3L457.9 502.6C470.4 515.1 490.7 515.1 503.2 502.6C515.7 490.1 515.7 469.8 503.2 457.3L365.8 320L503.1 182.6C515.6 170.1 515.6 149.8 503.1 137.3C490.6 124.8 470.3 124.8 457.8 137.3L320.5 274.7L183.1 137.4z" />
				</svg>
			</div>
		</button>
	</div>
}

@code {

	#nullable disable

	[Parameter] public DateTime fechaAviso { get; set; } //fecha que pulso el usuario

	[PersistentState] public BaseDatos.Pepeizqapps.Noticia ultimoAviso { get; set; }

	public string titulo = string.Empty;

	protected override async Task OnInitializedAsync()
	{
		ultimoAviso = await BaseDatos.Pepeizqapps.Buscar.UltimoAviso();

		if (ultimoAviso != null)
		{
			titulo = ultimoAviso.Titulo;

			if (fechaAviso.AddDays(2) < ultimoAviso.Fecha)
			{
				titulo = titulo.Replace("en pepe.deals", null);
				titulo = titulo.Trim();
			}
			else
			{
				ultimoAviso = null;
			}
		}
	}

	private async Task CambiarFechaAviso()
	{
		await ServicioAvisos.AsignarFecha(DateTime.Now);

		ultimoAviso = null;
	}
}
